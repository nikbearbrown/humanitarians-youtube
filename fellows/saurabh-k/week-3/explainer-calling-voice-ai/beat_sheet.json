  "beats": [
    {
      "beat_id": "B00",
      "act": "ASK",
      "narration_text": "The voice reading this sentence is not mine. It is a model running on my laptop. Before we go further that is the disclosure, and by the end of this you will know exactly what it took to make it say this.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "type-on",
        "remotion": {
          "pattern": "ClaudeComposerAsk",
          "props": {
            "greeting": "Hello, HAI",
            "topic": "Irreducibly Human",
            "segment": "Calling Voice AI",
            "folderLabel": "@HumanitariansAI",
            "command": "What actually happens when you call a voice model? And what is a voice, once it is a file on your disk?"
          },
          "rendered": {
            "out": "media/B00.mp4",
            "at": "2026-10-26T19:23:30.567524+00:00"
          }
        }
      },
      "estimated_duration_s": 19,
      "actual_duration_s": 10.88,
      "audio_file": "mp3/beat-B00.mp3",
      "render_duration_s": 10.916666666666666,
      "build": {
