    {
      "beat_id": "B07",
      "act": "CAREFUL",
      "narration_text": "Now the part that matters. This model cannot copy a real person. There is no cloning here, and that is a design decision. A preset voice is not a performance. So if you publish with one, say out loud that it is generated.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
