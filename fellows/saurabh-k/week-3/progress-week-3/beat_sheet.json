    {
      "beat_id": "B02",
      "act": "I — The problem",
      "narration_text": "You join a codebase with a hundred thousand lines in it. You have one question. Where does this feature actually live.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "lane": "manim",
        "show": [
          {
            "at": 0.0,
            "event": "a dense grid of small file rectangles fills the frame"
          },
          {
            "at": 0.6,
            "event": "one question mark lands on top, terracotta"
          }
        ]
      },
      "scene_label": "BigRepo",
      "audio_file": "mp3/beat-B02.mp3",
      "actual_duration_s": 6.61,
      "render_duration_s": 6.625,
      "build": {
        "status": "MANIM",
        "src": "manim/B02.mp4",
        "filled_by": "manim",
        "at": "2026-10-26T18:51:41"
      }
    },
    {
      "beat_id": "B03",
      "act": "I — The problem",
      "narration_text": "So you ask an assistant. It gives you a fluent paragraph. It sounds right. And there is nothing underneath it you can open.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "lane": "manim",
        "show": [
          {
            "at": 0.0,
            "event": "an answer card types out"
          },
          {
            "at": 0.55,
            "event": "an arrow points below it to an empty dashed box labelled 'source?'"
          }
        ]
      },
      "scene_label": "ConfidentGuess",
      "audio_file": "mp3/beat-B03.mp3",
      "actual_duration_s": 6.51,
      "render_duration_s": 6.541666666666667,
      "build": {
        "status": "MANIM",
        "src": "manim/B03.mp4",
        "filled_by": "manim",
        "at": "2026-10-26T18:51:41"
      }
    },
    {
      "beat_id": "B04",
      "act": "I — The problem",
      "narration_text": "That is the whole problem. An answer that sounds right and cannot be checked is not an answer. It is a guess wearing a confident voice.",
