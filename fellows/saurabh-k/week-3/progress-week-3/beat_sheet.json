    {
      "beat_id": "B14",
      "act": "III — Nine days in",
      "narration_text": "It is a monorepo. A web app, an A P I, the engine that does the parsing and indexing, and background workers that do the slow jobs.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "lane": "manim",
