    {
      "beat_id": "B05",
      "act": "FINDING",
      "narration_text": "And here is the part I did not expect. The typography gate had never actually run on this machine. It was skipping in silence because a library was missing, and once I installed it, it crashed on an old Python. When it finally ran, it failed eight of my ten vertical beats.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "ClaudeCodeBeat",
          "props": {
            "title": "gate.json",
            "code": "{\n  \"gate\": \"T\",\n  \"before\": \"skipped\",\n  \"cause\": \"no scipy\",\n  \"after\": \"FAIL 8/10\"\n}",
            "sparkLine": "A skipped check is not a pass.",
            "language": "text",
            "brandLabel": "Irreducibly Human",
            "largeText": true
          },
          "rendered": {
            "out": "media/B05.mp4",
            "at": "2026-10-20T21:41:32.003264+00:00"
          }
        }
      },
      "estimated_duration_s": 18,
      "audio_file": "mp3/beat-B05.mp3",
      "actual_duration_s": 14.76,
      "render_duration_s": 14.791666666666666,
      "build": {
        "status": "VIDEO",
        "src": "media/B05.mp4",
        "filled_by": "remotion:ClaudeCodeBeat",
        "at": "2026-10-20T17:52:03"
      }
    },
    {
      "beat_id": "B06",
      "act": "JUDGE",
      "narration_text": "So what do I take from week one. The gate was right and my frames were wrong. A tool that says nothing is not telling you that it passed. Vertical is its own design and not a crop — at phone size my type was half of what it needed to be. And no probe replaces opening the frame and looking.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "ClaudeTldrWhy",
          "props": {
            "eyebrow": "PROGRESS",
            "heading": "The lesson from week one",
            "topic": "Irreducibly Human",
            "lead": "The gate was right and my frames were wrong.",
            "lines": [
              "Silence is not success",
              "Portrait is its own design",
              "Open the frame and look"
            ],
            "folderLabel": "@HumanitariansAI"
          },
          "rendered": {
            "out": "media/B06.mp4",
            "at": "2026-10-20T21:45:11.266878+00:00"
          }
        }
