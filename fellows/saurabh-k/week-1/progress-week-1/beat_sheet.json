      }
    },
    {
      "beat_id": "B02",
      "act": "WHAT",
      "narration_text": "So what is this thing. Brutalist dot art turns a beat sheet into a four K master. You write the beats; it generates the narration locally, renders the visuals, and then refuses to finish the film if it breaks a rule. Every step of that runs for free.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "ClaudeTldrWhat",
          "props": {
            "eyebrow": "PROGRESS",
            "heading": "The toolkit, in one line",
            "greeting": "Hello, HAI",
            "topic": "Irreducibly Human",
            "question": "So what does brutalist.art do?",
            "lines": [
              "Beat sheet goes in",
              "4K master comes out",
              "It refuses bad frames"
            ],
            "folderLabel": "@HumanitariansAI"
          },
          "rendered": {
            "out": "media/B02.mp4",
            "at": "2026-10-20T21:44:19.169844+00:00"
          }
        }
      },
      "estimated_duration_s": 17,
      "audio_file": "mp3/beat-B02.mp3",
      "actual_duration_s": 13.87,
      "render_duration_s": 13.875,
      "build": {
