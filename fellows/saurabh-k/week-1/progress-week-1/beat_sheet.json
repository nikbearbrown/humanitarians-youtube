        "at": "2026-10-20T17:52:03"
      }
    },
    {
      "beat_id": "B03",
      "act": "TERMS",
      "narration_text": "Four words I had to learn properly. A beat sheet is the whole film written down as data. A lane is whoever renders a given beat. A gate is a check that is allowed to refuse. And a master is the clean file at the end, with no markers burned into it.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "ClaudeDefinitions",
          "props": {
            "title": "Four terms",
            "folderLabel": "@HumanitariansAI",
            "terms": [
              {
                "term": "Beat sheet",
                "meaning": "The film, written as data"
              },
              {
                "term": "Lane",
                "meaning": "Who renders a given beat"
              },
              {
                "term": "Gate",
                "meaning": "A check allowed to refuse"
              },
              {
                "term": "Master",
                "meaning": "The clean 4K file"
              }
            ]
          },
          "rendered": {
            "out": "media/B03.mp4",
            "at": "2026-10-20T21:34:49.174470+00:00"
          }
        }
      },
      "estimated_duration_s": 17,
      "audio_file": "mp3/beat-B03.mp3",
      "actual_duration_s": 13.57,
      "render_duration_s": 13.583333333333334,
