    {
      "beat_id": "B01",
      "act": "BACKGROUND",
      "narration_text": "Here's the problem. Digital audio is a long list of numbers, one for every tiny moment. A CD stores forty-four thousand one hundred of them every second, for each ear. A three-minute song is almost sixteen million numbers. That's far too many to predict one by one. So first, the sound has to be squeezed into a much shorter list.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "TokSampleCount916",
          "props": {
            "title": "Audio Is Numbers",
            "sparkLine": "Sixteen million: too much to predict.",
            "eyebrow": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "cues": {
              "problem": 0.0,
              "list": 0.1199,
              "cd": 0.2933,
              "song": 0.5186,
              "many": 0.7033,
              "squeezed": 0.901
            },
            "durationSeconds": 20.57
          }
        }
      },
      "estimated_duration_s": 20,
      "actual_duration_s": 20.57,
      "audio_file": "mp3/beat-B01.mp3",
      "render_duration_s": 20.583333333333332,
      "build": {
        "status": "VIDEO",
        "src": "media\\B01.mp4",
        "filled_by": "media",
        "at": "2026-10-11T00:56:19"
      }
    },
    {
      "beat_id": "B02",
      "act": "MECHANISM",
      "narration_text": "That's the job of a codec. It cuts the sound into short frames, about a hundredth of a second each. It compares each frame with a codebook: a list of one thousand and twenty-four typical sound shapes, learned from music. Then it writes down only the number of the closest one. That number is a token. A whole frame of sound becomes one number between zero and one thousand and twenty-three.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "TokCodebook916",
          "props": {
            "title": "Frame to Token",
            "sparkLine": "Find the closest shape.",
            "eyebrow": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "cues": {
              "codec": 0.0098,
              "frames": 0.1236,
              "codebook": 0.2724,
              "learned": 0.5223,
              "closest": 0.6417,
              "token": 0.7175,
              "range": 0.8846
            },
            "durationSeconds": 23.74
          },
          "rendered": {
            "out": "media/B02.mp4",
            "at": "2026-10-11T04:34:38.329283+00:00"
          }
