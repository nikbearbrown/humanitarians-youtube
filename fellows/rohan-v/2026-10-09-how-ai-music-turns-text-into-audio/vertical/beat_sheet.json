    },
    {
      "beat_id": "B03",
      "act": "MATH",
      "narration_text": "One guess is rough, so a second codebook codes what the first one missed, and a third codes what's still left. Add the pieces together, and you get closer each time. My codec makes about ninety-four frames a second. With four codebooks, that's three hundred and seventy-five tokens a second: nearly four hundred times less data than a CD.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "TokResidual916",
          "props": {
            "title": "Codebooks Stack",
            "sparkLine": "Add the pieces. Get closer.",
            "eyebrow": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "cues": {
              "rough": 0.0,
              "second": 0.0712,
              "third": 0.2088,
              "add": 0.3335,
              "frames": 0.5699,
              "four": 0.6589,
