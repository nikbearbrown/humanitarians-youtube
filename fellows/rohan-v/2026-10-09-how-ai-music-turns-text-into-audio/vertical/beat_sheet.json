    {
      "beat_id": "B00",
      "act": "ASK",
      "narration_text": "Hi, I am Row-Haan and this video is about how AI music generators turn text into audio. You type a few words, and a minute later there's a song. Suno hasn't published how its own model works. But many published music generators share one idea: turn sound into tokens, and predict them one at a time, the way a chatbot writes words.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "ClaudeComposerAsk916",
          "props": {
            "greeting": "Hi, Rohan",
            "topic": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "segment": "How AI Music Generators Turn Text Into Audio",
            "command": "How does an AI music generator turn a text prompt into a song?",
            "runningText": "working it out…",
            "folderLabel": "@HumanitariansAI",
            "modelLabel": "Claude",
            "effortLabel": "Desktop",
            "output": [
              "squeeze the sound into tokens",
              "predict the next token, again and again",
              "let the words tilt each prediction"
            ],
            "disclosure": "Narration: AI voice (Kokoro af_bella), script by Rohan V.",
            "eyebrow": "HUMANITARIANS AI · AUDIO CONCEPTS",
