          },
          {
            "at": "0.78",
            "event": "Readout note resolves"
          }
        ],
        "remotion": {
          "pattern": "MjL4Stylize",
          "props": {
            "kicker": "LYRICAL LITERACY · MIDJOURNEY TUTORIAL PART 4",
            "title": "How much taste it adds",
            "sparkLine": "One hundred is the default.",
            "card": [
              1
            ],
            "rows": [
              0
            ],
            "notes": [
              {
                "tag": "Stylization",
                "body": "Low keeps close to your words. High lets Midjourney make it beautiful in its own way."
              },
              {
                "tag": "The documented steps",
                "body": "Low 50, Med 100, High 250, Very High 750. Med is the default."
              },
