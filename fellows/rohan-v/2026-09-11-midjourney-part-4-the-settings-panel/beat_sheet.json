    {
      "beat_id": "B02",
      "act": "Act 2 — Aspect Ratio",
      "narration_text": "Aspect Ratio is the shape of the frame, and it is the one setting you should decide before you generate rather than after. A preview square shows you what you are choosing. Portrait, Square and Landscape are presets, and the slider underneath moves between them continuously. This is the chip that reads a r three by two on a finished row.",
      "voice": "af_bella",
      "engine": "kokoro",
      "estimated_duration_s": 22,
      "shot": {
        "type": "REMOTION",
        "show": [
          {
            "at": "0.06",
            "event": "Panel lands; Aspect Ratio card holds, others desaturate"
          },
          {
            "at": "0.28",
            "event": "Preview box lights"
          },
          {
            "at": "0.52",
            "event": "Preset row lights"
          },
          {
            "at": "0.76",
            "event": "Slider lights"
          }
        ],
        "remotion": {
          "pattern": "MjL4Aspect",
          "props": {
            "kicker": "LYRICAL LITERACY · MIDJOURNEY TUTORIAL PART 4",
            "title": "The shape of the frame",
            "sparkLine": "Decide it before, not after.",
            "card": [
              0
            ],
            "rows": [
              0,
              1,
              2
            ],
            "notes": [
              {
                "tag": "The preview",
                "body": "It updates as you drag, so you are picking a shape you can see rather than a number."
              },
              {
                "tag": "Presets, then the slider",
                "body": "Three named presets for the common cases; the slider for anything between them."
              },
              {
                "tag": "Why it comes first",
                "body": "Changing the shape changes the composition. Deciding late means generating twice."
              }
            ],
            "cues": {
