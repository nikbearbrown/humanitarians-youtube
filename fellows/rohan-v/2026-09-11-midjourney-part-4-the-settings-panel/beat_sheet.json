    {
      "beat_id": "B03",
      "act": "Act 3 — Stylization",
      "narration_text": "Aesthetics holds three dials and shows no numbers at all. The first is Stylization. It controls how much of its own taste Midjourney adds. The documentation gives four steps: fifty, one hundred, two hundred and fifty, and seven hundred and fifty. One hundred is the default, and that is where the handle sits when you open the panel.",
      "voice": "af_bella",
      "engine": "kokoro",
      "estimated_duration_s": 22,
      "shot": {
        "type": "REMOTION",
        "show": [
          {
            "at": "0.06",
            "event": "Panel lands; Aesthetics card holds"
          },
          {
