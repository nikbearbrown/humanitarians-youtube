  {
   "beat_id": "B04",
   "act": "SHIFTING",
   "narration_text": "To raise a pitch, you could speed the recording up, but it gets shorter. Auto-Tune's patent keeps the length by repeating whole cycles. For a big shift, both move the vowel too: in my test, up by over a quarter, a chipmunk. My version re-spaces single cycles instead, a method called PSOLA. The vowel moved under one percent.",
   "shot": {
    "type": "GRAPHIC",
    "source": "hyperframes",
    "motion": "choreographed",
    "hyperframes": {
     "composition": "shift",
