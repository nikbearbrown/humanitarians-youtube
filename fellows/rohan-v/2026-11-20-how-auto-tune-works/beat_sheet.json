  {
   "beat_id": "B03",
   "act": "SNAP",
   "narration_text": "Auto-Tune moves each moment toward the nearest note in the key you choose. A setting called retune speed decides how fast. At a gentle sixty milliseconds, my singer averaged under seven cents off, and the vibrato survived. At zero, it snaps instantly: the voice sat within five cents of a note ninety-one percent of the time. That's the robotic sound, made famous by Cher's Believe in nineteen ninety-eight.",
   "shot": {
    "type": "GRAPHIC",
    "source": "hyperframes",
