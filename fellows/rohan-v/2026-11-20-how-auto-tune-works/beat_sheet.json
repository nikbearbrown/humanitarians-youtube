  {
   "beat_id": "B01",
   "act": "PITCH",
   "narration_text": "A sung note is a wave that repeats. How often it repeats is its pitch: the A above middle C repeats four hundred and forty times a second. To find it, the software slides a copy of the wave along itself until the two line up. My detector was within five cents, about the smallest change most people can hear, ninety-three percent of the time.",
   "shot": {
    "type": "GRAPHIC",
    "source": "hyperframes",
    "motion": "choreographed",
    "hyperframes": {
     "composition": "pitch",
     "project": "hyperframes"
