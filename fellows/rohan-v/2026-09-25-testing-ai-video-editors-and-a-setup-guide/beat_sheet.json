              {
                "was": "captions read the phonetic “Rohaan”",
                "now": "caption text corrected to the real spelling"
              },
              {
                "was": "~61 GB of render scratch on a full drive",
                "now": "scratch and caches moved to D:"
              },
              {
                "was": "output at 1920 × 1080",
                "now": "still short of our 4K standard"
              }
            ],
            "sparkLine": "Four snags. Three fixed, one still open.",
