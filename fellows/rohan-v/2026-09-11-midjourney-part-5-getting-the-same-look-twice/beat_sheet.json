    {
      "beat_id": "B01",
      "act": "Act 1 — BLUF: four tools",
      "narration_text": "Four tools. Point at one picture and borrow from it. Collect a pile of pictures and name the pile. Rank images until it learns your taste. Or grow a style by choosing, one round at a time. They do different jobs, and picking the wrong one is why things stop matching.",
      "voice": "af_bella",
      "engine": "kokoro",
      "estimated_duration_s": 21,
      "shot": {
        "type": "REMOTION",
        "show": [
          {
            "at": "0.06",
            "event": "Four cards land together"
          },
