    {
      "beat_id": "B03",
      "act": "Act 3 — what a moodboard is",
      "narration_text": "A moodboard is pictures that share a look, kept under a name you choose. Midjourney is blunt about the tradeoff on its own page: focused moodboards give you consistency, diverse ones let you explore. One more thing. Leave a board unnamed and it becomes moodboard two eighty. Name it after the job it is doing.",
      "voice": "af_bella",
      "engine": "kokoro",
      "estimated_duration_s": 22,
      "shot": {
        "type": "REMOTION",
        "show": [
