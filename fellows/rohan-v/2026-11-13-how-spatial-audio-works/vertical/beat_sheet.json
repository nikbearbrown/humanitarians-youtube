            "greeting": "Hi, Rohan",
            "topic": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "segment": "How Spatial Audio Works",
            "command": "How do my headphones make sound come from behind me?",
            "runningText": "working it out…",
            "folderLabel": "@HumanitariansAI",
            "modelLabel": "Claude",
            "effortLabel": "Desktop",
            "output": [
              "time the gap between your ears",
              "shade the far ear",
              "keep the sound still when you turn"
