    {
      "beat_id": "B02",
      "act": "LEVEL",
      "narration_text": "Your head also casts a shadow. High sounds can't bend around it, so the far ear hears them quieter: fourteen decibels quieter in my model. Low sounds bend around, so only two. Timing for low sounds, loudness for high ones. Lord Rayleigh worked that out in nineteen-oh-seven.",
      "shot": {
        "type": "GRAPHIC",
        "source": "hyperframes",
        "motion": "choreographed",
        "hyperframes": {
          "composition": "ild",
          "project": "hyperframes"
        },
        "remotion": {
          "props": {
            "title": "Your Head Casts a Shadow",
            "eyebrow": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "cues": {
