  "beats": [
    {
      "beat_id": "B00",
      "act": "ASK",
      "narration_text": "Hi, I am Row-Haan and this video is about how Shazam finds a song: how an app can hear five seconds of music in a noisy room, and name the exact recording. It doesn't listen the way you do. It doesn't know the melody or the words. It looks for a handful of loud points, and the timing between them.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "ClaudeComposerAsk916",
          "props": {
            "greeting": "Hi, Rohan",
            "topic": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "segment": "How Shazam Finds a Song",
            "command": "How does Shazam name a song from a few seconds of noisy audio?",
            "runningText": "working it out…",
            "folderLabel": "@HumanitariansAI",
            "modelLabel": "Claude",
            "effortLabel": "Desktop",
            "output": [
              "keep only the loudest points of the sound",
              "pair them up into short codes",
              "let the codes vote on the song and the moment"
            ],
            "disclosure": "Narration: AI voice (Kokoro af_bella), script by Rohan V.",
            "eyebrow": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "cues": {
              "listen": 0.5647,
              "points": 0.8342,
              "timing": 0.929
            },
            "durationSeconds": 18.3
          },
          "rendered": {
