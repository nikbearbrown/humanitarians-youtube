        "filled_by": "remotion:ShazamHashPairs916",
        "at": "2026-10-11T00:45:28"
      }
    },
    {
      "beat_id": "B03",
      "act": "MATH",
      "narration_text": "To search, the app makes hashes from your clip and looks each one up. Plenty of songs share a few hashes by chance. The trick is timing. For every match, take the time in the song and subtract the time in your clip. If the clip really comes from that song, the answers agree: they all point to the same moment. A real match is one tall spike. Chance matches are scattered.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "ShazamOffsetVote916",
          "props": {
            "title": "Timing Votes",
            "sparkLine": "Real matches line up.",
            "eyebrow": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "cues": {
              "search": 0.0,
              "chance": 0.2442,
              "timing": 0.2983,
              "subtract": 0.4698,
              "agree": 0.6552,
              "spike": 0.8515,
              "scattered": 0.9334
            },
            "durationSeconds": 21.57
          },
          "rendered": {
            "out": "media/B03.mp4",
            "at": "2026-10-11T04:31:13.122521+00:00"
          }
        }
      },
      "estimated_duration_s": 22,
      "actual_duration_s": 21.57,
      "audio_file": "mp3/beat-B03.mp3",
      "render_duration_s": 21.583333333333332,
      "build": {
