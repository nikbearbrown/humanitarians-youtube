      }
    },
    {
      "beat_id": "B01",
      "act": "BACKGROUND",
      "narration_text": "First, the sound becomes a spectrogram. Time runs left to right, pitch runs bottom to top, and darker means louder. Then almost all of it is thrown away. Only the points that are louder than everything around them are kept: about twelve every second. The 2003 paper that described Shazam's method calls this a constellation map. In my test, with noise as loud as the music, twenty-four of these forty points survived. That's enough to work with.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "ShazamPeaks916",
          "props": {
            "title": "Loudest Points",
            "sparkLine": "Thousands of numbers, a few stars.",
            "eyebrow": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "cues": {
              "spec": 0.0329,
              "time": 0.0975,
              "pitch": 0.1582,
              "darker": 0.2152,
              "thrown": 0.3152,
              "kept": 0.4469,
              "twelve": 0.4811,
              "constellation": 0.6862,
              "noise": 0.7773,
              "survive": 0.8545
            },
            "durationSeconds": 26.33
          },
          "rendered": {
            "out": "media/B01.mp4",
            "at": "2026-10-10T23:59:42.228696+00:00"
          }
        }
      },
      "estimated_duration_s": 24,
      "actual_duration_s": 26.33,
