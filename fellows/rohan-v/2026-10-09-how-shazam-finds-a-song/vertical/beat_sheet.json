      }
    },
    {
      "beat_id": "B04",
      "act": "MEASURED",
      "narration_text": "So I built one. I made six songs from scratch, forty seconds each, and indexed them: about fourteen thousand hashes. Then I took five seconds of Song C, starting at twelve seconds, and buried it in cafe noise as loud as the music, through a phone-quality filter. Song C got thirty-three votes, at exactly twelve seconds. The next best song got two. Listen: the noisy clip, then the original.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "ShazamMatch916",
          "props": {
