        "filled_by": "remotion:ShazamPeaks916",
        "at": "2026-10-11T00:45:28"
      }
    },
    {
      "beat_id": "B02",
      "act": "MECHANISM",
      "narration_text": "One point on its own says very little. So each point becomes an anchor, and is paired with a few points just after it. Each pair gives three numbers: the first frequency, the second frequency, and the time between them. Here: seven hundred and eighty-six hertz, then eleven hundred and seventy-four hertz, five hundredths of a second later. Those three numbers are packed into one code, called a hash. My version makes about fifty-seven of them every second.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "ShazamHashPairs916",
          "props": {
            "title": "Pairs Into Codes",
            "sparkLine": "Two frequencies, one gap: a hash.",
            "eyebrow": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "cues": {
              "one": 0.0,
              "anchor": 0.113,
              "paired": 0.1577,
              "three": 0.2746,
              "here": 0.4822,
              "packed": 0.7923,
              "hash": 0.8448,
              "rate": 0.9407
            },
            "durationSeconds": 25.37
          },
          "rendered": {
            "out": "media/B02.mp4",
            "at": "2026-10-11T04:27:05.782306+00:00"
          }
        }
      },
      "estimated_duration_s": 25,
      "actual_duration_s": 25.37,
      "audio_file": "mp3/beat-B02.mp3",
      "render_duration_s": 25.375,
      "build": {
        "status": "VIDEO",
