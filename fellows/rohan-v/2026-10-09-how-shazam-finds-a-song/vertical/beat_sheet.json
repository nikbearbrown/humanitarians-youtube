    },
    {
      "beat_id": "B06",
      "act": "THE CATCH",
      "narration_text": "Here's what this kind of fingerprint can't do: it matches one exact recording, not the song. I played the same song again, one semitone higher: one vote. Six percent faster: four. The melody alone, hummed: one. To the fingerprint, those are different recordings, because every frequency and every gap has moved. Apps that recognise humming use a different kind of fingerprint, built on the melody.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "ShazamVersions916",
          "props": {
            "title": "Recording, Not Song",
            "sparkLine": "New key or speed, new codes.",
            "eyebrow": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "cues": {
              "cant": 0.0453,
              "exact": 0.1131,
              "semitone": 0.2828,
              "faster": 0.3875,
              "hummed": 0.4823,
              "moved": 0.7425,
              "apps": 0.8203
            },
            "durationSeconds": 23.57
          },
          "rendered": {
            "out": "media/B06.mp4",
            "at": "2026-10-11T02:07:18.216443+00:00"
