    {
      "beat_id": "B05",
      "act": "NOISE",
      "narration_text": "How much noise can it take? I ran thirty random clips at each noise level. With the music ten decibels louder than the noise, all thirty were found. With noise as loud as the music, twenty-nine. With the noise five decibels louder, twenty-two. Ten decibels louder, nine. And when it failed, it said no match. It never named the wrong song.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "ShazamNoiseSweep916",
          "props": {
