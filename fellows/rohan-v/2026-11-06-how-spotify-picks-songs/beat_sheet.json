    },
    {
      "beat_id": "B05",
      "act": "THE CATCH",
      "narration_text": "But look at what it picks. Only six percent of its picks came from the less popular half of the songs, though a quarter of all listening happens there. And a brand-new song, with no plays yet, appeared in nobody's list. That's the cold-start problem.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "RecsPopularity",
