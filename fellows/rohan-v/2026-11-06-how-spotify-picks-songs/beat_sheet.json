    },
    {
      "beat_id": "B03",
      "act": "WHAT IT LEARNED",
      "narration_text": "It was never told a single genre. Still, a song's five closest songs were the same genre eighty-four percent of the time, because the same people play them. Close means the two lists of numbers point the same way. That's cosine similarity.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "RecsNeighbours",
          "props": {
            "title": "It Found the Genres Itself",
            "sparkLine": "Played by the same people, so close together.",
            "eyebrow": "HUMANITARIANS AI · TECH CONCEPTS",
            "cues": {
              "never": 0.013,
              "five": 0.226,
              "eighty": 0.4129,
              "same": 0.5519,
              "point": 0.7844,
              "cosine": 0.9279
            },
            "durationSeconds": 15.34
          },
          "rendered": {
