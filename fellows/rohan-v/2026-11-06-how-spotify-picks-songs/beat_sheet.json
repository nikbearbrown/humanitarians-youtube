    {
      "beat_id": "B01",
      "act": "SIGNALS",
      "narration_text": "Spotify says the most important input is your taste profile: what you search, play, skip and save. There are no star ratings, so it learns from what you do. It also looks at people with similar taste. That idea is called collaborative filtering.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "RecsSignals",
          "props": {
            "title": "It Learns From What You Do",
            "sparkLine": "No ratings. Just plays, skips and saves.",
            "eyebrow": "HUMANITARIANS AI · TECH CONCEPTS",
            "cues": {
              "profile": 0.1558,
              "search": 0.2475,
              "skip": 0.3564,
              "stars": 0.4695,
              "similar": 0.749,
              "cf": 0.9048
            },
            "durationSeconds": 15.62
          },
          "rendered": {
            "out": "media/B01.mp4",
            "at": "2026-11-09T20:19:53.059781+00:00"
          }
        }
      },
      "estimated_duration_s": 17,
      "actual_duration_s": 15.62,
      "audio_file": "mp3/beat-B01.mp3",
      "render_duration_s": 15.625,
