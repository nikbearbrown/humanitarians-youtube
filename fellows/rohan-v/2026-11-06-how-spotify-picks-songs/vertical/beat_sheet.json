      }
    },
    {
      "beat_id": "B04",
      "act": "THE TEST",
      "narration_text": "Then I hid a fifth of each listener's songs and asked for ten picks. Seventy-four percent of listeners got at least one hidden song back. Just recommending the hits did nearly as well, sixty-five percent. Random picks: six.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "RecsAccuracy916",
          "props": {
