    },
    {
      "beat_id": "B02",
      "act": "THE GRID",
      "narration_text": "Picture a giant grid: listeners down the side, songs across the top, and most boxes empty. I made one up: three thousand listeners and sixteen hundred songs. Matrix factorisation fills it in by giving every listener and every song twenty-four hidden taste numbers. A song's score is how well the two lists match.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "RecsGrid916",
          "props": {
            "title": "Mostly Empty",
            "sparkLine": "Taste lists, multiplied.",
            "eyebrow": "HUMANITARIANS AI · TECH CONCEPTS",
            "cues": {
              "grid": 0.0132,
              "empty": 0.2279,
              "made": 0.3204,
