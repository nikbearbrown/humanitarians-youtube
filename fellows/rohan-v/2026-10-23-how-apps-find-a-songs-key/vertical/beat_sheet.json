        "at": "2026-10-23T20:32:45"
      }
    },
    {
      "beat_id": "B03",
      "act": "MATH",
      "narration_text": "Step two: compare it with a template. In 1982, psychologists asked listeners how well each note fits a key, and those ratings give every one of the twenty-four keys a shape. The app slides the song's bars against all twenty-four shapes, and keeps the best match, measured by correlation. C major scores zero point nine eight. The next best, G major, only zero point seven two.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "KeyProfiles916",
          "props": {
            "title": "Match the Shape",
            "sparkLine": "The closest shape wins.",
            "eyebrow": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "cues": {
              "two": 0.0,
              "template": 0.0558,
              "listeners": 0.1835,
              "shape": 0.4095,
              "slides": 0.468,
              "corr": 0.6608,
              "cmaj": 0.7233,
              "rival": 0.8523
            },
            "durationSeconds": 25.07
          },
          "rendered": {
            "out": "media/B03.mp4",
            "at": "2026-10-23T23:37:08.573032+00:00"
          }
        }
      },
      "estimated_duration_s": 26,
      "actual_duration_s": 25.07,
      "audio_file": "mp3/beat-B03.mp3",
      "render_duration_s": 25.083333333333332,
      "build": {
        "status": "VIDEO",
        "src": "media\\B03.mp4",
        "filled_by": "remotion:KeyProfiles916",
        "at": "2026-10-23T20:32:45"
      }
    },
    {
      "beat_id": "B04",
      "act": "MEASURED",
      "narration_text": "I built a detector this way, and tested it on sixty songs I generated: pop, rock, blues, and two kinds of minor ballad, each in all twelve keys. It named the key right on fifty of sixty. Pop, rock and blues: every single one.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "KeyGrid916",
          "props": {
            "title": "Fifty of Sixty Right",
            "sparkLine": "Pop, rock, blues: all right.",
            "eyebrow": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "cues": {
              "built": 0.0,
              "sixty": 0.1691,
              "styles": 0.3056,
              "fifty": 0.7369,
              "every": 0.9146
            },
            "durationSeconds": 15.38
          },
          "rendered": {
