        "at": "2026-10-23T20:32:45"
      }
    },
    {
      "beat_id": "B01",
      "act": "BACKGROUND",
      "narration_text": "A key is a set of seven notes with one of them as home. C major uses the white keys of a piano, and C is home. A minor uses the very same seven notes, but its home is A. Hold on to that, because that's exactly where apps go wrong.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "KeyNotes916",
          "props": {
            "title": "Seven Notes",
            "sparkLine": "Same notes, different home.",
            "eyebrow": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "cues": {
              "seven": 0.0384,
              "white": 0.2774,
              "chome": 0.3756,
              "aminor": 0.5058,
              "ahome": 0.6978,
              "wrong": 0.9176
            },
            "durationSeconds": 15.62
          },
          "rendered": {
            "out": "media/B01.mp4",
            "at": "2026-10-23T23:29:36.782837+00:00"
          }
        }
      },
      "estimated_duration_s": 16,
      "actual_duration_s": 15.62,
      "audio_file": "mp3/beat-B01.mp3",
      "render_duration_s": 15.625,
      "build": {
        "status": "VIDEO",
        "src": "media\\B01.mp4",
        "filled_by": "remotion:KeyNotes916",
        "at": "2026-10-23T20:32:45"
      }
    },
    {
      "beat_id": "B02",
      "act": "MECHANISM",
      "narration_text": "Step one: hear which notes are sounding. Every frequency is folded into one of twelve note names, whatever the octave. That's called chroma. Added up over the whole song, it gives twelve bars: how much of each note the song uses. In my C major pop song, C, G and E stand tallest. Here's how it sounds.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "KeyChroma916",
          "props": {
            "title": "Count the Notes",
            "sparkLine": "Twelve bars: the note profile.",
            "eyebrow": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "listen": [
              {
                "label": "POP SONG IN C MAJOR",
                "from": 0.749,
                "to": 0.9705
              }
            ],
            "cues": {
              "one": 0.0,
              "fold": 0.1317,
              "octave": 0.2092,
              "chroma": 0.2756,
              "added": 0.3199,
              "bars": 0.3925,
              "tallest": 0.6337,
              "listen": 0.6866
            },
            "durationSeconds": 27.09
          },
          "rendered": {
            "out": "media/B02.mp4",
            "at": "2026-10-23T23:33:30.676932+00:00"
          }
        }
      },
      "estimated_duration_s": 22,
      "actual_duration_s": 27.09,
      "audio_file": "mp3/beat-B02.mp3",
      "narration_audio_file": "mp3/beat-B02.mp3",
