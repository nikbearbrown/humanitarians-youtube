      }
    },
    {
      "beat_id": "B05",
      "act": "THE CATCH",
      "narration_text": "The ten misses were all in one place: minor ballads that only use the notes of the natural minor scale. Ten of twelve came out as the major key with the same seven notes. For A minor, the match was zero point eight eight six, against zero point eight nine one for C major. Raise one note, the seventh, and all twelve come out right. The standard test gives this mistake partial credit.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "KeyRelative916",
          "props": {
            "title": "Wrong Home",
            "sparkLine": "A minor, C major: identical notes.",
            "eyebrow": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "cues": {
              "misses": 0.0,
              "natural": 0.1828,
              "ten": 0.2485,
              "amin": 0.4284,
              "cmaj": 0.6484,
              "raise": 0.7084,
              "credit": 0.9512
            },
            "durationSeconds": 23.34
