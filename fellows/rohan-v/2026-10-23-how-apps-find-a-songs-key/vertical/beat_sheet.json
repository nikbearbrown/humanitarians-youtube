  "beats": [
    {
      "beat_id": "B00",
      "act": "ASK",
      "narration_text": "Hi, I am Row-Haan and this video is about how apps find a song's key: the label, like A minor or C major, that a DJ app shows next to a track. Last week it was the tempo. This time the app has to work out which note the song keeps coming home to.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
