            "segment": "How Apps Find a Song's Key",
            "command": "How does an app work out what key a song is in?",
            "runningText": "working it out…",
            "folderLabel": "@HumanitariansAI",
            "modelLabel": "Claude",
            "effortLabel": "Desktop",
            "output": [
              "count which notes the song uses",
              "compare them with every key's shape",
              "keep the closest match"
            ],
            "disclosure": "Narration: AI voice (Kokoro af_bella), script by Rohan V.",
            "eyebrow": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "cues": {
              "label": 0.2649,
              "tempo": 0.6601,
              "home": 0.9332
            },
