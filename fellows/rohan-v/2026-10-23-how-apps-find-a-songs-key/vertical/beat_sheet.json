    },
    {
      "beat_id": "B06",
      "act": "KEY CHANGE",
      "narration_text": "One label has a second problem: songs change key. This one moves up a semitone halfway, the classic pop key change. Asked for one key, my detector said C minor: neither of them. Listening in eight-second windows, it hears C major, then C sharp major.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "KeyChange916",
          "props": {
            "title": "When Keys Change",
            "sparkLine": "One label can't follow it.",
            "eyebrow": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "cues": {
              "second": 0.0445,
              "semitone": 0.271,
              "one": 0.4781,
              "neither": 0.6427,
              "windows": 0.7685,
              "sharp": 0.9214
            },
            "durationSeconds": 17.22
          },
          "rendered": {
            "out": "media/B06.mp4",
            "at": "2026-10-23T23:46:18.049227+00:00"
          }
        }
      },
      "estimated_duration_s": 20,
      "actual_duration_s": 17.22,
      "audio_file": "mp3/beat-B06.mp3",
      "render_duration_s": 17.25,
      "build": {
        "status": "VIDEO",
        "src": "media\\B06.mp4",
        "filled_by": "remotion:KeyChange916",
        "at": "2026-10-23T20:32:45"
      }
    },
    {
      "beat_id": "B07",
      "act": "WHAT TO DO",
      "narration_text": "So when an app's key looks wrong, check the relative key first: A minor and C major share every note, and harmonic-mixing charts put them side by side. And on a song with a key change, check each section, not one label.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
