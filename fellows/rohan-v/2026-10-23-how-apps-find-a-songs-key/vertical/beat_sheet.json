          "file": "song_c_major_pop.wav",
          "clip_from_s": 0.0,
          "start_s": 20.291,
          "end_s": 26.291,
          "gain_db": -8.9
        }
      ],
      "render_duration_s": 27.125,
      "build": {
        "status": "VIDEO",
        "src": "media\\B02.mp4",
