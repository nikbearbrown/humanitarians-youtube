  "beats": [
    {
      "beat_id": "B00",
      "act": "ASK",
      "narration_text": "Hi, I am Row-Haan and this video is about how noise-cancelling headphones work: how they can make an engine's hum nearly disappear, but still let you hear someone talking. The trick is to add more sound, not less.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "ClaudeComposerAsk",
          "props": {
            "greeting": "Hi, Rohan",
            "topic": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "segment": "How Noise-Cancelling Headphones Work",
            "command": "How do noise-cancelling headphones make noise disappear?",
            "runningText": "working it out…",
            "folderLabel": "@HumanitariansAI",
            "modelLabel": "Claude",
            "effortLabel": "Desktop",
            "output": [
              "play the noise back upside down",
              "keep adjusting, thousands of times a second",
              "low steady sounds cancel best"
            ],
            "disclosure": "Narration: AI voice (Kokoro af_bella), script by Rohan V.",
            "eyebrow": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "cues": {
              "hum": 0.4354,
              "talk": 0.674,
              "more": 0.8438
            },
            "durationSeconds": 13.55
          },
