        "at": "2026-10-23T20:40:37"
      }
    },
    {
      "beat_id": "B05",
      "act": "THE CURVE",
      "narration_text": "Across every pitch at once, the pattern is clear. At least ten decibels quieter up to about three hundred hertz, a little quieter up to three thousand, and above that, slightly louder. Real headphones handle those high sounds the old way: the ear cups and tips simply block them.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "AncCurve",
          "props": {
            "title": "Quiet Lows, Untouched Highs",
            "sparkLine": "The cups block the highs; the chip cancels the lows.",
            "eyebrow": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "cues": {
              "every": 0.0,
              "ten": 0.1881,
              "little": 0.3975,
              "louder": 0.5604,
              "cups": 0.8687
            },
            "durationSeconds": 17.19
          },
          "rendered": {
            "out": "media/B05.mp4",
            "at": "2026-10-24T00:06:33.899357+00:00"
          }
        }
      },
      "estimated_duration_s": 20,
      "actual_duration_s": 17.19,
      "audio_file": "mp3/beat-B05.mp3",
      "render_duration_s": 17.208333333333332,
      "build": {
        "status": "VIDEO",
        "src": "media\\B05.mp4",
        "filled_by": "remotion:AncCurve",
        "at": "2026-10-23T20:40:37"
      }
    },
    {
      "beat_id": "B06",
      "act": "WHAT TO DO",
      "narration_text": "So use noise-cancelling for steady noise: planes, trains, air conditioning. Get a good seal, because the cups and tips do the high frequencies. And with the hum gone, turn your music down: you don't have to play over it.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "HaiApplyCard",
          "props": {
            "title": "Getting the Most From Noise-Cancelling",
            "lede": "It cancels steady, low noise. The seal blocks the rest.",
            "steps": [
              "Use it for steady noise: planes, trains, air conditioning.",
              "Get a good seal: the cups and tips block the high sounds.",
              "With the hum gone, turn your music down."
            ],
            "sparkLine": "Cancel the hum, then lower the volume.",
