              "engine": 0.1344,
              "rumble": 0.2548,
              "voices": 0.322,
              "clatter": 0.3892,
              "steady": 0.497,
              "sudden": 0.6479,
              "listen": 0.691
            },
            "durationSeconds": 26.29
          },
          "rendered": {
            "out": "media/B04.mp4",
