    {
      "beat_id": "B01",
      "act": "BACKGROUND",
      "narration_text": "A text-to-speech voice works in three steps. First it cleans up the text: doctor, not D R dot. Then it turns every word into phonemes, the small sounds speech is built from; English has about forty-four, depending on accent. Only then does the voice model turn those sounds into audio. This voice, Kokoro, never sees the spelling at all. It only gets the sounds.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "VoicePipeline916",
          "props": {
            "title": "Text to Voice",
            "sparkLine": "It speaks phonemes, not text.",
            "eyebrow": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "cues": {
              "three": 0.0721,
              "clean": 0.1456,
              "phonemes": 0.3516,
              "fortyfour": 0.5174,
              "model": 0.6716,
              "never": 0.856,
              "only": 0.9454
            },
            "durationSeconds": 23.13
          },
          "rendered": {
            "out": "media/B01.mp4",
            "at": "2026-11-02T04:01:43.293481+00:00"
          }
        }
      },
      "estimated_duration_s": 24,
      "actual_duration_s": 23.13,
      "audio_file": "mp3/beat-B01.mp3",
      "render_duration_s": 23.166666666666668,
      "build": {
