        "at": "2026-11-02T00:04:59"
      }
    },
    {
      "beat_id": "B02",
      "act": "MECHANISM",
      "narration_text": "The middle step is called G to P: graphemes, the letters, to phonemes, the sounds. Ours uses a program called e-speak. It looks a word up in a dictionary, and if the word isn't there, it guesses from rules about how English letters usually sound. That works for most words. It goes wrong when the same letters make two different words.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "VoiceG2P916",
          "props": {
            "title": "Letters to Sounds",
            "sparkLine": "Dictionary first, then rules.",
            "eyebrow": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "cues": {
              "g2p": 0.0464,
              "letters": 0.1552,
              "espeak": 0.3343,
              "dict": 0.4463,
              "rules": 0.5774,
              "works": 0.755,
              "wrong": 0.8605
            },
            "durationSeconds": 20.84
          },
          "rendered": {
            "out": "media/B02.mp4",
            "at": "2026-11-02T04:05:38.838856+00:00"
          }
        }
      },
      "estimated_duration_s": 22,
