    {
      "beat_id": "B01",
      "act": "TOO MUCH DATA",
      "narration_text": "CD-quality stereo is about fourteen hundred kilobits a second: more than Bluetooth's audio link can reliably carry. So your phone squeezes the music first, with a codec. The one every device must support is SBC. On my test track, it used about three hundred and thirty kilobits: under a quarter.",
      "shot": {
        "type": "GRAPHIC",
        "source": "hyperframes",
        "motion": "choreographed",
        "hyperframes": {
          "composition": "data",
          "project": "hyperframes"
        },
