# Renders stay out; build inputs stay in. Mirrors the repository root
# .gitignore (rule changed 2026-09-18): anything the pipeline PRODUCED from a
# beat sheet goes to Google Drive; anything used to BUILD the video -- screen
# captures, source recordings, sfx, pantry stills and clips, fixtures -- is
# committed here. So nothing below is excluded by file type, only by location
# or by render suffix. The root file already covers the render folders; they
# are repeated so this folder stays safe if it is copied out on its own.

# renders
mp3/
audio/
media/
clips/
manim/
exports/
renders/
_qc/
*-slate.mp4
*-cut.mp4
*-review.mp4
*-topaz.mp4
*-8k.mp4

# the named 16:9 / 9:16 masters are renders too; they live in Drive
*_16x9.mp4
*_9x16.mp4

# local build state
build-state.json
*.verified.json
__pycache__/
*.pyc
.DS_Store
