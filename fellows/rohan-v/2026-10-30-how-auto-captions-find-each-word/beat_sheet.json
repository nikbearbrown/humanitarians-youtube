    },
    {
      "beat_id": "B04",
      "act": "NOISE",
      "narration_text": "Then I added noise. With the speech ten decibels louder than the noise, it still got ninety-seven percent of the words. At five decibels, eighty-nine percent. With noise as loud as the speech, it fell apart: an error rate of over seventy percent. Listen to that sentence, and what it wrote.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "CapNoise",
          "props": {
