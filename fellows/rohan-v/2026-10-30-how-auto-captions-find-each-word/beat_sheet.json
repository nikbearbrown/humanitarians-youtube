    {
      "beat_id": "B05",
      "act": "THE CATCH",
      "narration_text": "Louder noise didn't make it stop. It wrote words that were never said: over three hundred words for two hundred and thirty-eight, with phrases repeated over and over. And even on clean speech it writes what it expects. My narrator says Row-Haan, and it writes Rohan. It hears dollar, three, fifty, and writes a neat price with a dollar sign.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "CapCatch",
          "props": {
            "title": "It Writes What It Expects",
            "sparkLine": "Confident text isn't proof it was said.",
