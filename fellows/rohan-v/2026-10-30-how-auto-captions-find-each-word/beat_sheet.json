      }
    },
    {
      "beat_id": "B02",
      "act": "MECHANISM",
      "narration_text": "To find when each word was said, it checks where in the sound it was looking while it wrote each word, then lines those moments up in order. That method is called dynamic time warping. Here's one sentence: when each word really starts, and when Whisper says it starts.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "CapTiming",
          "props": {
            "title": "When Was Each Word Said?",
            "sparkLine": "Where it looked, lined up in order.",
            "eyebrow": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "cues": {
              "find": 0.0,
              "looking": 0.1445,
              "order": 0.3521,
              "dtw": 0.5596,
              "one": 0.6899,
              "really": 0.8221,
              "says": 0.9117
            },
            "durationSeconds": 16.38
          },
          "rendered": {
            "out": "media/B02.mp4",
            "at": "2026-11-02T04:28:47.381503+00:00"
          }
        }
      },
      "estimated_duration_s": 19,
      "actual_duration_s": 16.38,
      "audio_file": "mp3/beat-B02.mp3",
      "render_duration_s": 16.416666666666668,
      "build": {
        "status": "VIDEO",
        "src": "media\\B02.mp4",
        "filled_by": "remotion:CapTiming",
        "at": "2026-11-01T23:49:34"
      }
    },
    {
      "beat_id": "B03",
      "act": "MEASURED",
      "narration_text": "I built twenty-four sentences from this narrator's voice, word by word, so I know exactly when each word starts. Whisper's base model, the one our pipeline uses, got two hundred and thirty-four of the two hundred and thirty-eight words right. Its word starts came about a quarter of a second early, and nine in ten were within three tenths of a second.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "CapAccuracy",
          "props": {
            "title": "Words Right, Slightly Early",
            "sparkLine": "Almost every word, a quarter second early.",
            "eyebrow": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "cues": {
              "built": 0.0,
              "know": 0.2221,
              "base": 0.375,
              "words": 0.5311,
              "early": 0.7838,
