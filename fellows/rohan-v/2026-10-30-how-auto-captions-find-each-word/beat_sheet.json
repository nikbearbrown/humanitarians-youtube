    {
      "beat_id": "B06",
      "act": "WHAT TO DO",
      "narration_text": "So read auto-captions before you publish, especially names and numbers. YouTube itself says automatic captions can get words wrong. And record somewhere quiet: a few decibels of noise make a big difference.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
