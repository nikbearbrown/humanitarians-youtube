    {
      "beat_id": "B01",
      "act": "BACKGROUND",
      "narration_text": "First, the sound becomes a picture: a spectrogram with eighty frequency bands, read in thirty-second chunks. The model our videos use is Whisper, an open model first trained on six hundred and eighty thousand hours of audio from the web. It looks at the picture and predicts the text, one small piece at a time.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "CapSpectro",
          "props": {
            "title": "Sound Becomes a Picture",
            "sparkLine": "A picture of sound, read like a page.",
            "eyebrow": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "cues": {
              "picture": 0.0475,
              "eighty": 0.1798,
              "chunks": 0.307,
              "whisper": 0.4444,
              "hours": 0.6056,
              "predicts": 0.8465,
              "piece": 0.8974
            },
            "durationSeconds": 19.65
          },
          "rendered": {
            "out": "media/B01.mp4",
            "at": "2026-11-02T04:25:56.697925+00:00"
          }
        }
      },
      "estimated_duration_s": 20,
      "actual_duration_s": 19.65,
      "audio_file": "mp3/beat-B01.mp3",
      "render_duration_s": 19.666666666666668,
