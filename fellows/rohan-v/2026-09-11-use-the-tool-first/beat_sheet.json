    {
      "beat_id": "B02",
      "act": "CORRECTION",
      "narration_text": "Now the part worth reporting. I planned this series from web research, before I had access. Then I used Midjourney myself and took twenty-nine screenshots of the actual interface. Five things in my plan turned out to be wrong. There was no chat section. The grid wasn't a two-by-two, it was one row of four. And video wasn't a footnote, it's everywhere in the product. Two whole surfaces were missing from my plan completely.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "HaiProgressOverturned",
          "props": {
            "eyebrow": "HUMANITARIANS AI · WEEKLY PROGRESS",
            "title": "What 29 Screenshots Overturned",
            "leftHeader": "the plan assumed",
            "rightHeader": "the captures showed",
            "rows": [
              {
                "was": "a Chat section",
                "now": "no Chat — and two sections I had missed"
              },
              {
                "was": "a 2×2 grid of four",
                "now": "one row of four, prompt in a right rail"
              },
              {
                "was": "upscale, vary, download",
                "now": "a six-row action grid, menu hidden by default"
              },
              {
                "was": "a linear settings panel",
                "now": "a 2×2 grid of four cards, twelve controls"
              },
              {
                "was": "an image tool",
                "now": "video is first-class, everywhere"
              }
            ],
            "sparkLine": "Five assumptions, all wrong."
          },
          "rendered": {
            "out": "media/B02.mp4",
            "at": "2026-09-11T03:12:38.643904+00:00"
          }
        }
      },
