    {
      "beat_id": "B06",
      "act": "THE CATCH",
      "narration_text": "Here's what it can't do: know which note you meant. My last note is seventy-five cents below G, which puts it closer to F sharp. Let the corrector pick from every note, and it lands, perfectly in tune, on F sharp. The wrong note. Tell it the song is in C major, where F sharp isn't allowed, and it goes to G.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "PitchWrongNote916",
          "props": {
            "title": "In Tune, Wrong Note",
            "sparkLine": "Nearest note, not the right one.",
            "eyebrow": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "cues": {
