    {
      "beat_id": "B01",
      "act": "BACKGROUND",
      "narration_text": "A sung note is air vibrating. The faster the vibration repeats, the higher the note sounds. The A above middle C repeats four hundred and forty times every second: four hundred and forty hertz. Double that, and you're an octave higher. Between two neighbouring piano keys, musicians count a hundred tiny steps, called cents. Pitch correction works in cents.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "PitchCycles916",
          "props": {
            "title": "What Pitch Is",
            "sparkLine": "Faster repeats, higher note.",
            "eyebrow": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "cues": {
              "air": 0.0362,
              "faster": 0.1042,
              "a440": 0.3412,
              "double": 0.5405,
              "cents": 0.8484,
              "works": 0.9164
            },
            "durationSeconds": 22.08
          },
          "rendered": {
            "out": "media/B01.mp4",
            "at": "2026-10-06T00:05:28.858250+00:00"
          }
        }
      },
      "estimated_duration_s": 21,
      "actual_duration_s": 22.08,
      "audio_file": "mp3/beat-B01.mp3",
      "render_duration_s": 22.083333333333332,
      "build": {
