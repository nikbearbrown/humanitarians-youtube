        "at": "2026-10-05T20:30:23"
      }
    },
    {
      "beat_id": "B02",
      "act": "MECHANISM",
      "narration_text": "To measure the pitch, the software slides a copy of the sound along itself. When the copy has moved by exactly one cycle, the two line up, and the difference between them drops almost to zero. That shift is one period. Here it's two point three milliseconds, so the note is four hundred and thirty hertz. The first Auto-Tune found pitch with this same idea, called autocorrelation.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "PitchFindPeriod",
          "props": {
            "title": "Slide the Sound Along Itself",
            "sparkLine": "Where the copy lines up, you have one period.",
            "eyebrow": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "cues": {
              "slides": 0.0713,
              "lineup": 0.3201,
              "zero": 0.4219,
              "period": 0.5078,
              "hz": 0.7202,
              "first": 0.7697
            },
            "durationSeconds": 22.91
          },
          "rendered": {
            "out": "media/B02.mp4",
            "at": "2026-10-05T19:05:59.302029+00:00"
          }
        }
      },
      "estimated_duration_s": 22,
      "actual_duration_s": 22.91,
      "audio_file": "mp3/beat-B02.mp3",
      "render_duration_s": 22.916666666666668,
      "build": {
        "status": "VIDEO",
        "src": "media\\B02.mp4",
        "filled_by": "remotion:PitchFindPeriod",
        "at": "2026-10-05T20:30:23"
      }
    },
    {
      "beat_id": "B03",
      "act": "MATH",
      "narration_text": "Next it turns that number into a note. Four hundred and thirty hertz sits just below A, which is four hundred and forty. How far below? Twelve hundred, times the base-two logarithm of the ratio between them: minus thirty-nine and a half cents. So the target is A, and the job is to raise this note by almost forty cents.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "PitchSnapCents",
          "props": {
            "title": "From Hertz to Cents",
            "sparkLine": "The nearest note becomes the target.",
            "eyebrow": "HUMANITARIANS AI · AUDIO CONCEPTS",
            "cues": {
              "note": 0.018,
              "below": 0.2,
              "how": 0.3591,
              "log": 0.5148,
              "minus": 0.6526,
              "target": 0.7739
            },
            "durationSeconds": 20.33
          },
          "rendered": {
            "out": "media/B03.mp4",
            "at": "2026-10-06T00:05:21.290464+00:00"
          }
        }
      },
      "estimated_duration_s": 20,
      "actual_duration_s": 20.33,
      "audio_file": "mp3/beat-B03.mp3",
      "render_duration_s": 20.333333333333332,
      "build": {
        "status": "VIDEO",
        "src": "media\\B03.mp4",
        "filled_by": "remotion:PitchSnapCents",
        "at": "2026-10-05T20:30:23"
      }
    },
    {
      "beat_id": "B04",
      "act": "MEASURED",
      "narration_text": "So I wrote one. I synthesised seven sung notes, each a little off, with a scoop up into every note and vibrato on the long ones. On average, forty cents out. My detector measured the pitch every six milliseconds, and the corrector pulled each note to its target. Measured again afterwards, it's under three cents out. Listen: first as sung, then corrected.",
