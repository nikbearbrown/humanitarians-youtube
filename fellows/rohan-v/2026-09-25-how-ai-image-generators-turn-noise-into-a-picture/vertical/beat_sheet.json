        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "DiffuseSeedStatic916",
          "props": {
            "title": "Every Image Starts as Static",
            "quote": "the random noise you see on a TV screen",
            "quoteSource": "Midjourney documentation, “Seeds”",
            "seedLabel": "--seed 7",
            "sparkLine": "Found in the noise.",
            "eyebrow": "HUMANITARIANS AI · AI CONCEPTS",
            "cues": {
              "guide": 0.0272,
              "tv": 0.2639,
              "seed": 0.458,
              "remove": 0.7627,
              "left": 0.938
            },
            "durationSeconds": 19.58
          },
          "rendered": {
