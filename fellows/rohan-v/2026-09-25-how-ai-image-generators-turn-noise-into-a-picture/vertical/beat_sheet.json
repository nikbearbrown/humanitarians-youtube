        "at": "2026-09-26T02:01:31"
      }
    },
    {
      "beat_id": "B02",
      "act": "ANALOGY",
      "narration_text": "Think of a photo left out in the rain. Each drop smudges it a little more, until all that's left is grey speckle. Ruining a picture like that is easy, and you can do it with simple arithmetic. The hard part is going backwards. So that's what the model is trained to do: shown a smudged picture, guess what it looked like one drop earlier.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "choreographed",
        "remotion": {
          "pattern": "DiffuseRainForward916",
          "props": {
            "title": "Ruining a Picture Is Easy",
            "sparkLine": "Undo one drop at a time.",
            "eyebrow": "HUMANITARIANS AI · AI CONCEPTS",
            "cues": {
              "rain": 0.0335,
              "speckle": 0.2814,
              "arithmetic": 0.5092,
              "backwards": 0.6365,
              "earlier": 0.933
            },
            "durationSeconds": 19.9
