            "command": "How does Netflix keep playing when my internet slows down?",
            "runningText": "working it out…",
            "folderLabel": "@HumanitariansAI",
            "modelLabel": "Claude",
            "effortLabel": "Desktop",
            "output": [
              "store every show at many qualities",
              "pick the next few seconds to fit your connection",
              "serve it from a box near you"
