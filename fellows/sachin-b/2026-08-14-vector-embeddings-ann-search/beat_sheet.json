    {
      "beat_id": "B00",
      "act": "cold open",
      "narration_text": "Aloha — this is Liam, in for Bear. 'Similar' isn't a string match, it's a location. Here's how meaning becomes a point in space, and how you find its neighbors without checking everything.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 15,
      "shot": {
        "type": "REMOTION",
        "remotion": {
          "pattern": "ClaudeComposerAsk",
          "props": {
            "command": "claude \"explain vector embeddings and how ANN search finds similar text fast at scale\"",
            "topic": "SYSTEMS · VECTOR SEARCH",
            "segment": "Claude, Nearest.",
            "greeting": "Aloha, Liam",
            "runningText": "mapping meaning to points…",
            "output": [
              "Text -> a point in high-dimensional space",
              "Close together = similar meaning",
              "Brute-force doesn't scale — approximate search does"
            ],
            "folderLabel": "@NikBearBrown"
