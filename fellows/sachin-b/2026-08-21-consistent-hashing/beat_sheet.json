        "at": "2026-08-31T09:41:13"
      }
    },
    {
      "beat_id": "B01",
      "act": "executive summary",
      "narration_text": "The one idea: hash both your servers and your keys onto the same circle. A key belongs to the next server clockwise. Add or remove a server, and only the keys near it move — everyone else stays put.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 18,
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B01_BLUF",
          "file": "scenes.py"
        }
      },
      "audio_file": "mp3/beat-B01.mp3",
      "actual_duration_s": 11.5,
      "build": {
        "status": "MANIM",
        "src": "manim\\B01.mp4",
        "filled_by": "manim:B01_BLUF",
        "at": "2026-08-31T09:41:13"
      }
    },
    {
      "beat_id": "B02",
      "act": "framework",
      "narration_text": "Picture the entire hash space as a circle, not a line. Every server gets hashed onto a point on that circle. A key's owner is whichever server point comes next going clockwise.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 16,
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B02_Ring",
          "file": "scenes.py"
        }
      },
      "audio_file": "mp3/beat-B02.mp3",
      "actual_duration_s": 10.39,
      "build": {
        "status": "MANIM",
        "src": "manim\\B02.mp4",
        "filled_by": "manim:B02_Ring",
        "at": "2026-08-31T09:41:13"
      }
    },
    {
      "beat_id": "B03",
      "act": "worked example",
      "narration_text": "Four keys land at different points on the ring. Each one just walks clockwise until it hits a server — that's its owner. No modulo, no math beyond 'which point is next.'",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 16,
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B03_KeyAssignment",
          "file": "scenes.py"
        }
      },
      "audio_file": "mp3/beat-B03.mp3",
      "actual_duration_s": 9.7,
      "build": {
        "status": "MANIM",
        "src": "manim\\B03.mp4",
        "filled_by": "manim:B03_KeyAssignment",
        "at": "2026-08-31T09:41:13"
      }
    },
    {
      "beat_id": "B04",
      "act": "dynamic case",
      "narration_text": "Now add a fifth server. It only steals keys from the one neighbor immediately counter-clockwise — the arc between them. Every other server's keys never move. Change is local, not global.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 17,
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B04_AddNode",
          "file": "scenes.py"
        }
      },
      "audio_file": "mp3/beat-B04.mp3",
      "actual_duration_s": 10.94,
      "build": {
        "status": "MANIM",
        "src": "manim\\B04.mp4",
        "filled_by": "manim:B04_AddNode",
        "at": "2026-08-31T09:41:13"
      }
    },
    {
      "beat_id": "B05",
      "act": "falsifiability",
      "narration_text": "Here's where plain consistent hashing breaks: with only a few servers, the arcs land unevenly by chance — one server can own most of the ring. Real systems hash each server to multiple points, virtual nodes, to average that out.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 18,
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B05_VirtualNodes",
          "file": "scenes.py"
        }
      },
      "audio_file": "mp3/beat-B05.mp3",
      "actual_duration_s": 13.01,
      "build": {
        "status": "MANIM",
        "src": "manim\\B05.mp4",
        "filled_by": "manim:B05_VirtualNodes",
        "at": "2026-08-31T09:41:13"
      }
    },
    {
      "beat_id": "B06",
      "act": "verdict",
      "narration_text": "Verdict: a ring plus 'next clockwise' gets you locality — small changes stay small. But plain consistent hashing is unfair at small N. Virtual nodes are not optional polish; they're the part that makes it actually balanced in production.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 17,
      "shot": {
        "type": "REMOTION",
        "remotion": {
          "pattern": "ClaudeComposerAsk",
          "props": {
            "command": "claude \"verdict: when is consistent hashing the right call?\"",
            "topic": "SYSTEM DESIGN · CONSISTENT HASHING",
            "segment": "Claude, Ringed.",
            "greeting": "The verdict,",
            "runningText": "checking the mechanism…",
            "output": [
              "Locality: adding/removing a node remaps ~1/N keys",
              "Weakness: few nodes → uneven arcs, uneven load",
              "Fix: virtual nodes, not optional in production"
            ],
            "folderLabel": "@NikBearBrown"
          },
          "rendered": {
