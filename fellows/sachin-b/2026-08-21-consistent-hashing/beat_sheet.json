    {
      "beat_id": "B00",
      "act": "cold open",
      "narration_text": "Ciao — this is Liam, in for Bear. You've got a system-design interview coming, and consistent hashing keeps showing up. Here's the actual mechanism, not just the buzzword.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 13,
      "shot": {
        "type": "REMOTION",
        "remotion": {
          "pattern": "ClaudeComposerAsk",
          "props": {
            "command": "claude \"explain consistent hashing: the ring, minimal remapping, virtual nodes\"",
            "topic": "SYSTEM DESIGN · CONSISTENT HASHING",
            "segment": "Claude, Ringed.",
            "greeting": "Ciao, Liam",
            "runningText": "walking the ring…",
            "output": [
              "A ring, not a modulo",
              "Adding a node moves ~1/N keys, not all of them",
              "Real systems add virtual nodes to smooth load"
            ],
            "folderLabel": "@NikBearBrown"
          },
          "rendered": {
            "out": "media/B00.mp4",
            "at": ""
          }
        }
      },
      "audio_file": "mp3/beat-B00.mp3",
      "actual_duration_s": 9.48,
      "build": {
        "status": "VIDEO",
        "src": "media\\B00.mp4",
