        "at": "2026-08-31T11:20:40"
      }
    },
    {
      "beat_id": "B01",
      "act": "executive summary",
      "narration_text": "If a yes-or-no question about a number x flips exactly once as x grows — infeasible, then feasible — you can binary search for exactly where it flips. That's binary search on the answer.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 16,
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B01_BLUF",
          "file": "scenes.py"
        }
      },
      "audio_file": "mp3/beat-B01.mp3",
      "actual_duration_s": 11.28,
      "build": {
        "status": "MANIM",
        "src": "manim\\B01.mp4",
        "filled_by": "manim:B01_BLUF",
        "at": "2026-08-31T11:20:40"
      }
    },
    {
      "beat_id": "B02",
      "act": "framework",
      "narration_text": "Lay out every possible answer on a line, low to high. If 'is this value good enough' flips exactly once as you scan left to right, that flip point is the answer — findable in log of the range, not by checking each one.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 17,
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B02_Framework",
          "file": "scenes.py"
        }
      },
      "audio_file": "mp3/beat-B02.mp3",
      "actual_duration_s": 12.41,
      "build": {
        "status": "MANIM",
        "src": "manim\\B02.mp4",
        "filled_by": "manim:B02_Framework",
        "at": "2026-08-31T11:20:40"
      }
    },
    {
      "beat_id": "B03",
      "act": "worked example",
      "narration_text": "Take 'minimum capacity to ship all packages within D days.' Guess a capacity. Simulate loading packages greedily — does it finish within D days? Feasible, try smaller. Not feasible, try bigger. That's the whole loop.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 17,
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B03_Worked",
          "file": "scenes.py"
        }
      },
      "audio_file": "mp3/beat-B03.mp3",
      "actual_duration_s": 12.38,
      "build": {
        "status": "MANIM",
        "src": "manim\\B03.mp4",
        "filled_by": "manim:B03_Worked",
        "at": "2026-08-31T11:20:40"
      }
    },
    {
      "beat_id": "B04",
      "act": "mechanism in motion",
      "narration_text": "Each guess cuts the remaining range in half. A handful of guesses, and the exact minimum capacity falls out — without ever trying every possible number.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 14,
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B04_Narrowing",
          "file": "scenes.py"
        }
      },
      "audio_file": "mp3/beat-B04.mp3",
      "actual_duration_s": 9.05,
      "build": {
        "status": "MANIM",
        "src": "manim\\B04.mp4",
        "filled_by": "manim:B04_Narrowing",
        "at": "2026-08-31T11:20:40"
      }
    },
    {
      "beat_id": "B05",
      "act": "falsifiability",
      "narration_text": "This only works if feasible is actually monotonic. If 'good enough' can flip back and forth as x increases, binary search on the answer silently gives you the wrong value. Always check monotonicity before trusting the pattern.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 17,
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B05_Monotonic",
          "file": "scenes.py"
        }
      },
      "audio_file": "mp3/beat-B05.mp3",
      "actual_duration_s": 13.13,
      "build": {
        "status": "MANIM",
        "src": "manim\\B05.mp4",
        "filled_by": "manim:B05_Monotonic",
        "at": "2026-08-31T11:20:40"
      }
    },
    {
      "beat_id": "B06",
      "act": "verdict",
      "narration_text": "Verdict: the recognition step matters more than the code. Once you see a monotonic feasible check hiding in a problem, the binary search itself is boilerplate. The bug is always trusting a predicate you never verified.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 16,
