      "beat_id": "B00",
      "act": "cold open",
      "narration_text": "Yassou — this is Liam, in for Bear. You know binary search on a sorted array. This is the other one: binary search on the answer itself. No array required.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 14,
