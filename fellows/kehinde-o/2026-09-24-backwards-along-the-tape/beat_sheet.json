                "aspect": 4.5813953488372094,
                "expression": "L = f(g(x))",
                "at": 2.5
              },
              {
                "src": "data:image/svg+xml;base64,",
                "aspect": 2.5733333333333333,
                "expression": "\\frac{\\partial L}{\\partial x} = \\frac{\\partial L}{\\partial y} \\cdot \\frac{\\partial y}{\\partial x}",
                "at": 8.0
              },
              {
                "src": "data:image/svg+xml;base64,",
                "aspect": 2.3978494623655915,
                "expression": "\\frac{\\partial L}{\\partial x} = \\sum_{k} \\frac{\\partial L}{\\partial y_k} \\frac{\\partial y_k}{\\partial x}",
                "at": 14.5
              }
            ],
            "note": "Multiply along a path. Sum where paths meet.",
            "conditions": "Each operation only needs its own local derivative."
