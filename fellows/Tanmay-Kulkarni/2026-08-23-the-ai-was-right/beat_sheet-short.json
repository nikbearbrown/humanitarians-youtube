    {
      "beat_id": "B02",
      "act": "SUMMARY + FRAMEWORK",
      "engine": "kokoro",
      "voice": "af_bella",
      "tone": "warm, welcoming — the handshake, slow down",
      "narration_text": "Hi, I'm Tanmay Kulkarni, in for Humanitarians AI. This video is about getting your song into film and TV — that's called sync licensing — and what happens when you let AI do the research for you. Here's the short version. Every claim it hands you has layers. You can check the top three. There's a fourth one underneath that no check catches, and that's the one that costs you.",
      "shot": {
        "type": "REMOTION",
        "remotion": {
          "pattern": "SyncClaimLayers916",
          "props": {
            "sparkLine": "Every claim has layers.",
            "claim": "“The music supervisor placed that song.”",
            "layers": [
              {
                "question": "Did this person work on this show?",
                "verdict": "Checkable",
                "ok": true
              },
              {
                "question": "Is the song actually in it?",
                "verdict": "Checkable",
                "ok": true
              },
              {
                "question": "Is the detail right?",
                "verdict": "Checkable",
                "ok": true
              }
            ],
            "hiddenQuestion": "Whose decision was it?",
            "hiddenVerdict": "No check covers this",
            "scale": 1.1
