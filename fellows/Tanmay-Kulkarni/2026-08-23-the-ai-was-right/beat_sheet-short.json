    {
      "beat_id": "B07",
      "act": "COOLING DOWN",
      "engine": "kokoro",
      "voice": "af_bella",
      "tone": "pull right back — careful, unhurried, opposite energy to B05",
      "narration_text": "Now — I want to be careful here. This was ten claims, one model, one try. That's a demonstration, not a study. The AI wasn't lying. Every fact checked out. The problem was quieter than that.",
      "shot": {
        "type": "REMOTION",
