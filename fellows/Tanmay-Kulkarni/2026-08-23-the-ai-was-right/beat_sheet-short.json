    {
      "beat_id": "B03",
      "act": "THE RECORD UNDERNEATH",
      "engine": "kokoro",
      "voice": "af_bella",
      "tone": "curious, digging",
      "narration_text": "So let's dig into one. Underneath every claim there's a public record, and it isn't evenly solid. At the bottom, bedrock — a free database called Songview, thirty-eight million songs from ASCAP and BMI. Who wrote it, who owns it. But the thing you need — which show, which scene — isn't down there. It's on the surface, where the public types it in. So the three layers you can check rest on soft ground. The fourth isn't in any record at all.",
      "shot": {
        "type": "REMOTION",
        "remotion": {
          "pattern": "SyncRecordStrata916",
          "props": {
            "sparkLine": "The record is not evenly solid.",
            "bands": [
              {
