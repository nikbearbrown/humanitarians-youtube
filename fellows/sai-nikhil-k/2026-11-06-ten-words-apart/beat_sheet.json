    {
      "beat_id": "B02",
      "act": "THE SCORE",
      "narration_text": "The math is short. Seven words make twenty-one pairs. The score is a hundred times the average distance between them, measured in Glove, a map of word meanings learned from a huge crawl of the web. Words that mean similar things sit close together; unrelated words sit far apart.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "show": [
          {
            "at": 0.15,
            "event": "seven words make 21 pairs"
          },
          {
            "at": 0.45,
            "event": "DAT = 100 × the average of the 21 distances"
          },
          {
            "at": 0.85,
            "event": "the note: farm animals 42, far apart 87"
          }
        ],
        "remotion": {
          "pattern": "TypesetMath",
          "props": {
            "title": "The whole score, in two lines",
            "rows": [
              {
                "src": "data:image/svg+xml;base64,",
                "aspect": 7.228571428571429,
                "expression": "7 \\times 6 \\div 2 = 21",
                "at": 0.97
              },
              {
                "src": "data:image/svg+xml;base64,",
                "aspect": 7.575757575757576,
                "expression": "\\mathrm{DAT} = 100 \\times \\frac{d_1 + d_2 + \\cdots + d_{21}}{21}",
                "at": 2.56
              }
            ],
            "note": "Farm animals: 42. Far apart: 87.",
            "conditions": "d: the distance between two words, 1 − cosine similarity of their GloVe vectors (840B tokens, 300 dimensions) · only the first 7 valid, unique words count · Olson et al., PNAS 2021; official code, MIT"
          },
