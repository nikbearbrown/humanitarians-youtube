    {
      "beat_id": "B06",
      "act": "SEVEN DIFFERENCES",
      "narration_text": "And that is the honest limit of the comparison. The two models differ in seven ways at once: shortcuts, depth, receptive field, downsampling, where the normalisation sits, the head, and total size. So the paper now says, in plain words, that this is a comparison of two families, not a clean test of residual connections alone.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "FormACard916",
          "props": {
            "lines": [
              "Seven differences at once.",
              "Shortcuts, depth, reach, downsampling, norm, head, size.",
              "Family versus family, not one factor."
            ],
            "meta": [
              "the paper now states this limit directly"
            ],
            "dark": true
          },
          "rendered": {
            "out": "media/B06.mp4",
            "at": "2026-10-23T18:58:22.799887+00:00"
          }
        }
      },
      "estimated_duration_s": 22,
      "actual_duration_s": 18.07,
      "audio_file": "mp3/beat-B06.mp3",
      "render_duration_s": 18.083333333333332,
      "build": {
