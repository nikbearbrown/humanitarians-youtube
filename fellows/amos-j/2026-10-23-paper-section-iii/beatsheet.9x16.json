        "at": "2026-10-23T15:08:21"
      }
    },
    {
      "beat_id": "B01",
      "act": "BLUF",
      "narration_text": "Short version: the draft described experiments that were never run. A network that is not in the code, a series of ablations nobody trained, and training settings that do not match the records. The rewrite describes only the two models that actually ran.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "type-on",
        "remotion": {
          "pattern": "BrutalistHesitantWriter916",
          "props": {
            "text": "The draft described\nexperiments that never ran.\n\nNow it describes\nthe ones that did.",
            "face": "serif",
            "align": "left",
            "fontSize": 88,
            "lineSpacing": 1.3
          },
          "rendered": {
            "out": "media/B01.mp4",
            "at": "2026-10-23T18:48:31.819731+00:00"
          }
        }
      },
      "estimated_duration_s": 16,
      "actual_duration_s": 14.08,
      "audio_file": "mp3/beat-B01.mp3",
      "render_duration_s": 14.083333333333334,
      "build": {
        "status": "VIDEO",
        "src": "media\\B01.mp4",
        "filled_by": "remotion:BrutalistHesitantWriter916",
        "at": "2026-10-23T15:08:21"
      }
    },
    {
      "beat_id": "B02",
      "act": "WHAT THE DRAFT CLAIMED",
      "narration_text": "Here is what the draft claimed. A faithful reimplementation of the published twenty five layer ResNet: it is not in the repository. A series of plain networks at three depths, plus pooling and kernel ablations: none implemented, none run. A batch size of ten: the runs used sixty four. Five fine-tuning splits: there was one.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "FormBCard916",
          "props": {
            "title": "What the draft claimed",
            "items": [
              {
                "label": "ResNet-25",
                "sub": "not in the code",
                "icon": "BOX"
              },
              {
                "label": "Depth sweeps",
                "sub": "never run",
                "icon": "BOX"
              },
              {
                "label": "Batch size 10",
                "sub": "actually 64",
                "icon": "BOX"
              },
              {
                "label": "Five splits",
                "sub": "actually one",
                "icon": "BOX"
              }
            ],
            "dark": false
          },
          "rendered": {
            "out": "media/B02.mp4",
            "at": "2026-10-23T18:50:37.366691+00:00"
          }
        }
      },
      "estimated_duration_s": 22,
      "actual_duration_s": 18.07,
      "audio_file": "mp3/beat-B02.mp3",
      "render_duration_s": 18.083333333333332,
      "build": {
        "status": "VIDEO",
        "src": "media\\B02.mp4",
        "filled_by": "remotion:FormBCard916",
        "at": "2026-10-23T15:08:21"
      }
    },
    {
      "beat_id": "B03",
      "act": "AND MORE",
      "narration_text": "And the smaller details drifted too. The draft said ten percent was held out for validation. The runs used a sixty seven, thirty three split. It said the best checkpoint was chosen on validation. In fact the last epoch was kept, with no validation at all during fine-tuning. And a multiple-comparison correction was described that was never implemented.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "FormACard916",
          "props": {
            "lines": [
              "Validation: claimed 10%, actually 33%.",
              "Best checkpoint claimed; last epoch kept.",
              "A statistical correction never implemented."
            ],
            "meta": [
              "each one corrected to match the run records"
            ],
            "dark": false
          },
          "rendered": {
            "out": "media/B03.mp4",
            "at": "2026-10-23T18:52:37.798391+00:00"
          }
        }
      },
      "estimated_duration_s": 22,
      "actual_duration_s": 18.92,
      "audio_file": "mp3/beat-B03.mp3",
      "render_duration_s": 18.958333333333332,
      "build": {
        "status": "VIDEO",
        "src": "media\\B03.mp4",
        "filled_by": "remotion:FormACard916",
        "at": "2026-10-23T15:08:21"
      }
    },
    {
      "beat_id": "B04",
      "act": "THE TWO MODELS",
      "narration_text": "So what actually exists? Two networks. Our plain CNN: six convolution blocks, forty thousand parameters. Our ResNet: a stem and four stages of residual blocks, two hundred sixty two thousand parameters. The published twenty five layer ResNet, at over a million parameters, now appears only as a reference, clearly marked as not trained here.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "FormBCard916",
          "props": {
            "title": "What actually exists",
            "items": [
              {
                "label": "Plain CNN",
                "sub": "40,446 params",
                "icon": "BOX"
              },
              {
                "label": "Our ResNet",
                "sub": "262,510 params",
                "icon": "BOX"
              },
              {
                "label": "Ho ResNet-25",
                "sub": "1,340,878 params",
                "icon": "BOX"
              },
              {
                "label": "Not trained",
                "sub": "reference only",
                "icon": "BOX"
              }
            ],
            "dark": false
          },
          "rendered": {
            "out": "media/B04.mp4",
            "at": "2026-10-23T18:54:44.025473+00:00"
          }
        }
