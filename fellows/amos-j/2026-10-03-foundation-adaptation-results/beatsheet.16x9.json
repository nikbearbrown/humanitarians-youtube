    {
      "beat_id": "B06",
      "act": "THE SHIFT",
      "narration_text": "Why would the winner flip? Look at validation. Every arm scored around ninety four percent on the isolate task's validation, and around ninety nine on the clinical one. On test, seventy eight to ninety two. Validation came from the same files as training. The real difficulty is the shift between measurement sets and between years, and freezing the pretrained model acts as a brake that holds up best when the year changes.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "FormACard",
          "props": {
            "lines": [
              "Validation: about 94% and 99%.",
              "Test: 78% to 92%.",
              "The hard part is the shift, not the classes."
            ],
            "meta": [
              "frozen weights hold up best when the year changes"
            ],
            "dark": true
          },
          "rendered": {
            "out": "media/B06.mp4",
            "at": "2026-10-09T17:58:08.162609+00:00"
          }
        }
      },
      "estimated_duration_s": 26,
      "actual_duration_s": 20.48,
