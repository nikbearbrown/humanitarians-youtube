        "filled_by": "remotion:FormBCard",
        "at": "2026-10-09T14:22:51"
      }
    },
    {
      "beat_id": "B03",
      "act": "FOUR ARMS",
      "narration_text": "Then four ways to use it, each with the same tuning budget. From scratch, as the control. Head only: freeze the pretrained model and train a new final layer. Full fine-tuning: start from it and train everything. And adapters: freeze it and train small add-on layers, four and a half percent of the parameters.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "FormBCard",
          "props": {
            "title": "Four ways to train",
            "items": [
              {
                "label": "From scratch",
                "sub": "the control",
                "icon": "BOX"
              },
              {
                "label": "Head only",
                "sub": "frozen, new head",
                "icon": "BOX"
              },
              {
                "label": "Fine-tune all",
                "sub": "start from A",
                "icon": "BOX"
              },
              {
                "label": "Adapters",
                "sub": "4.5% trained",
                "icon": "BOX"
              }
            ],
            "dark": false
          },
          "rendered": {
            "out": "media/B03.mp4",
            "at": "2026-10-09T17:54:34.559548+00:00"
          }
        }
