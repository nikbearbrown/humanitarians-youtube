    {
      "beat_id": "B03",
      "act": "FINDING_TWO",
      "estimated_duration_s": 22,
      "narration_text": "The second finding is cautionary. Most studies use general-purpose models and simple prompts. Evaluations are often automated or expert-led, and direct involvement of people with disabilities is limited. A passing AI result does not prove real-world accessibility.",
      "voice": "af_bella",
      "engine": "kokoro",
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "motion": "callout",
        "remotion": {
          "pattern": "RushaliRepoExplainer",
          "props": {
            "scene": "research",
            "eyebrow": "MY FINDING TWO",
            "title": "AI is an assistant, not a verdict",
            "subtitle": "Technical feasibility is not the same as lived accessibility.",
            "sparkLine": "A human-in-the-loop is part of the evidence.",
            "researchVariant": "validation gap",
            "bullets": [
              "general model + prompt",
              "automated or expert checks",
              "limited disability participation",
              "AI result is not approval"
            ],
