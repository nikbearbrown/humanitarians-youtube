    {
      "beat_id": "B04",
      "act": "APPLICATION",
      "estimated_duration_s": 25,
      "narration_text": "For Humanitarians AI, I would use the paper as a layered workflow. First, run automated checks for links, structure, contrast, labels, and alternative text. Then use an LLM to explain the issue and propose a focused change. Finally, verify it against WCAG and test the experience with keyboard users, screen readers, and people with disabilities.",
      "voice": "af_bella",
      "engine": "kokoro",
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "motion": "callout",
        "remotion": {
