      "beat_id": "B02",
      "act": "FINDING_ONE",
      "estimated_duration_s": 22,
      "narration_text": "The first useful finding is that LLMs perform best on clear, structured checks. Missing or vague alternative text appeared in 21 studies, insufficient color contrast in 16, and keyboard or tabindex problems in 11. These are practical starting points for AI-assisted QA.",
      "voice": "af_bella",
      "engine": "kokoro",
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "motion": "callout",
        "remotion": {
          "pattern": "RushaliRepoExplainer",
          "props": {
            "scene": "research",
            "eyebrow": "MY FINDING ONE",
            "title": "AI is strongest on concrete checks",
            "subtitle": "The review repeatedly sees issues that can be expressed in text, markup, or measurable presentation rules.",
            "sparkLine": "Start with the issues automation can explain clearly.",
            "researchVariant": "reviewed studies",
            "bullets": [
              "alt text: 21",
