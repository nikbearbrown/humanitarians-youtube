      "beat_id": "B01",
      "act": "W3C",
      "estimated_duration_s": 23,
      "narration_text": "The W3C Link Checker is a fast baseline. It downloads raw HTML, extracts anchors, images, iframes, and stylesheets, then sends lightweight HTTP requests. The scan found a 500 timeout for an external Mutant link, a 301 YouTube playlist redirect, and N/A for some blocked mail and social links.",
      "voice": "af_bella",
      "engine": "kokoro",
      "audio_file": "mp3/beat-B01.mp3",
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "motion": "callout",
        "remotion": {
          "pattern": "RushaliRepoExplainer",
          "props": {
            "scene": "research",
            "eyebrow": "TRADITIONAL CRAWLER",
            "title": "W3C checks whether endpoints respond",
            "subtitle": "Raw HTML becomes a list of URLs, then status codes become the baseline report.",
            "sparkLine": "Fast reachability evidence.",
            "researchVariant": "status codes",
            "bullets": [
              "200 reachable",
              "301 redirected",
              "500 timeout",
              "N/A blocked"
            ],
            "chips": [
