    {
      "beat_id": "B02",
      "act": "LIMIT",
      "estimated_duration_s": 16,
      "narration_text": "That baseline has an important limit. W3C does not run a browser engine, execute JavaScript, or wait for Next.js hydration. It cannot tell whether an embedded player, client-side route, or visual element actually works.",
      "voice": "af_bella",
      "engine": "kokoro",
      "audio_file": "mp3/beat-B02.mp3",
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "motion": "callout",
        "remotion": {
          "pattern": "RushaliRepoExplainer",
          "props": {
            "scene": "research",
            "eyebrow": "THE BLIND SPOT",
            "title": "Reachable does not mean usable",
            "subtitle": "Static parsing stops before JavaScript behavior and visual interaction begin.",
