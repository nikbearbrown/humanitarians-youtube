    {
      "beat_id": "B04",
      "act": "EVIDENCE",
      "narration_text": "Here is the rare subpopulation's share, generation by generation. Four and a half percent to start. Three and a quarter by generation ten. One and a half by generation twenty. By generation thirty it is zero. Across sixty runs it went extinct in forty-nine of them, and in not one of those forty-nine did it ever come back.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "show": [
          {
            "at": "open",
            "event": "axes draw, then the curve starts at 4.5% on the left"
          },
          {
            "at": "0.45",
            "event": "the line sags through generation 10 and 20"
          },
          {
            "at": "0.7",
            "event": "it reaches the axis and stays flat on zero"
          },
          {
            "at": "0.85",
            "event": "the extinction point lights terracotta"
          }
        ],
        "remotion": {
          "pattern": "PositionCurve",
          "props": {
