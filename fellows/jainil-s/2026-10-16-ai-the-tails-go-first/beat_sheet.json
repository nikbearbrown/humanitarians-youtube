    {
      "beat_id": "B03",
      "act": "TURN",
      "narration_text": "Now the loop. Generation one is a model fitted to generation zero's samples. Generation two is fitted to generation one's output. And so on down the line. After that first step, no real data ever enters again. Nothing here is adversarial and nothing is badly implemented — every generation simply does its best with whatever the last one handed it.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "show": [
          {
            "at": "open",
            "event": "the first card, 'Real data', springs up"
          },
          {
            "at": "0.35",
            "event": "arrow draws, Generation 1 lands"
          },
          {
            "at": "0.55",
            "event": "arrow draws, Generation 2 lands"
          },
          {
            "at": "0.75",
            "event": "arrow draws, Generation n lands"
          },
          {
            "at": "0.88",
            "event": "the terracotta note under the real-data card: it is never seen again"
          }
        ],
        "remotion": {
          "pattern": "StageRail",
          "props": {
            "stages": [
              {
                "label": "Real data",
                "sub": "seen once"
              },
              {
                "label": "Generation 1",
