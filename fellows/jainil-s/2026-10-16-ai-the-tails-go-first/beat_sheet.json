  "beats": [
    {
      "beat_id": "B00",
      "act": "ASK",
      "narration_text": "Annyeong. This is Jainil. There is a lot of synthetic data around now, and a tempting idea that comes with it: a model generates training data, you train the next model on that data, and round it goes. This week I ran that loop sixty times, and watched what it throws away first.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "type-on",
        "show": [
          {
            "at": "open",
            "event": "composer on cream, spark + 'Annyeong, Jainil' above it"
          },
          {
            "at": "0.3",
            "event": "the question types itself in"
          },
          {
            "at": "0.75",
            "event": "send arms terracotta, running indicator"
          },
          {
            "at": "0.9",
            "event": "two output lines land"
          }
        ],
        "remotion": {
          "pattern": "ClaudeComposerAsk",
          "props": {
            "greeting": "Annyeong, Jainil",
            "topic": "STEM · SYNTHETIC DATA",
            "segment": "The Tails Go First",
            "command": "If I keep training each model on the last model's output, what breaks first?",
            "runningText": "running the loop…",
            "output": [
              "Not the average.",
              "The rare cases."
            ],
            "folderLabel": "@HumanitariansAI",
            "modelLabel": "Fable 5"
          },
          "rendered": {
            "out": "media/B00.mp4",
            "at": "2026-10-16T23:50:23.470043+00:00"
          }
        }
      },
      "estimated_duration_s": 19,
      "actual_duration_s": 15.15,
      "audio_file": "mp3/beat-B00.mp3",
      "render_duration_s": 15.166666666666666,
      "build": {
        "status": "VIDEO",
        "src": "media\\B00.mp4",
        "filled_by": "remotion:ClaudeComposerAsk",
        "at": "2026-10-16T20:12:47"
      }
    },
    {
      "beat_id": "B01",
      "act": "BLUF",
      "narration_text": "Here is the whole idea in one breath. Train a model on its own output, over and over, and the average stays perfectly fine. What disappears is the rare stuff. It goes quietly, nothing warns you, and it does not come back.",
      "lead_silence_s": 0.8,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "type-on",
        "show": [
          {
            "at": "open",
            "event": "empty cream page, caret blinking"
          },
          {
            "at": "0.2",
            "event": "writer types 'Train on your own output, and nothing is lost.'"
          },
          {
            "at": "0.6",
            "event": "writer stops on 'nothing', deletes it"
          },
          {
            "at": "0.78",
            "event": "'the rare things are' types in its place"
          }
        ],
        "remotion": {
          "pattern": "BrutalistHesitantWriter",
          "props": {
            "text": "Train on your own output,\nand nothing is lost.",
            "triggerWords": "nothing",
            "replacementWords": "the rare things are",
            "face": "serif",
            "align": "center",
            "seed": "ai-the-tails-go-first-b01"
          },
          "rendered": {
            "out": "media/B01.mp4",
            "at": "2026-10-16T23:51:14.842527+00:00"
          }
        }
