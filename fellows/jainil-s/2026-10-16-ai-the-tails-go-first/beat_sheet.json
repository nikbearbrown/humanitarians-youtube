            ],
            "title": "SHARE OF THE RARE SUBPOPULATION",
            "startLabel": "generation 0",
            "endLabel": "generation 60",
            "yLabel": "% of the data",
            "lowCallout": "extinct — and it never returns",
            "caption": "Every fifth generation. Extinct in 49 of 60 runs; recovered in 0 of those 49.",
            "plotScale": 1.3
          },
          "rendered": {
