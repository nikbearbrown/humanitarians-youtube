                "sub": "fitted to gen n-1's output"
              }
            ],
            "activeIndex": 0,
            "activeNote": "never seen again",
            "title": "EACH MODEL LEARNS FROM THE LAST ONE'S OUTPUT",
            "caption": "No adversary, no bug. Every generation does its best with what it was given."
          },
          "rendered": {
            "out": "media/B03.mp4",
