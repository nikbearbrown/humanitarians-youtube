    {
      "beat_id": "B06",
      "act": "SOURCE",
      "narration_text": "This is not my phrasing, it is the paper's own. Shumailov and colleagues, in Nature, twenty twenty-four. They found it across language models, variational autoencoders, and Gaussian mixture models — and that last family is the one I just ran in front of you. Note the word they chose for it: irreversible.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "card",
        "show": [
          {
            "at": "open",
            "event": "cream card, the quote reveals as the voice reaches it"
          },
          {
            "at": "0.85",
            "event": "citation settles beneath, smaller and softer"
          }
        ],
        "remotion": {
          "pattern": "FormACard",
          "props": {
            "lines": [
              "“We find that indiscriminate use of model-generated content in training causes irreversible defects in the resulting models, in which tails of the original content distribution disappear.”"
            ],
            "meta": [
              "SOURCE — Shumailov, Shumaylov, Zhao, Papernot, Anderson & Gal, Nature 631:755–759, 2024"
            ],
            "dark": false
          },
          "rendered": {
            "out": "media/B06.mp4",
            "at": "2026-10-16T23:56:54.163641+00:00"
          }
        }
