      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "type-on",
        "show": [
          {
            "at": "open",
            "event": "empty cream page, caret blinking"
          },
          {
            "at": "0.2",
            "event": "writer types 'The error curve dips once.'"
          },
          {
            "at": "0.6",
            "event": "writer stops on 'once', deletes it"
          },
          {
            "at": "0.75",
            "event": "'twice' types in its place — 'dips twice' is literally what double descent means"
          }
        ],
        "remotion": {
          "pattern": "BrutalistHesitantWriter",
