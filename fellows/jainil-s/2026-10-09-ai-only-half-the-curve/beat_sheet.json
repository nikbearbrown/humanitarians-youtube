    {
      "beat_id": "B04",
      "act": "MECHANISM",
      "narration_text": "Here is why it happens. At exactly one hundred parameters there is precisely one setting that passes through all hundred points, and you get it whether it is sensible or not. Go wider and many different curves pass through those same points. Now the procedure gets to choose, and least squares takes the smallest one, which is the smoothest one. More capacity buys you a better choice, not a worse fit.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "show": [
          {
            "at": "open",
            "event": "six data dots appear, identical in both panels"
          },
          {
            "at": "0.25",
            "event": "LEFT: a single violently swinging curve draws through every dot"
          },
          {
            "at": "0.5",
            "event": "RIGHT: five faint candidates draw through the same dots"
          },
          {
            "at": "0.75",
            "event": "the smooth terracotta curve draws over them — the one that gets picked"
          },
          {
            "at": "0.9",
            "event": "caption lands"
          }
        ],
        "remotion": {
          "pattern": "InterpolatorChoice",
          "props": {
            "values": [
              0.62,
              0.28,
              0.74,
              0.35,
              0.8,
              0.44
            ],
            "title": "WHY MORE ROOM HELPS",
            "leftTitle": "exactly enough parameters",
            "rightTitle": "far more than enough",
            "leftNote": "one fit exists. you get this one.",
            "rightNote": "many fits exist. it takes the smoothest.",
            "nCandidates": 5,
            "wildness": 0.3,
            "caption": "Every curve here passes through every point. Only one of these panels had a choice."
          },
          "rendered": {
            "out": "media/B04.mp4",
            "at": "2026-10-10T19:28:23.435606+00:00"
          }
        }
      },
