    {
      "beat_id": "B06",
      "act": "SOURCE",
      "narration_text": "This is not a quirk of one small experiment. The shape has a name and a paper behind it. Belkin and colleagues, in the Proceedings of the National Academy of Sciences, twenty nineteen, in this same family of models. And Nakkiran and colleagues showed the same shape along training time, not just model size. You can train past the peak as well as build past it.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "card",
        "show": [
          {
            "at": "open",
            "event": "cream card, quote reveals line by line as the voice reaches it"
          },
          {
            "at": "0.8",
            "event": "citation line settles softly beneath, smaller than the quote"
          }
        ],
        "remotion": {
          "pattern": "FormACard",
          "props": {
            "lines": [
              "“This double-descent curve subsumes the textbook U-shaped bias-variance trade-off curve by showing how increasing model capacity beyond the point of interpolation results in improved performance.”"
            ],
            "meta": [
              "SOURCE — Belkin, Hsu, Ma & Mandal, PNAS 116(32), 2019"
            ],
            "dark": false
          },
          "rendered": {
            "out": "media/B06.mp4",
            "at": "2026-10-10T18:50:04.532622+00:00"
          }
        }
      },
      "qc": {
        "sparse": true
      },
      "estimated_duration_s": 24,
