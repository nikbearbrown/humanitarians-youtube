    {
      "beat_id": "B00",
      "act": "ASK",
      "narration_text": "Namaste. This is Jainil. You add parameters, the validation error starts climbing, so you stop and keep the smaller model. Textbook overfitting. That rule is right about what you just saw, and wrong about what happens next, because the curve you were taught is only the left half of the real one.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "type-on",
        "show": [
          {
            "at": "open",
            "event": "composer sits empty on the cream page, spark + 'Namaste, Jainil' above it"
          },
          {
            "at": "0.3",
            "event": "the question types itself into the composer"
          },
          {
            "at": "0.75",
            "event": "send arms terracotta, running indicator appears"
          },
          {
            "at": "0.9",
            "event": "two output lines land — the ask is answered, not left hanging"
          }
        ],
        "remotion": {
          "pattern": "ClaudeComposerAsk",
          "props": {
            "greeting": "Namaste, Jainil",
            "topic": "STEM · MODEL CAPACITY",
            "segment": "You're Only Seeing Half the Curve",
            "command": "I added parameters, my validation error went up, so I stopped there. Did I stop too early?",
            "runningText": "checking where you stopped…",
            "output": [
              "Depends where you stopped.",
              "There is a second descent past the peak."
            ],
            "folderLabel": "@HumanitariansAI",
            "modelLabel": "Fable 5"
