    },
    {
      "beat_id": "B02",
      "act": "ROUTER AND EXPERTS",
      "narration_text": "Mixture of Experts replaces the single large feed-forward network inside each transformer block with multiple smaller ones — called experts. A learned router sits at the input and decides which experts handle each token. It computes a probability over all experts, picks the top two, and sends the token only to those. Their outputs are weighted by the router's scores and combined. Eight experts, two active — the block has eight times the capacity but only runs two experts' worth of compute.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "build",
        "show": [
          {
            "at": 0.0,
            "event": "MoeRouter builds in"
