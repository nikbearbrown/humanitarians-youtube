    {
      "beat_id": "B03",
      "act": "SPARSE ACTIVATION",
      "narration_text": "This is the core insight: total parameters and active parameters are different numbers. A dense thirteen-billion-parameter model activates all thirteen billion on every token. An MoE model with eight experts of six and a half billion each holds around fifty-two billion parameters total — but only activates thirteen billion per token, the same as the dense model. Four times the knowledge capacity, same compute budget. The model is massive, but any single forward pass through it is small.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "build",
        "show": [
