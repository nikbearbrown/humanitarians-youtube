[
  {
    "beat": "S01",
    "start": 0.1,
    "end": 2.358,
    "text": "Hi, I am Dhrumil Shah, and this video is"
  },
  {
    "beat": "S01",
    "start": 2.358,
    "end": 4.504,
    "text": "about Mycroft Phase 5, where I built a"
  },
  {
    "beat": "S01",
    "start": 4.504,
    "end": 6.254,
    "text": "quantitative thesis-resilience,"
  },
  {
    "beat": "S01",
    "start": 6.254,
    "end": 8.681,
    "text": "contradiction-detection, and stress-testing"
  },
  {
    "beat": "S01",
    "start": 8.681,
    "end": 11.166,
    "text": "framework to evaluate the health and risk of"
  },
  {
    "beat": "S01",
    "start": 11.166,
    "end": 13.698,
    "text": "investment theses using market data."
  },
  {
    "beat": "S02",
    "start": 13.698,
    "end": 15.5,
    "text": "Earlier phases asked: will this"
  },
  {
    "beat": "S02",
    "start": 15.5,
    "end": 16.862,
    "text": "stock go up or down?"
  },
  {
    "beat": "S02",
    "start": 16.862,
    "end": 18.972,
    "text": "Phase 5 asks something else."
  },
  {
    "beat": "S02",
    "start": 18.972,
    "end": 20.664,
    "text": "Is the quantitative thesis still"
  },
  {
    "beat": "S02",
    "start": 20.664,
    "end": 22.673,
    "text": "healthy, what evidence contradicts it,"
  },
  {
    "beat": "S02",
    "start": 22.673,
    "end": 24.601,
    "text": "and does it survive stress?"
  },
  {
    "beat": "S03",
    "start": 24.601,
    "end": 27.155,
    "text": "The pipeline runs in seven stages."
  },
  {
    "beat": "S03",
    "start": 27.155,
    "end": 29.817,
    "text": "Market data becomes engineered features."
  },
  {
    "beat": "S03",
    "start": 29.817,
    "end": 32.308,
    "text": "Features become a thesis-health score."
  },
  {
    "beat": "S03",
    "start": 32.308,
    "end": 34.736,
    "text": "The score is watched for contradictions."
  },
  {
    "beat": "S03",
    "start": 34.736,
    "end": 36.65,
    "text": "Names are stress tested."
  },
  {
    "beat": "S03",
    "start": 36.65,
    "end": 38.404,
    "text": "Health and stress combine into a"
  },
  {
    "beat": "S03",
    "start": 38.404,
    "end": 40.322,
    "text": "resilience score, and that sets the"
  },
  {
    "beat": "S03",
    "start": 40.322,
    "end": 42.028,
    "text": "human review priority."
  },
  {
    "beat": "S04",
    "start": 42.028,
    "end": 44.243,
    "text": "The input is the same OHLCV panel as"
  },
  {
    "beat": "S04",
    "start": 44.243,
    "end": 46.151,
    "text": "earlier phases: one hundred and"
  },
  {
    "beat": "S04",
    "start": 46.151,
    "end": 48.489,
    "text": "eighty-four thousand rows, one hundred"
  },
  {
    "beat": "S04",
    "start": 48.489,
    "end": 50.535,
    "text": "and twenty tickers, six years."
  },
  {
    "beat": "S04",
    "start": 50.535,
    "end": 52.85,
    "text": "From it the notebook engineers returns,"
  },
  {
    "beat": "S04",
    "start": 52.85,
    "end": 55.402,
    "text": "moving-average distance, volatility, volume"
  },
  {
    "beat": "S04",
    "start": 55.402,
    "end": 57.835,
    "text": "behaviour, RSI, drawdown, and sector- and"
  },
  {
    "beat": "S04",
    "start": 57.835,
    "end": 59.997,
    "text": "market-relative performance."
  },
  {
    "beat": "S05",
    "start": 59.997,
    "end": 61.706,
    "text": "The thesis-health score runs"
  },
  {
    "beat": "S05",
    "start": 61.706,
    "end": 63.126,
    "text": "zero to one hundred."
  },
  {
    "beat": "S05",
    "start": 63.126,
    "end": 64.416,
    "text": "Seven factors are ranked"
  },
  {
    "beat": "S05",
    "start": 64.416,
    "end": 66.404,
    "text": "cross-sectionally on every date, so a"
  },
  {
    "beat": "S05",
    "start": 66.404,
    "end": 68.808,
    "text": "score means the same thing in any market."
  },
  {
    "beat": "S05",
    "start": 68.808,
    "end": 71.189,
    "text": "Twenty-day return carries the most weight,"
  },
  {
    "beat": "S05",
    "start": 71.189,
    "end": 73.569,
    "text": "then sector-relative return, distance from"
  },
  {
    "beat": "S05",
    "start": 73.569,
    "end": 76.063,
    "text": "the fifty-day average, drawdown, volatility,"
  },
  {
    "beat": "S05",
    "start": 76.063,
    "end": 77.868,
    "text": "RSI health, and volume."
  },
  {
    "beat": "S06",
    "start": 77.868,
    "end": 79.667,
    "text": "The score becomes a state."
  },
  {
    "beat": "S06",
    "start": 79.667,
    "end": 81.88,
    "text": "Below thirty-five is broken."
  },
  {
    "beat": "S06",
    "start": 81.88,
    "end": 84.286,
    "text": "Thirty-five to fifty is weakening."
  },
  {
    "beat": "S06",
    "start": 84.286,
    "end": 86.635,
    "text": "Fifty to sixty-five is stable."
  },
  {
    "beat": "S06",
    "start": 86.635,
    "end": 88.763,
    "text": "Above sixty-five is strong."
  },
  {
    "beat": "S06",
    "start": 88.763,
    "end": 90.441,
    "text": "Here is one name's health across"
  },
  {
    "beat": "S06",
    "start": 90.441,
    "end": 92.067,
    "text": "six years, crossing those lines"
  },
  {
    "beat": "S06",
    "start": 92.067,
    "end": 93.405,
    "text": "again and again."
  },
  {
    "beat": "S07",
    "start": 93.405,
    "end": 95.342,
    "text": "Level alone is not enough."
  },
  {
    "beat": "S07",
    "start": 95.342,
    "end": 97.376,
    "text": "The system also tracks the five-day and"
  },
  {
    "beat": "S07",
    "start": 97.376,
    "end": 99.566,
    "text": "twenty-day change in health, and whether a"
  },
  {
    "beat": "S07",
    "start": 99.566,
    "end": 101.705,
    "text": "name has dropped to a worse state than it"
  },
  {
    "beat": "S07",
    "start": 101.705,
    "end": 103.0,
    "text": "held twenty days ago."
  },
  {
    "beat": "S07",
    "start": 103.0,
    "end": 104.715,
    "text": "Direction of travel matters as"
  },
  {
    "beat": "S07",
    "start": 104.715,
    "end": 106.187,
    "text": "much as position."
  },
  {
    "beat": "S08",
    "start": 106.187,
    "end": 108.102,
    "text": "Contradiction detection is the"
  },
  {
    "beat": "S08",
    "start": 108.102,
    "end": 109.387,
    "text": "heart of Phase 5."
  },
  {
    "beat": "S08",
    "start": 109.387,
    "end": 110.974,
    "text": "A thesis should not only gather"
  },
  {
    "beat": "S08",
    "start": 110.974,
    "end": 112.356,
    "text": "support, it should hunt for"
  },
  {
    "beat": "S08",
    "start": 112.356,
    "end": 113.784,
    "text": "evidence against itself."
  },
  {
    "beat": "S08",
    "start": 113.784,
    "end": 115.628,
    "text": "A name is flagged when health falls"
  },
  {
    "beat": "S08",
    "start": 115.628,
    "end": 117.473,
    "text": "twenty points in twenty days, or it"
  },
  {
    "beat": "S08",
    "start": 117.473,
    "end": 119.581,
    "text": "weakens while trailing its sector, or it"
  },
  {
    "beat": "S08",
    "start": 119.581,
    "end": 121.689,
    "text": "sits well below its fifty-day average in"
  },
  {
    "beat": "S08",
    "start": 121.689,
    "end": 124.112,
    "text": "a deep drawdown. Every flag carries its"
  },
  {
    "beat": "S08",
    "start": 124.112,
    "end": 125.993,
    "text": "reasons in plain text."
  },
  {
    "beat": "S09",
    "start": 125.993,
    "end": 127.632,
    "text": "Then the stress test."
  },
  {
    "beat": "S09",
    "start": 127.632,
    "end": 129.695,
    "text": "For each name the notebook estimates a"
  },
  {
    "beat": "S09",
    "start": 129.695,
    "end": 131.975,
    "text": "beta to the equal-weighted dataset market,"
  },
  {
    "beat": "S09",
    "start": 131.975,
    "end": 134.092,
    "text": "separates the idiosyncratic part of its"
  },
  {
    "beat": "S09",
    "start": 134.092,
    "end": 136.154,
    "text": "returns, and bootstraps three thousand"
  },
  {
    "beat": "S09",
    "start": 136.154,
    "end": 138.326,
    "text": "twenty-day paths from real history, with"
  },
  {
    "beat": "S09",
    "start": 138.326,
    "end": 140.497,
    "text": "volatility multiplied by one point eight"
  },
  {
    "beat": "S09",
    "start": 140.497,
    "end": 143.711,
    "text": "and an eight percent market shock on the first day."
  },
  {
    "beat": "S10",
    "start": 143.711,
    "end": 145.405,
    "text": "That gives a loss distribution"
  },
  {
    "beat": "S10",
    "start": 145.405,
    "end": 146.791,
    "text": "and two tail numbers."
  },
  {
    "beat": "S10",
    "start": 146.791,
    "end": 149.054,
    "text": "Value at risk is the threshold the worst"
  },
  {
    "beat": "S10",
    "start": 149.054,
    "end": 151.177,
    "text": "five percent of paths fall beyond."
  },
  {
    "beat": "S10",
    "start": 151.177,
    "end": 153.668,
    "text": "Conditional value at risk is their average,"
  },
  {
    "beat": "S10",
    "start": 153.668,
    "end": 155.663,
    "text": "how bad it gets past that line."
  },
  {
    "beat": "S10",
    "start": 155.663,
    "end": 157.543,
    "text": "For Oracle: a forty-six percent"
  },
  {
    "beat": "S10",
    "start": 157.543,
    "end": 159.922,
    "text": "threshold, averaging fifty-two."
  },
  {
    "beat": "S11",
    "start": 159.922,
    "end": 162.049,
    "text": "Health and stress then combine."
  },
  {
    "beat": "S11",
    "start": 162.049,
    "end": 163.824,
    "text": "Fifty-five percent thesis health,"
  },
  {
    "beat": "S11",
    "start": 163.824,
    "end": 165.922,
    "text": "twenty percent the chance of avoiding a"
  },
  {
    "beat": "S11",
    "start": 165.922,
    "end": 167.805,
    "text": "loss, fifteen percent the chance of"
  },
  {
    "beat": "S11",
    "start": 167.805,
    "end": 169.849,
    "text": "avoiding a severe one, and ten percent"
  },
  {
    "beat": "S11",
    "start": 169.849,
    "end": 171.125,
    "text": "the volatility rank."
  },
  {
    "beat": "S11",
    "start": 171.125,
    "end": 173.358,
    "text": "The result bands into fragile, watch,"
  },
  {
    "beat": "S11",
    "start": 173.358,
    "end": 175.729,
    "text": "resilient, and high resilience."
  },
  {
    "beat": "S12",
    "start": 175.729,
    "end": 177.995,
    "text": "Everything lands in one ranked queue: three"
  },
  {
    "beat": "S12",
    "start": 177.995,
    "end": 180.209,
    "text": "points for a contradiction, two each for a"
  },
  {
    "beat": "S12",
    "start": 180.209,
    "end": 182.422,
    "text": "weak band, a sharp health drop, and a high"
  },
  {
    "beat": "S12",
    "start": 182.422,
    "end": 183.782,
    "text": "chance of severe loss."
  },
  {
    "beat": "S12",
    "start": 183.782,
    "end": 185.649,
    "text": "On the latest day, seventeen names"
  },
  {
    "beat": "S12",
    "start": 185.649,
    "end": 187.962,
    "text": "reached the top priority of nine."
  },
  {
    "beat": "S13",
    "start": 187.962,
    "end": 189.534,
    "text": "And an honest measurement."
  },
  {
    "beat": "S13",
    "start": 189.534,
    "end": 191.678,
    "text": "Across the whole history, flagged rows"
  },
  {
    "beat": "S13",
    "start": 191.678,
    "end": 193.652,
    "text": "saw large five-day moves twenty-two"
  },
  {
    "beat": "S13",
    "start": 193.652,
    "end": 195.739,
    "text": "percent of the time, against nineteen"
  },
  {
    "beat": "S13",
    "start": 195.739,
    "end": 197.462,
    "text": "percent for unflagged rows."
  },
  {
    "beat": "S13",
    "start": 197.462,
    "end": 199.062,
    "text": "A real difference, but a small"
  },
  {
    "beat": "S13",
    "start": 199.062,
    "end": 200.874,
    "text": "one, and the flag fires on about a"
  },
  {
    "beat": "S13",
    "start": 200.874,
    "end": 202.034,
    "text": "third of all rows."
  },
  {
    "beat": "S13",
    "start": 202.034,
    "end": 204.9,
    "text": "This is a diagnostic, not a forecast."
  },
  {
    "beat": "S14",
    "start": 204.9,
    "end": 208.151,
    "text": "Phase three built multi-agent market intelligence."
  },
  {
    "beat": "S14",
    "start": 208.151,
    "end": 210.366,
    "text": "Phase four made it regime-aware."
  },
  {
    "beat": "S14",
    "start": 210.366,
    "end": 212.074,
    "text": "Phase five moves past predicting"
  },
  {
    "beat": "S14",
    "start": 212.074,
    "end": 214.262,
    "text": "direction: it asks whether a thesis still"
  },
  {
    "beat": "S14",
    "start": 214.262,
    "end": 216.236,
    "text": "holds, finds the evidence against it,"
  },
  {
    "beat": "S14",
    "start": 216.236,
    "end": 218.318,
    "text": "tests it under stress, and ranks what a"
  },
  {
    "beat": "S14",
    "start": 218.318,
    "end": 219.852,
    "text": "human should check first."
  },
  {
    "beat": "S14",
    "start": 219.852,
    "end": 223.124,
    "text": "Research decision support, not financial advice."
  },
  {
    "beat": "S14",
    "start": 223.124,
    "end": 224.571,
    "text": "Thank you for watching."
  },
  {
    "beat": "S14",
    "start": 224.571,
    "end": 226.461,
    "text": "This was Mycroft Phase 5."
  }
]