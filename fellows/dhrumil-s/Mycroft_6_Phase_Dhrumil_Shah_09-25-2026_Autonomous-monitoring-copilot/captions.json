[
  {
    "beat": "S01",
    "start": 0.1,
    "end": 2.373,
    "text": "Hi, I am Dhrumil Shah, and this video is"
  },
  {
    "beat": "S01",
    "start": 2.373,
    "end": 4.59,
    "text": "about Mycroft Phase 6, where I built an"
  },
  {
    "beat": "S01",
    "start": 4.59,
    "end": 6.465,
    "text": "explainable autonomous monitoring"
  },
  {
    "beat": "S01",
    "start": 6.465,
    "end": 8.625,
    "text": "copilot that runs five research agents"
  },
  {
    "beat": "S01",
    "start": 8.625,
    "end": 10.784,
    "text": "over the market every day, scores what"
  },
  {
    "beat": "S01",
    "start": 10.784,
    "end": 14.126,
    "text": "deserves a human look, and writes down exactly why."
  },
  {
    "beat": "S02",
    "start": 14.126,
    "end": 15.662,
    "text": "Here is the problem."
  },
  {
    "beat": "S02",
    "start": 15.662,
    "end": 17.591,
    "text": "One analyst cannot watch a hundred"
  },
  {
    "beat": "S02",
    "start": 17.591,
    "end": 19.323,
    "text": "and twenty names every day."
  },
  {
    "beat": "S02",
    "start": 19.323,
    "end": 21.258,
    "text": "Automate it and you get the opposite"
  },
  {
    "beat": "S02",
    "start": 21.258,
    "end": 23.246,
    "text": "problem: a black box that says review"
  },
  {
    "beat": "S02",
    "start": 23.246,
    "end": 25.058,
    "text": "this, with no reason attached."
  },
  {
    "beat": "S02",
    "start": 25.058,
    "end": 27.065,
    "text": "Neither one is usable."
  },
  {
    "beat": "S03",
    "start": 27.065,
    "end": 29.373,
    "text": "Phase 6 is the integration phase."
  },
  {
    "beat": "S03",
    "start": 29.373,
    "end": 30.885,
    "text": "Earlier phases each built"
  },
  {
    "beat": "S03",
    "start": 30.885,
    "end": 32.235,
    "text": "one kind of signal."
  },
  {
    "beat": "S03",
    "start": 32.235,
    "end": 34.154,
    "text": "Phase 6 runs five of them together,"
  },
  {
    "beat": "S03",
    "start": 34.154,
    "end": 36.019,
    "text": "combines them with weights you can"
  },
  {
    "beat": "S03",
    "start": 36.019,
    "end": 38.103,
    "text": "read, and attaches a written reason to"
  },
  {
    "beat": "S03",
    "start": 38.103,
    "end": 39.345,
    "text": "every single alert."
  },
  {
    "beat": "S03",
    "start": 39.345,
    "end": 41.613,
    "text": "Nothing is a black box."
  },
  {
    "beat": "S04",
    "start": 41.613,
    "end": 43.168,
    "text": "The shape is simple."
  },
  {
    "beat": "S04",
    "start": 43.168,
    "end": 46.606,
    "text": "The same market panel feeds five independent agents."
  },
  {
    "beat": "S04",
    "start": 46.606,
    "end": 48.654,
    "text": "Each raises its own flag."
  },
  {
    "beat": "S04",
    "start": 48.654,
    "end": 51.244,
    "text": "A transparent score adds those flags up."
  },
  {
    "beat": "S04",
    "start": 51.244,
    "end": 53.387,
    "text": "That produces a ranked review queue, an"
  },
  {
    "beat": "S04",
    "start": 53.387,
    "end": 55.255,
    "text": "auditable event log, and two empty"
  },
  {
    "beat": "S04",
    "start": 55.255,
    "end": 57.238,
    "text": "fields waiting for a human."
  },
  {
    "beat": "S05",
    "start": 57.238,
    "end": 59.686,
    "text": "Agent A watches for abnormal days."
  },
  {
    "beat": "S05",
    "start": 59.686,
    "end": 62.149,
    "text": "It computes a rolling modified z-score on"
  },
  {
    "beat": "S05",
    "start": 62.149,
    "end": 64.793,
    "text": "returns, volume and intraday range, built on"
  },
  {
    "beat": "S05",
    "start": 64.793,
    "end": 67.196,
    "text": "medians rather than means, so a few wild"
  },
  {
    "beat": "S05",
    "start": 67.196,
    "end": 68.958,
    "text": "days cannot hide the rest."
  },
  {
    "beat": "S05",
    "start": 68.958,
    "end": 69.971,
    "text": "Anything past four"
  },
  {
    "beat": "S05",
    "start": 69.971,
    "end": 72.273,
    "text": "standard-equivalents is flagged."
  },
  {
    "beat": "S06",
    "start": 72.273,
    "end": 74.481,
    "text": "Agent B ranks each name inside its own"
  },
  {
    "beat": "S06",
    "start": 74.481,
    "end": 76.747,
    "text": "industry, weighting weak momentum, high"
  },
  {
    "beat": "S06",
    "start": 76.747,
    "end": 78.78,
    "text": "volatility and deep drawdown into a"
  },
  {
    "beat": "S06",
    "start": 78.78,
    "end": 80.607,
    "text": "single peer-weakness number."
  },
  {
    "beat": "S06",
    "start": 80.607,
    "end": 82.777,
    "text": "Agent C scores risk across the whole"
  },
  {
    "beat": "S06",
    "start": 82.777,
    "end": 84.363,
    "text": "market on the same day."
  },
  {
    "beat": "S06",
    "start": 84.363,
    "end": 86.911,
    "text": "Both fire in the worst twenty percent."
  },
  {
    "beat": "S07",
    "start": 86.911,
    "end": 89.091,
    "text": "Agent D carries the thesis-health"
  },
  {
    "beat": "S07",
    "start": 89.091,
    "end": 91.008,
    "text": "idea forward from Phase 5."
  },
  {
    "beat": "S07",
    "start": 91.008,
    "end": 93.083,
    "text": "Five ranked components make a zero to"
  },
  {
    "beat": "S07",
    "start": 93.083,
    "end": 95.213,
    "text": "one hundred score, and the agent fires"
  },
  {
    "beat": "S07",
    "start": 95.213,
    "end": 98.217,
    "text": "when that score falls twenty points in twenty days."
  },
  {
    "beat": "S07",
    "start": 98.217,
    "end": 99.71,
    "text": "It is watching the change,"
  },
  {
    "beat": "S07",
    "start": 99.71,
    "end": 101.014,
    "text": "not the level."
  },
  {
    "beat": "S08",
    "start": 101.014,
    "end": 102.219,
    "text": "Agent E is the only"
  },
  {
    "beat": "S08",
    "start": 102.219,
    "end": 104.195,
    "text": "machine-learning model here."
  },
  {
    "beat": "S08",
    "start": 104.195,
    "end": 106.144,
    "text": "An isolation forest, two hundred and"
  },
  {
    "beat": "S08",
    "start": 106.144,
    "end": 108.2,
    "text": "fifty trees, fit on the training dates"
  },
  {
    "beat": "S08",
    "start": 108.2,
    "end": 110.203,
    "text": "only, looks at eight features at once"
  },
  {
    "beat": "S08",
    "start": 110.203,
    "end": 112.098,
    "text": "and finds the rows that do not look"
  },
  {
    "beat": "S08",
    "start": 112.098,
    "end": 113.326,
    "text": "like anything else."
  },
  {
    "beat": "S08",
    "start": 113.326,
    "end": 114.957,
    "text": "It catches combinations the"
  },
  {
    "beat": "S08",
    "start": 114.957,
    "end": 117.089,
    "text": "single-variable rules miss."
  },
  {
    "beat": "S09",
    "start": 117.089,
    "end": 119.251,
    "text": "Now the part that makes it auditable."
  },
  {
    "beat": "S09",
    "start": 119.251,
    "end": 121.482,
    "text": "The priority is a plain sum."
  },
  {
    "beat": "S09",
    "start": 121.482,
    "end": 123.84,
    "text": "Two points for a robust anomaly, one for"
  },
  {
    "beat": "S09",
    "start": 123.84,
    "end": 126.02,
    "text": "peer weakness, two for high risk, two"
  },
  {
    "beat": "S09",
    "start": 126.02,
    "end": 129.521,
    "text": "for thesis deterioration, two for a multivariate outlier."
  },
  {
    "beat": "S09",
    "start": 129.521,
    "end": 131.843,
    "text": "No learned weights, no hidden model."
  },
  {
    "beat": "S09",
    "start": 131.843,
    "end": 133.877,
    "text": "Nine is the maximum."
  },
  {
    "beat": "S10",
    "start": 133.877,
    "end": 135.77,
    "text": "And every flag writes its own reason,"
  },
  {
    "beat": "S10",
    "start": 135.77,
    "end": 137.556,
    "text": "with the number that caused it."
  },
  {
    "beat": "S10",
    "start": 137.556,
    "end": 139.786,
    "text": "So the queue does not say review this."
  },
  {
    "beat": "S10",
    "start": 139.786,
    "end": 142.256,
    "text": "It says robust anomaly, z of seven point"
  },
  {
    "beat": "S10",
    "start": 142.256,
    "end": 144.664,
    "text": "five, risk score point nine two, thesis"
  },
  {
    "beat": "S10",
    "start": 144.664,
    "end": 146.708,
    "text": "down seventy-four points."
  },
  {
    "beat": "S11",
    "start": 146.708,
    "end": 149.145,
    "text": "That produces a daily monitoring summary."
  },
  {
    "beat": "S11",
    "start": 149.145,
    "end": 151.223,
    "text": "On the eleventh of February, one hundred"
  },
  {
    "beat": "S11",
    "start": 151.223,
    "end": 153.249,
    "text": "and twenty names monitored, forty-three"
  },
  {
    "beat": "S11",
    "start": 153.249,
    "end": 155.171,
    "text": "flagged for review, and only three at"
  },
  {
    "beat": "S11",
    "start": 155.171,
    "end": 156.566,
    "text": "priority five or above."
  },
  {
    "beat": "S11",
    "start": 156.566,
    "end": 158.669,
    "text": "Twenty-nine thesis deteriorations,"
  },
  {
    "beat": "S11",
    "start": 158.669,
    "end": 160.587,
    "text": "fifteen high-risk names, eleven"
  },
  {
    "beat": "S11",
    "start": 160.587,
    "end": 163.438,
    "text": "anomalies, four multivariate outliers."
  },
  {
    "beat": "S12",
    "start": 163.438,
    "end": 165.194,
    "text": "The queue itself is short."
  },
  {
    "beat": "S12",
    "start": 165.194,
    "end": 167.098,
    "text": "S and P Global leads at priority"
  },
  {
    "beat": "S12",
    "start": 167.098,
    "end": 168.942,
    "text": "eight, then Schwab at six, then"
  },
  {
    "beat": "S12",
    "start": 168.942,
    "end": 170.391,
    "text": "UnitedHealth at five."
  },
  {
    "beat": "S12",
    "start": 170.391,
    "end": 172.914,
    "text": "Every row is also written to a JSON event"
  },
  {
    "beat": "S12",
    "start": 172.914,
    "end": 175.498,
    "text": "log, with the agent outputs and two fields"
  },
  {
    "beat": "S12",
    "start": 175.498,
    "end": 177.959,
    "text": "left deliberately empty: human decision,"
  },
  {
    "beat": "S12",
    "start": 177.959,
    "end": 179.689,
    "text": "and human rationale."
  },
  {
    "beat": "S13",
    "start": 179.689,
    "end": 181.147,
    "text": "So does the priority score"
  },
  {
    "beat": "S13",
    "start": 181.147,
    "end": 182.637,
    "text": "actually mean anything?"
  },
  {
    "beat": "S13",
    "start": 182.637,
    "end": 184.707,
    "text": "Measured over six years: at priority"
  },
  {
    "beat": "S13",
    "start": 184.707,
    "end": 186.605,
    "text": "zero, large five-day moves happen"
  },
  {
    "beat": "S13",
    "start": 186.605,
    "end": 188.473,
    "text": "eighteen percent of the time."
  },
  {
    "beat": "S13",
    "start": 188.473,
    "end": 190.293,
    "text": "At four, thirty-four."
  },
  {
    "beat": "S13",
    "start": 190.293,
    "end": 192.014,
    "text": "At six, thirty-nine."
  },
  {
    "beat": "S13",
    "start": 192.014,
    "end": 193.601,
    "text": "At eight, forty-one."
  },
  {
    "beat": "S13",
    "start": 193.601,
    "end": 195.215,
    "text": "The trend is real."
  },
  {
    "beat": "S13",
    "start": 195.215,
    "end": 197.485,
    "text": "But it is noisy, it dips at three, five and"
  },
  {
    "beat": "S13",
    "start": 197.485,
    "end": 199.585,
    "text": "seven, and the high scores are rare."
  },
  {
    "beat": "S13",
    "start": 199.585,
    "end": 200.835,
    "text": "This is a historical"
  },
  {
    "beat": "S13",
    "start": 200.835,
    "end": 203.022,
    "text": "diagnostic, not a forecast."
  },
  {
    "beat": "S14",
    "start": 203.022,
    "end": 204.585,
    "text": "So, Phase 6."
  },
  {
    "beat": "S14",
    "start": 204.585,
    "end": 206.301,
    "text": "Five agents integrated into"
  },
  {
    "beat": "S14",
    "start": 206.301,
    "end": 207.772,
    "text": "one monitoring pass."
  },
  {
    "beat": "S14",
    "start": 207.772,
    "end": 209.831,
    "text": "A transparent priority score."
  },
  {
    "beat": "S14",
    "start": 209.831,
    "end": 212.076,
    "text": "A written reason on every alert."
  },
  {
    "beat": "S14",
    "start": 212.076,
    "end": 214.365,
    "text": "An auditable JSON event log."
  },
  {
    "beat": "S14",
    "start": 214.365,
    "end": 216.42,
    "text": "And a human decision field that the"
  },
  {
    "beat": "S14",
    "start": 216.42,
    "end": 217.912,
    "text": "system never fills in."
  },
  {
    "beat": "S14",
    "start": 217.912,
    "end": 219.917,
    "text": "Next comes scheduling it to run daily,"
  },
  {
    "beat": "S14",
    "start": 219.917,
    "end": 222.079,
    "text": "calibrating the weights against outcomes,"
  },
  {
    "beat": "S14",
    "start": 222.079,
    "end": 223.598,
    "text": "and a reviewer interface."
  },
  {
    "beat": "S14",
    "start": 223.598,
    "end": 225.744,
    "text": "Mycroft Project, Phase 6."
  },
  {
    "beat": "S14",
    "start": 225.744,
    "end": 227.686,
    "text": "Developed by Dhrumil Shah."
  },
  {
    "beat": "S14",
    "start": 227.686,
    "end": 228.933,
    "text": "Thank you for watching."
  }
]