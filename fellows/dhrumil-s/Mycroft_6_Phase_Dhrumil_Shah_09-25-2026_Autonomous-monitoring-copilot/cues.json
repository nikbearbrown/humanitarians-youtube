[
  {
    "beat": "S01",
    "start": 0.1,
    "end": 1.869,
    "text": "Hi, I am Dhrumil Shah, and this"
  },
  {
    "beat": "S01",
    "start": 1.869,
    "end": 3.639,
    "text": "video is about Mycroft Phase 6,"
  },
  {
    "beat": "S01",
    "start": 3.639,
    "end": 5.237,
    "text": "where I built an explainable"
  },
  {
    "beat": "S01",
    "start": 5.237,
    "end": 7.177,
    "text": "autonomous monitoring copilot that"
  },
  {
    "beat": "S01",
    "start": 7.177,
    "end": 9.118,
    "text": "runs five research agents over the"
  },
  {
    "beat": "S01",
    "start": 9.118,
    "end": 10.773,
    "text": "market every day, scores what"
  },
  {
    "beat": "S01",
    "start": 10.773,
    "end": 12.656,
    "text": "deserves a human look, and writes"
  },
  {
    "beat": "S01",
    "start": 12.656,
    "end": 13.626,
    "text": "down exactly why."
  },
  {
    "beat": "S02",
    "start": 14.126,
    "end": 15.462,
    "text": "Here is the problem."
  },
  {
    "beat": "S02",
    "start": 15.662,
    "end": 17.591,
    "text": "One analyst cannot watch a hundred"
  },
  {
    "beat": "S02",
    "start": 17.591,
    "end": 19.123,
    "text": "and twenty names every day."
  },
  {
    "beat": "S02",
    "start": 19.323,
    "end": 20.788,
    "text": "Automate it and you get the"
  },
  {
    "beat": "S02",
    "start": 20.788,
    "end": 22.633,
    "text": "opposite problem: a black box that"
  },
  {
    "beat": "S02",
    "start": 22.633,
    "end": 24.369,
    "text": "says review this, with no reason"
  },
  {
    "beat": "S02",
    "start": 24.369,
    "end": 24.858,
    "text": "attached."
  },
  {
    "beat": "S02",
    "start": 25.058,
    "end": 26.565,
    "text": "Neither one is usable."
  },
  {
    "beat": "S03",
    "start": 27.065,
    "end": 29.173,
    "text": "Phase 6 is the integration phase."
  },
  {
    "beat": "S03",
    "start": 29.373,
    "end": 31.43,
    "text": "Earlier phases each built one kind"
  },
  {
    "beat": "S03",
    "start": 31.43,
    "end": 32.035,
    "text": "of signal."
  },
  {
    "beat": "S03",
    "start": 32.235,
    "end": 33.617,
    "text": "Phase 6 runs five of them"
  },
  {
    "beat": "S03",
    "start": 33.617,
    "end": 35.165,
    "text": "together, combines them with"
  },
  {
    "beat": "S03",
    "start": 35.165,
    "end": 37.044,
    "text": "weights you can read, and attaches"
  },
  {
    "beat": "S03",
    "start": 37.044,
    "end": 38.813,
    "text": "a written reason to every single"
  },
  {
    "beat": "S03",
    "start": 38.813,
    "end": 39.145,
    "text": "alert."
  },
  {
    "beat": "S03",
    "start": 39.345,
    "end": 41.113,
    "text": "Nothing is a black box."
  },
  {
    "beat": "S04",
    "start": 41.613,
    "end": 42.968,
    "text": "The shape is simple."
  },
  {
    "beat": "S04",
    "start": 43.168,
    "end": 45.2,
    "text": "The same market panel feeds five"
  },
  {
    "beat": "S04",
    "start": 45.2,
    "end": 46.406,
    "text": "independent agents."
  },
  {
    "beat": "S04",
    "start": 46.606,
    "end": 48.454,
    "text": "Each raises its own flag."
  },
  {
    "beat": "S04",
    "start": 48.654,
    "end": 50.493,
    "text": "A transparent score adds those"
  },
  {
    "beat": "S04",
    "start": 50.493,
    "end": 51.044,
    "text": "flags up."
  },
  {
    "beat": "S04",
    "start": 51.244,
    "end": 52.854,
    "text": "That produces a ranked review"
  },
  {
    "beat": "S04",
    "start": 52.854,
    "end": 54.741,
    "text": "queue, an auditable event log, and"
  },
  {
    "beat": "S04",
    "start": 54.741,
    "end": 56.405,
    "text": "two empty fields waiting for a"
  },
  {
    "beat": "S04",
    "start": 56.405,
    "end": 56.738,
    "text": "human."
  },
  {
    "beat": "S05",
    "start": 57.238,
    "end": 59.486,
    "text": "Agent A watches for abnormal days."
  },
  {
    "beat": "S05",
    "start": 59.686,
    "end": 61.5,
    "text": "It computes a rolling modified"
  },
  {
    "beat": "S05",
    "start": 61.5,
    "end": 63.315,
    "text": "z-score on returns, volume and"
  },
  {
    "beat": "S05",
    "start": 63.315,
    "end": 65.25,
    "text": "intraday range, built on medians"
  },
  {
    "beat": "S05",
    "start": 65.25,
    "end": 67.186,
    "text": "rather than means, so a few wild"
  },
  {
    "beat": "S05",
    "start": 67.186,
    "end": 68.758,
    "text": "days cannot hide the rest."
  },
  {
    "beat": "S05",
    "start": 68.958,
    "end": 69.971,
    "text": "Anything past four"
  },
  {
    "beat": "S05",
    "start": 69.971,
    "end": 71.773,
    "text": "standard-equivalents is flagged."
  },
  {
    "beat": "S06",
    "start": 72.273,
    "end": 74.263,
    "text": "Agent B ranks each name inside its"
  },
  {
    "beat": "S06",
    "start": 74.263,
    "end": 75.901,
    "text": "own industry, weighting weak"
  },
  {
    "beat": "S06",
    "start": 75.901,
    "end": 77.891,
    "text": "momentum, high volatility and deep"
  },
  {
    "beat": "S06",
    "start": 77.891,
    "end": 79.178,
    "text": "drawdown into a single"
  },
  {
    "beat": "S06",
    "start": 79.178,
    "end": 80.407,
    "text": "peer-weakness number."
  },
  {
    "beat": "S06",
    "start": 80.607,
    "end": 82.415,
    "text": "Agent C scores risk across the"
  },
  {
    "beat": "S06",
    "start": 82.415,
    "end": 84.163,
    "text": "whole market on the same day."
  },
  {
    "beat": "S06",
    "start": 84.363,
    "end": 85.969,
    "text": "Both fire in the worst twenty"
  },
  {
    "beat": "S06",
    "start": 85.969,
    "end": 86.412,
    "text": "percent."
  },
  {
    "beat": "S07",
    "start": 86.911,
    "end": 89.091,
    "text": "Agent D carries the thesis-health"
  },
  {
    "beat": "S07",
    "start": 89.091,
    "end": 90.808,
    "text": "idea forward from Phase 5."
  },
  {
    "beat": "S07",
    "start": 91.008,
    "end": 92.914,
    "text": "Five ranked components make a zero"
  },
  {
    "beat": "S07",
    "start": 92.914,
    "end": 94.541,
    "text": "to one hundred score, and the"
  },
  {
    "beat": "S07",
    "start": 94.541,
    "end": 96.391,
    "text": "agent fires when that score falls"
  },
  {
    "beat": "S07",
    "start": 96.391,
    "end": 98.017,
    "text": "twenty points in twenty days."
  },
  {
    "beat": "S07",
    "start": 98.217,
    "end": 100.169,
    "text": "It is watching the change, not the"
  },
  {
    "beat": "S07",
    "start": 100.169,
    "end": 100.514,
    "text": "level."
  },
  {
    "beat": "S08",
    "start": 101.014,
    "end": 102.219,
    "text": "Agent E is the only"
  },
  {
    "beat": "S08",
    "start": 102.219,
    "end": 103.995,
    "text": "machine-learning model here."
  },
  {
    "beat": "S08",
    "start": 104.195,
    "end": 105.938,
    "text": "An isolation forest, two hundred"
  },
  {
    "beat": "S08",
    "start": 105.938,
    "end": 107.408,
    "text": "and fifty trees, fit on the"
  },
  {
    "beat": "S08",
    "start": 107.408,
    "end": 108.987,
    "text": "training dates only, looks at"
  },
  {
    "beat": "S08",
    "start": 108.987,
    "end": 110.73,
    "text": "eight features at once and finds"
  },
  {
    "beat": "S08",
    "start": 110.73,
    "end": 112.364,
    "text": "the rows that do not look like"
  },
  {
    "beat": "S08",
    "start": 112.364,
    "end": 113.126,
    "text": "anything else."
  },
  {
    "beat": "S08",
    "start": 113.326,
    "end": 114.957,
    "text": "It catches combinations the"
  },
  {
    "beat": "S08",
    "start": 114.957,
    "end": 116.589,
    "text": "single-variable rules miss."
  },
  {
    "beat": "S09",
    "start": 117.089,
    "end": 118.506,
    "text": "Now the part that makes it"
  },
  {
    "beat": "S09",
    "start": 118.506,
    "end": 119.051,
    "text": "auditable."
  },
  {
    "beat": "S09",
    "start": 119.251,
    "end": 121.282,
    "text": "The priority is a plain sum."
  },
  {
    "beat": "S09",
    "start": 121.482,
    "end": 123.383,
    "text": "Two points for a robust anomaly,"
  },
  {
    "beat": "S09",
    "start": 123.383,
    "end": 125.164,
    "text": "one for peer weakness, two for"
  },
  {
    "beat": "S09",
    "start": 125.164,
    "end": 126.649,
    "text": "high risk, two for thesis"
  },
  {
    "beat": "S09",
    "start": 126.649,
    "end": 128.074,
    "text": "deterioration, two for a"
  },
  {
    "beat": "S09",
    "start": 128.074,
    "end": 129.321,
    "text": "multivariate outlier."
  },
  {
    "beat": "S09",
    "start": 129.521,
    "end": 131.28,
    "text": "No learned weights, no hidden"
  },
  {
    "beat": "S09",
    "start": 131.28,
    "end": 131.643,
    "text": "model."
  },
  {
    "beat": "S09",
    "start": 131.843,
    "end": 133.377,
    "text": "Nine is the maximum."
  },
  {
    "beat": "S10",
    "start": 133.877,
    "end": 135.383,
    "text": "And every flag writes its own"
  },
  {
    "beat": "S10",
    "start": 135.383,
    "end": 136.837,
    "text": "reason, with the number that"
  },
  {
    "beat": "S10",
    "start": 136.837,
    "end": 137.356,
    "text": "caused it."
  },
  {
    "beat": "S10",
    "start": 137.556,
    "end": 139.311,
    "text": "So the queue does not say review"
  },
  {
    "beat": "S10",
    "start": 139.311,
    "end": 139.586,
    "text": "this."
  },
  {
    "beat": "S10",
    "start": 139.786,
    "end": 141.906,
    "text": "It says robust anomaly, z of seven"
  },
  {
    "beat": "S10",
    "start": 141.906,
    "end": 143.963,
    "text": "point five, risk score point nine"
  },
  {
    "beat": "S10",
    "start": 143.963,
    "end": 145.772,
    "text": "two, thesis down seventy-four"
  },
  {
    "beat": "S10",
    "start": 145.772,
    "end": 146.208,
    "text": "points."
  },
  {
    "beat": "S11",
    "start": 146.708,
    "end": 148.497,
    "text": "That produces a daily monitoring"
  },
  {
    "beat": "S11",
    "start": 148.497,
    "end": 148.945,
    "text": "summary."
  },
  {
    "beat": "S11",
    "start": 149.145,
    "end": 150.819,
    "text": "On the eleventh of February, one"
  },
  {
    "beat": "S11",
    "start": 150.819,
    "end": 152.075,
    "text": "hundred and twenty names"
  },
  {
    "beat": "S11",
    "start": 152.075,
    "end": 153.855,
    "text": "monitored, forty-three flagged for"
  },
  {
    "beat": "S11",
    "start": 153.855,
    "end": 155.634,
    "text": "review, and only three at priority"
  },
  {
    "beat": "S11",
    "start": 155.634,
    "end": 156.366,
    "text": "five or above."
  },
  {
    "beat": "S11",
    "start": 156.566,
    "end": 158.69,
    "text": "Twenty-nine thesis deteriorations,"
  },
  {
    "beat": "S11",
    "start": 158.69,
    "end": 160.627,
    "text": "fifteen high-risk names, eleven"
  },
  {
    "beat": "S11",
    "start": 160.627,
    "end": 162.376,
    "text": "anomalies, four multivariate"
  },
  {
    "beat": "S11",
    "start": 162.376,
    "end": 162.938,
    "text": "outliers."
  },
  {
    "beat": "S12",
    "start": 163.438,
    "end": 164.994,
    "text": "The queue itself is short."
  },
  {
    "beat": "S12",
    "start": 165.194,
    "end": 167.097,
    "text": "S and P Global leads at priority"
  },
  {
    "beat": "S12",
    "start": 167.097,
    "end": 168.942,
    "text": "eight, then Schwab at six, then"
  },
  {
    "beat": "S12",
    "start": 168.942,
    "end": 170.191,
    "text": "UnitedHealth at five."
  },
  {
    "beat": "S12",
    "start": 170.391,
    "end": 172.25,
    "text": "Every row is also written to a"
  },
  {
    "beat": "S12",
    "start": 172.25,
    "end": 174.108,
    "text": "JSON event log, with the agent"
  },
  {
    "beat": "S12",
    "start": 174.108,
    "end": 175.781,
    "text": "outputs and two fields left"
  },
  {
    "beat": "S12",
    "start": 175.781,
    "end": 177.33,
    "text": "deliberately empty: human"
  },
  {
    "beat": "S12",
    "start": 177.33,
    "end": 179.189,
    "text": "decision, and human rationale."
  },
  {
    "beat": "S13",
    "start": 179.689,
    "end": 181.147,
    "text": "So does the priority score"
  },
  {
    "beat": "S13",
    "start": 181.147,
    "end": 182.437,
    "text": "actually mean anything?"
  },
  {
    "beat": "S13",
    "start": 182.637,
    "end": 184.206,
    "text": "Measured over six years: at"
  },
  {
    "beat": "S13",
    "start": 184.206,
    "end": 185.891,
    "text": "priority zero, large five-day"
  },
  {
    "beat": "S13",
    "start": 185.891,
    "end": 187.75,
    "text": "moves happen eighteen percent of"
  },
  {
    "beat": "S13",
    "start": 187.75,
    "end": 188.273,
    "text": "the time."
  },
  {
    "beat": "S13",
    "start": 188.473,
    "end": 190.093,
    "text": "At four, thirty-four."
  },
  {
    "beat": "S13",
    "start": 190.293,
    "end": 191.814,
    "text": "At six, thirty-nine."
  },
  {
    "beat": "S13",
    "start": 192.014,
    "end": 193.401,
    "text": "At eight, forty-one."
  },
  {
    "beat": "S13",
    "start": 193.601,
    "end": 195.015,
    "text": "The trend is real."
  },
  {
    "beat": "S13",
    "start": 195.215,
    "end": 197.032,
    "text": "But it is noisy, it dips at three,"
  },
  {
    "beat": "S13",
    "start": 197.032,
    "end": 198.529,
    "text": "five and seven, and the high"
  },
  {
    "beat": "S13",
    "start": 198.529,
    "end": 199.385,
    "text": "scores are rare."
  },
  {
    "beat": "S13",
    "start": 199.585,
    "end": 201.585,
    "text": "This is a historical diagnostic,"
  },
  {
    "beat": "S13",
    "start": 201.585,
    "end": 202.522,
    "text": "not a forecast."
  },
  {
    "beat": "S14",
    "start": 203.022,
    "end": 204.385,
    "text": "So, Phase 6."
  },
  {
    "beat": "S14",
    "start": 204.585,
    "end": 206.556,
    "text": "Five agents integrated into one"
  },
  {
    "beat": "S14",
    "start": 206.556,
    "end": 207.572,
    "text": "monitoring pass."
  },
  {
    "beat": "S14",
    "start": 207.772,
    "end": 209.631,
    "text": "A transparent priority score."
  },
  {
    "beat": "S14",
    "start": 209.831,
    "end": 211.876,
    "text": "A written reason on every alert."
  },
  {
    "beat": "S14",
    "start": 212.076,
    "end": 214.165,
    "text": "An auditable JSON event log."
  },
  {
    "beat": "S14",
    "start": 214.365,
    "end": 216.185,
    "text": "And a human decision field that"
  },
  {
    "beat": "S14",
    "start": 216.185,
    "end": 217.712,
    "text": "the system never fills in."
  },
  {
    "beat": "S14",
    "start": 217.912,
    "end": 219.563,
    "text": "Next comes scheduling it to run"
  },
  {
    "beat": "S14",
    "start": 219.563,
    "end": 221.161,
    "text": "daily, calibrating the weights"
  },
  {
    "beat": "S14",
    "start": 221.161,
    "end": 222.865,
    "text": "against outcomes, and a reviewer"
  },
  {
    "beat": "S14",
    "start": 222.865,
    "end": 223.398,
    "text": "interface."
  },
  {
    "beat": "S14",
    "start": 223.598,
    "end": 225.544,
    "text": "Mycroft Project, Phase 6."
  },
  {
    "beat": "S14",
    "start": 225.744,
    "end": 227.486,
    "text": "Developed by Dhrumil Shah."
  },
  {
    "beat": "S14",
    "start": 227.686,
    "end": 228.933,
    "text": "Thank you for watching."
  }
]