[
  {
    "beat": "S01",
    "start": 0.1,
    "end": 2.386,
    "text": "Hi, I am Dhrumil Shah, and this video is"
  },
  {
    "beat": "S01",
    "start": 2.386,
    "end": 4.616,
    "text": "about why giving an AI agent more tools"
  },
  {
    "beat": "S01",
    "start": 4.616,
    "end": 6.845,
    "text": "can actually make it worse \u2014 and how we"
  },
  {
    "beat": "S01",
    "start": 6.845,
    "end": 8.903,
    "text": "can build a smarter progressive tool"
  },
  {
    "beat": "S01",
    "start": 8.903,
    "end": 10.489,
    "text": "router with Claude."
  },
  {
    "beat": "S02",
    "start": 10.489,
    "end": 12.404,
    "text": "If an AI agent has access to a"
  },
  {
    "beat": "S02",
    "start": 12.404,
    "end": 14.637,
    "text": "thousand tools, does it really need"
  },
  {
    "beat": "S02",
    "start": 14.637,
    "end": 16.871,
    "text": "all thousand in its context just to"
  },
  {
    "beat": "S02",
    "start": 16.871,
    "end": 18.711,
    "text": "analyze one CSV file?"
  },
  {
    "beat": "S03",
    "start": 18.711,
    "end": 21.327,
    "text": "Every tool costs context before the work even"
  },
  {
    "beat": "S03",
    "start": 21.327,
    "end": 23.652,
    "text": "starts \u2014 a name, a description, an input"
  },
  {
    "beat": "S03",
    "start": 23.652,
    "end": 26.013,
    "text": "schema, parameters, permissions."
  },
  {
    "beat": "S04",
    "start": 26.013,
    "end": 28.449,
    "text": "Multiply that by a thousand and the context"
  },
  {
    "beat": "S04",
    "start": 28.449,
    "end": 30.715,
    "text": "fills with menu instead of meal \u2014 bigger"
  },
  {
    "beat": "S04",
    "start": 30.715,
    "end": 33.151,
    "text": "search space, more latency, more cost, more"
  },
  {
    "beat": "S04",
    "start": 33.151,
    "end": 35.407,
    "text": "chances to pick the wrong tool."
  },
  {
    "beat": "S05",
    "start": 35.407,
    "end": 37.604,
    "text": "Take a real request: analyze this"
  },
  {
    "beat": "S05",
    "start": 37.604,
    "end": 39.336,
    "text": "CSV and create a chart."
  },
  {
    "beat": "S05",
    "start": 39.336,
    "end": 40.804,
    "text": "The agent loads a thousand"
  },
  {
    "beat": "S05",
    "start": 40.804,
    "end": 42.554,
    "text": "definitions, searches them all,"
  },
  {
    "beat": "S05",
    "start": 42.554,
    "end": 44.409,
    "text": "and ends up using three."
  },
  {
    "beat": "S06",
    "start": 44.409,
    "end": 46.659,
    "text": "Progressive discovery flips it."
  },
  {
    "beat": "S06",
    "start": 46.659,
    "end": 48.491,
    "text": "Read the intent first, search a"
  },
  {
    "beat": "S06",
    "start": 48.491,
    "end": 50.441,
    "text": "tool registry, and load only what"
  },
  {
    "beat": "S06",
    "start": 50.441,
    "end": 51.828,
    "text": "the task needs."
  },
  {
    "beat": "S07",
    "start": 51.828,
    "end": 54.006,
    "text": "Claude can help you build each piece:"
  },
  {
    "beat": "S07",
    "start": 54.006,
    "end": 56.301,
    "text": "intent classification, a tool registry,"
  },
  {
    "beat": "S07",
    "start": 56.301,
    "end": 58.126,
    "text": "semantic search, ranking, top-K"
  },
  {
    "beat": "S07",
    "start": 58.126,
    "end": 60.156,
    "text": "selection, then execution."
  },
  {
    "beat": "S08",
    "start": 60.156,
    "end": 62.375,
    "text": "The code stays small: search the registry,"
  },
  {
    "beat": "S08",
    "start": 62.375,
    "end": 64.646,
    "text": "rank against the query, keep the top three,"
  },
  {
    "beat": "S08",
    "start": 64.646,
    "end": 66.467,
    "text": "and hand those to Claude."
  },
  {
    "beat": "S09",
    "start": 66.467,
    "end": 68.33,
    "text": "Same thousand tools."
  },
  {
    "beat": "S09",
    "start": 68.33,
    "end": 70.65,
    "text": "Method A exposes a thousand."
  },
  {
    "beat": "S09",
    "start": 70.65,
    "end": 72.786,
    "text": "Method B exposes three."
  },
  {
    "beat": "S09",
    "start": 72.786,
    "end": 75.345,
    "text": "Same job, far less overhead."
  },
  {
    "beat": "S10",
    "start": 75.345,
    "end": 77.556,
    "text": "This is information retrieval, ranking"
  },
  {
    "beat": "S10",
    "start": 77.556,
    "end": 79.534,
    "text": "algorithms, software architecture,"
  },
  {
    "beat": "S10",
    "start": 79.534,
    "end": 81.337,
    "text": "distributed systems and context"
  },
  {
    "beat": "S10",
    "start": 81.337,
    "end": 83.35,
    "text": "engineering, in one build."
  },
  {
    "beat": "S11",
    "start": 83.35,
    "end": 85.784,
    "text": "This matters as ecosystems grow."
  },
  {
    "beat": "S11",
    "start": 85.784,
    "end": 88.263,
    "text": "Anthropic's tool search tool already defers"
  },
  {
    "beat": "S11",
    "start": 88.263,
    "end": 90.684,
    "text": "loading until Claude needs a tool, and the"
  },
  {
    "beat": "S11",
    "start": 90.684,
    "end": 93.047,
    "text": "MCP roadmap calls progressive discovery a"
  },
  {
    "beat": "S11",
    "start": 93.047,
    "end": 95.641,
    "text": "priority \u2014 check the official docs before you"
  },
  {
    "beat": "S11",
    "start": 95.641,
    "end": 97.294,
    "text": "quote any specifics."
  },
  {
    "beat": "S12",
    "start": 97.294,
    "end": 100.248,
    "text": "Discover, filter, rank, load, execute."
  },
  {
    "beat": "S13",
    "start": 100.248,
    "end": 101.999,
    "text": "The goal isn't to give an AI"
  },
  {
    "beat": "S13",
    "start": 101.999,
    "end": 103.762,
    "text": "agent every tool at once."
  },
  {
    "beat": "S13",
    "start": 103.762,
    "end": 105.404,
    "text": "The goal is to give it the right"
  },
  {
    "beat": "S13",
    "start": 105.404,
    "end": 107.136,
    "text": "tools at the right time."
  },
  {
    "beat": "S14",
    "start": 107.136,
    "end": 109.134,
    "text": "Progressive tool discovery can make"
  },
  {
    "beat": "S14",
    "start": 109.134,
    "end": 111.246,
    "text": "agent systems more focused, efficient"
  },
  {
    "beat": "S14",
    "start": 111.246,
    "end": 112.588,
    "text": "and easier to scale."
  },
  {
    "beat": "S14",
    "start": 112.588,
    "end": 114.528,
    "text": "I'm Dhrumil Shah, and this is how"
  },
  {
    "beat": "S14",
    "start": 114.528,
    "end": 116.586,
    "text": "smarter tool routing helps us build"
  },
  {
    "beat": "S14",
    "start": 116.586,
    "end": 117.586,
    "text": "better AI agents."
  }
]