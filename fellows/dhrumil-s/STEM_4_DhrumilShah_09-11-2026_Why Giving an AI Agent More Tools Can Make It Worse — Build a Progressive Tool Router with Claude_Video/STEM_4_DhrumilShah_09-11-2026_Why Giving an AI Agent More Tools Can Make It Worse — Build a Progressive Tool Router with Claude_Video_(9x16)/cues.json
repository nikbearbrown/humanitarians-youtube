[
  {
    "beat": "S01",
    "start": 0.1,
    "end": 1.882,
    "text": "Hi, I am Dhrumil Shah, and this"
  },
  {
    "beat": "S01",
    "start": 1.882,
    "end": 3.665,
    "text": "video is about why giving an AI"
  },
  {
    "beat": "S01",
    "start": 3.665,
    "end": 5.62,
    "text": "agent more tools can actually make"
  },
  {
    "beat": "S01",
    "start": 5.62,
    "end": 7.517,
    "text": "it worse \u2014 and how we can build a"
  },
  {
    "beat": "S01",
    "start": 7.517,
    "end": 9.299,
    "text": "smarter progressive tool router"
  },
  {
    "beat": "S01",
    "start": 9.299,
    "end": 9.989,
    "text": "with Claude."
  },
  {
    "beat": "S02",
    "start": 10.489,
    "end": 12.404,
    "text": "If an AI agent has access to a"
  },
  {
    "beat": "S02",
    "start": 12.404,
    "end": 14.318,
    "text": "thousand tools, does it really"
  },
  {
    "beat": "S02",
    "start": 14.318,
    "end": 16.36,
    "text": "need all thousand in its context"
  },
  {
    "beat": "S02",
    "start": 16.36,
    "end": 18.211,
    "text": "just to analyze one CSV file?"
  },
  {
    "beat": "S03",
    "start": 18.711,
    "end": 20.529,
    "text": "Every tool costs context before"
  },
  {
    "beat": "S03",
    "start": 20.529,
    "end": 22.405,
    "text": "the work even starts \u2014 a name, a"
  },
  {
    "beat": "S03",
    "start": 22.405,
    "end": 24.105,
    "text": "description, an input schema,"
  },
  {
    "beat": "S03",
    "start": 24.105,
    "end": 25.512,
    "text": "parameters, permissions."
  },
  {
    "beat": "S04",
    "start": 26.013,
    "end": 27.792,
    "text": "Multiply that by a thousand and"
  },
  {
    "beat": "S04",
    "start": 27.792,
    "end": 29.341,
    "text": "the context fills with menu"
  },
  {
    "beat": "S04",
    "start": 29.341,
    "end": 31.12,
    "text": "instead of meal \u2014 bigger search"
  },
  {
    "beat": "S04",
    "start": 31.12,
    "end": 32.899,
    "text": "space, more latency, more cost,"
  },
  {
    "beat": "S04",
    "start": 32.899,
    "end": 34.62,
    "text": "more chances to pick the wrong"
  },
  {
    "beat": "S04",
    "start": 34.62,
    "end": 34.907,
    "text": "tool."
  },
  {
    "beat": "S05",
    "start": 35.407,
    "end": 37.604,
    "text": "Take a real request: analyze this"
  },
  {
    "beat": "S05",
    "start": 37.604,
    "end": 39.136,
    "text": "CSV and create a chart."
  },
  {
    "beat": "S05",
    "start": 39.336,
    "end": 40.804,
    "text": "The agent loads a thousand"
  },
  {
    "beat": "S05",
    "start": 40.804,
    "end": 42.554,
    "text": "definitions, searches them all,"
  },
  {
    "beat": "S05",
    "start": 42.554,
    "end": 43.909,
    "text": "and ends up using three."
  },
  {
    "beat": "S06",
    "start": 44.409,
    "end": 46.459,
    "text": "Progressive discovery flips it."
  },
  {
    "beat": "S06",
    "start": 46.659,
    "end": 48.491,
    "text": "Read the intent first, search a"
  },
  {
    "beat": "S06",
    "start": 48.491,
    "end": 50.441,
    "text": "tool registry, and load only what"
  },
  {
    "beat": "S06",
    "start": 50.441,
    "end": 51.328,
    "text": "the task needs."
  },
  {
    "beat": "S07",
    "start": 51.828,
    "end": 53.607,
    "text": "Claude can help you build each"
  },
  {
    "beat": "S07",
    "start": 53.607,
    "end": 55.445,
    "text": "piece: intent classification, a"
  },
  {
    "beat": "S07",
    "start": 55.445,
    "end": 57.284,
    "text": "tool registry, semantic search,"
  },
  {
    "beat": "S07",
    "start": 57.284,
    "end": 59.063,
    "text": "ranking, top-K selection, then"
  },
  {
    "beat": "S07",
    "start": 59.063,
    "end": 59.656,
    "text": "execution."
  },
  {
    "beat": "S08",
    "start": 60.156,
    "end": 61.862,
    "text": "The code stays small: search the"
  },
  {
    "beat": "S08",
    "start": 61.862,
    "end": 63.621,
    "text": "registry, rank against the query,"
  },
  {
    "beat": "S08",
    "start": 63.621,
    "end": 65.434,
    "text": "keep the top three, and hand those"
  },
  {
    "beat": "S08",
    "start": 65.434,
    "end": 65.967,
    "text": "to Claude."
  },
  {
    "beat": "S09",
    "start": 66.467,
    "end": 68.13,
    "text": "Same thousand tools."
  },
  {
    "beat": "S09",
    "start": 68.33,
    "end": 70.45,
    "text": "Method A exposes a thousand."
  },
  {
    "beat": "S09",
    "start": 70.65,
    "end": 72.586,
    "text": "Method B exposes three."
  },
  {
    "beat": "S09",
    "start": 72.786,
    "end": 74.844,
    "text": "Same job, far less overhead."
  },
  {
    "beat": "S10",
    "start": 75.345,
    "end": 77.104,
    "text": "This is information retrieval,"
  },
  {
    "beat": "S10",
    "start": 77.104,
    "end": 78.746,
    "text": "ranking algorithms, software"
  },
  {
    "beat": "S10",
    "start": 78.746,
    "end": 80.681,
    "text": "architecture, distributed systems"
  },
  {
    "beat": "S10",
    "start": 80.681,
    "end": 82.499,
    "text": "and context engineering, in one"
  },
  {
    "beat": "S10",
    "start": 82.499,
    "end": 82.85,
    "text": "build."
  },
  {
    "beat": "S11",
    "start": 83.35,
    "end": 85.584,
    "text": "This matters as ecosystems grow."
  },
  {
    "beat": "S11",
    "start": 85.784,
    "end": 87.415,
    "text": "Anthropic's tool search tool"
  },
  {
    "beat": "S11",
    "start": 87.415,
    "end": 89.046,
    "text": "already defers loading until"
  },
  {
    "beat": "S11",
    "start": 89.046,
    "end": 90.911,
    "text": "Claude needs a tool, and the MCP"
  },
  {
    "beat": "S11",
    "start": 90.911,
    "end": 92.367,
    "text": "roadmap calls progressive"
  },
  {
    "beat": "S11",
    "start": 92.367,
    "end": 94.231,
    "text": "discovery a priority \u2014 check the"
  },
  {
    "beat": "S11",
    "start": 94.231,
    "end": 96.212,
    "text": "official docs before you quote any"
  },
  {
    "beat": "S11",
    "start": 96.212,
    "end": 96.794,
    "text": "specifics."
  },
  {
    "beat": "S12",
    "start": 97.294,
    "end": 99.217,
    "text": "Discover, filter, rank, load,"
  },
  {
    "beat": "S12",
    "start": 99.217,
    "end": 99.748,
    "text": "execute."
  },
  {
    "beat": "S13",
    "start": 100.248,
    "end": 102.374,
    "text": "The goal isn't to give an AI agent"
  },
  {
    "beat": "S13",
    "start": 102.374,
    "end": 103.562,
    "text": "every tool at once."
  },
  {
    "beat": "S13",
    "start": 103.762,
    "end": 105.404,
    "text": "The goal is to give it the right"
  },
  {
    "beat": "S13",
    "start": 105.404,
    "end": 106.636,
    "text": "tools at the right time."
  },
  {
    "beat": "S14",
    "start": 107.136,
    "end": 108.849,
    "text": "Progressive tool discovery can"
  },
  {
    "beat": "S14",
    "start": 108.849,
    "end": 110.675,
    "text": "make agent systems more focused,"
  },
  {
    "beat": "S14",
    "start": 110.675,
    "end": 112.388,
    "text": "efficient and easier to scale."
  },
  {
    "beat": "S14",
    "start": 112.588,
    "end": 114.528,
    "text": "I'm Dhrumil Shah, and this is how"
  },
  {
    "beat": "S14",
    "start": 114.528,
    "end": 116.234,
    "text": "smarter tool routing helps us"
  },
  {
    "beat": "S14",
    "start": 116.234,
    "end": 117.586,
    "text": "build better AI agents."
  }
]