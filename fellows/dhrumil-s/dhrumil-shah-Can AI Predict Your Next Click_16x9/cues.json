[
  {
    "beat": "B00",
    "start": 0.1,
    "end": 2.138,
    "text": "Hi, I am Dhrumil Shah, and this"
  },
  {
    "beat": "B00",
    "start": 2.138,
    "end": 4.177,
    "text": "video is about how AI estimates"
  },
  {
    "beat": "B00",
    "start": 4.177,
    "end": 6.281,
    "text": "which customers will click, buy,"
  },
  {
    "beat": "B00",
    "start": 6.281,
    "end": 8.517,
    "text": "or leave, and why those scores are"
  },
  {
    "beat": "B00",
    "start": 8.517,
    "end": 10.555,
    "text": "probabilities, not certainties."
  },
  {
    "beat": "B01",
    "start": 11.055,
    "end": 12.468,
    "text": "Five thousand coffee-shop"
  },
  {
    "beat": "B01",
    "start": 12.468,
    "end": 13.034,
    "text": "customers."
  },
  {
    "beat": "B01",
    "start": 13.234,
    "end": 14.242,
    "text": "Will this one click?"
  },
  {
    "beat": "B01",
    "start": 14.442,
    "end": 15.434,
    "text": "Will this one buy?"
  },
  {
    "beat": "B01",
    "start": 15.634,
    "end": 16.93,
    "text": "Is this one about to leave?"
  },
  {
    "beat": "B01",
    "start": 17.13,
    "end": 18.72,
    "text": "A model answers: eighty-nine,"
  },
  {
    "beat": "B01",
    "start": 18.72,
    "end": 20.311,
    "text": "seventy, sixty-eight percent."
  },
  {
    "beat": "B01",
    "start": 20.511,
    "end": 21.443,
    "text": "But how does it know?"
  },
  {
    "beat": "B02",
    "start": 21.943,
    "end": 22.723,
    "text": "It doesn't know."
  },
  {
    "beat": "B02",
    "start": 22.923,
    "end": 24.729,
    "text": "It estimates probabilities from"
  },
  {
    "beat": "B02",
    "start": 24.729,
    "end": 25.545,
    "text": "past behavior."
  },
  {
    "beat": "B03",
    "start": 26.045,
    "end": 27.987,
    "text": "It starts with events: emails,"
  },
  {
    "beat": "B03",
    "start": 27.987,
    "end": 29.929,
    "text": "clicks, visits, product views,"
  },
  {
    "beat": "B03",
    "start": 29.929,
    "end": 31.806,
    "text": "carts, purchases, each with a"
  },
  {
    "beat": "B03",
    "start": 31.806,
    "end": 33.619,
    "text": "customer ID and a timestamp."
  },
  {
    "beat": "B04",
    "start": 34.119,
    "end": 35.898,
    "text": "Events become features, counted"
  },
  {
    "beat": "B04",
    "start": 35.898,
    "end": 37.735,
    "text": "only before the prediction date."
  },
  {
    "beat": "B04",
    "start": 37.935,
    "end": 39.254,
    "text": "Visits in thirty days."
  },
  {
    "beat": "B04",
    "start": 39.454,
    "end": 40.703,
    "text": "Purchases in ninety."
  },
  {
    "beat": "B04",
    "start": 40.903,
    "end": 42.331,
    "text": "Days since last activity."
  },
  {
    "beat": "B05",
    "start": 42.831,
    "end": 44.055,
    "text": "Then define the target."
  },
  {
    "beat": "B05",
    "start": 44.255,
    "end": 45.586,
    "text": "Click within seven days?"
  },
  {
    "beat": "B05",
    "start": 45.786,
    "end": 46.728,
    "text": "Buy within seven?"
  },
  {
    "beat": "B05",
    "start": 46.928,
    "end": 48.889,
    "text": "Churn, in this demo, means thirty"
  },
  {
    "beat": "B05",
    "start": 48.889,
    "end": 50.613,
    "text": "days with no click, visit, or"
  },
  {
    "beat": "B05",
    "start": 50.613,
    "end": 51.148,
    "text": "purchase."
  },
  {
    "beat": "B05",
    "start": 51.348,
    "end": 52.697,
    "text": "Real businesses define it"
  },
  {
    "beat": "B05",
    "start": 52.697,
    "end": 53.344,
    "text": "differently."
  },
  {
    "beat": "B06",
    "start": 53.844,
    "end": 55.508,
    "text": "Training pairs past features with"
  },
  {
    "beat": "B06",
    "start": 55.508,
    "end": 56.467,
    "text": "what happened next."
  },
  {
    "beat": "B06",
    "start": 56.667,
    "end": 58.134,
    "text": "Earlier months train the model."
  },
  {
    "beat": "B06",
    "start": 58.334,
    "end": 60.116,
    "text": "A later month it never saw tests"
  },
  {
    "beat": "B06",
    "start": 60.116,
    "end": 61.897,
    "text": "it, so the future can't leak in."
  },
  {
    "beat": "B07",
    "start": 62.397,
    "end": 64.542,
    "text": "Customer A: twenty-two visits this"
  },
  {
    "beat": "B07",
    "start": 64.542,
    "end": 66.434,
    "text": "month, ten purchases in ninety"
  },
  {
    "beat": "B07",
    "start": 66.434,
    "end": 67.885,
    "text": "days, active yesterday."
  },
  {
    "beat": "B08",
    "start": 68.385,
    "end": 69.622,
    "text": "Click: eighty-nine percent."
  },
  {
    "beat": "B08",
    "start": 69.822,
    "end": 70.787,
    "text": "Buy: sixty-one."
  },
  {
    "beat": "B08",
    "start": 70.987,
    "end": 72.532,
    "text": "Churn risk: under one percent."
  },
  {
    "beat": "B08",
    "start": 72.732,
    "end": 74.394,
    "text": "That week, Customer A clicked, but"
  },
  {
    "beat": "B08",
    "start": 74.394,
    "end": 74.932,
    "text": "didn't buy."
  },
  {
    "beat": "B08",
    "start": 75.132,
    "end": 76.949,
    "text": "A probability is not a promise."
  },
  {
    "beat": "B09",
    "start": 77.449,
    "end": 78.831,
    "text": "Customer B: silent for"
  },
  {
    "beat": "B09",
    "start": 78.831,
    "end": 79.962,
    "text": "seventy-four days."
  },
  {
    "beat": "B09",
    "start": 80.162,
    "end": 81.16,
    "text": "Click: two percent."
  },
  {
    "beat": "B09",
    "start": 81.36,
    "end": 82.865,
    "text": "Churn risk: seventy-three."
  },
  {
    "beat": "B10",
    "start": 83.365,
    "end": 84.513,
    "text": "Scores rank everyone."
  },
  {
    "beat": "B10",
    "start": 84.713,
    "end": 86.495,
    "text": "The team sets cutoffs for high,"
  },
  {
    "beat": "B10",
    "start": 86.495,
    "end": 87.645,
    "text": "medium, and at risk."
  },
  {
    "beat": "B10",
    "start": 87.845,
    "end": 89.555,
    "text": "Those are business choices, not"
  },
  {
    "beat": "B10",
    "start": 89.555,
    "end": 90.383,
    "text": "laws of nature."
  },
  {
    "beat": "B11",
    "start": 90.883,
    "end": 92.873,
    "text": "Each segment gets something to"
  },
  {
    "beat": "B11",
    "start": 92.873,
    "end": 95.128,
    "text": "test: a new-roast email, an offer,"
  },
  {
    "beat": "B11",
    "start": 95.128,
    "end": 96.985,
    "text": "a win-back message, or fewer"
  },
  {
    "beat": "B11",
    "start": 96.985,
    "end": 97.45,
    "text": "emails."
  },
  {
    "beat": "B11",
    "start": 97.65,
    "end": 99.337,
    "text": "Consent and human review still"
  },
  {
    "beat": "B11",
    "start": 99.337,
    "end": 99.675,
    "text": "apply."
  },
  {
    "beat": "B12",
    "start": 100.175,
    "end": 100.896,
    "text": "Does it work?"
  },
  {
    "beat": "B12",
    "start": 101.096,
    "end": 102.972,
    "text": "On the unseen month, customers"
  },
  {
    "beat": "B12",
    "start": 102.972,
    "end": 104.849,
    "text": "scored near fifty-five percent"
  },
  {
    "beat": "B12",
    "start": 104.849,
    "end": 106.6,
    "text": "bought at fifty-six percent."
  },
  {
    "beat": "B12",
    "start": 106.8,
    "end": 107.89,
    "text": "That's calibration."
  },
  {
    "beat": "B13",
    "start": 108.39,
    "end": 110.053,
    "text": "But prediction isn't causation."
  },
  {
    "beat": "B13",
    "start": 110.253,
    "end": 111.761,
    "text": "A high scorer might have bought"
  },
  {
    "beat": "B13",
    "start": 111.761,
    "end": 112.102,
    "text": "anyway."
  },
  {
    "beat": "B13",
    "start": 112.302,
    "end": 114.113,
    "text": "Only a holdout test shows whether"
  },
  {
    "beat": "B13",
    "start": 114.113,
    "end": 115.706,
    "text": "the campaign caused anything."
  },
  {
    "beat": "B14",
    "start": 116.206,
    "end": 118.107,
    "text": "Salesforce documents Einstein"
  },
  {
    "beat": "B14",
    "start": 118.107,
    "end": 120.009,
    "text": "Engagement Scoring predicting"
  },
  {
    "beat": "B14",
    "start": 120.009,
    "end": 121.648,
    "text": "opens, clicks, subscriber"
  },
  {
    "beat": "B14",
    "start": 121.648,
    "end": 123.615,
    "text": "retention, and web conversion."
  },
  {
    "beat": "B14",
    "start": 123.815,
    "end": 125.905,
    "text": "But opens are noisy: Apple Mail"
  },
  {
    "beat": "B14",
    "start": 125.905,
    "end": 128.061,
    "text": "can download email images in the"
  },
  {
    "beat": "B14",
    "start": 128.061,
    "end": 128.803,
    "text": "background."
  },
  {
    "beat": "B14",
    "start": 129.003,
    "end": 130.593,
    "text": "And bad data makes confident,"
  },
  {
    "beat": "B14",
    "start": 130.593,
    "end": 131.305,
    "text": "wrong scores."
  },
  {
    "beat": "B15",
    "start": 131.805,
    "end": 133.318,
    "text": "Claude isn't the predictor here."
  },
  {
    "beat": "B15",
    "start": 133.518,
    "end": 135.165,
    "text": "It explains scores in plain"
  },
  {
    "beat": "B15",
    "start": 135.165,
    "end": 136.873,
    "text": "language, flags leakage, and"
  },
  {
    "beat": "B15",
    "start": 136.873,
    "end": 138.52,
    "text": "drafts the next experiment."
  },
  {
    "beat": "B15",
    "start": 138.72,
    "end": 140.061,
    "text": "People decide what's fair."
  },
  {
    "beat": "B16",
    "start": 140.561,
    "end": 142.122,
    "text": "So, can AI predict your next"
  },
  {
    "beat": "B16",
    "start": 142.122,
    "end": 142.457,
    "text": "click?"
  },
  {
    "beat": "B16",
    "start": 142.657,
    "end": 144.321,
    "text": "It turns past behavior into"
  },
  {
    "beat": "B16",
    "start": 144.321,
    "end": 146.109,
    "text": "probabilities that people can"
  },
  {
    "beat": "B16",
    "start": 146.109,
    "end": 146.418,
    "text": "test."
  },
  {
    "beat": "B16",
    "start": 146.618,
    "end": 147.217,
    "text": "Events."
  },
  {
    "beat": "B16",
    "start": 147.417,
    "end": 148.07,
    "text": "Features."
  },
  {
    "beat": "B16",
    "start": 148.27,
    "end": 148.79,
    "text": "Model."
  },
  {
    "beat": "B16",
    "start": 148.99,
    "end": 149.807,
    "text": "Probability."
  },
  {
    "beat": "B16",
    "start": 150.007,
    "end": 150.563,
    "text": "Action."
  },
  {
    "beat": "B16",
    "start": 150.763,
    "end": 151.302,
    "text": "Measure."
  },
  {
    "beat": "B16",
    "start": 151.502,
    "end": 153.056,
    "text": "Prediction is not certainty."
  }
]