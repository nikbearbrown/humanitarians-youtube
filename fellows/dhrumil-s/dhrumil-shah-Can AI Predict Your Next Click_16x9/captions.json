[
  {
    "beat": "B00",
    "start": 0.1,
    "end": 2.533,
    "text": "Hi, I am Dhrumil Shah, and this video"
  },
  {
    "beat": "B00",
    "start": 2.533,
    "end": 4.571,
    "text": "is about how AI estimates which"
  },
  {
    "beat": "B00",
    "start": 4.571,
    "end": 6.938,
    "text": "customers will click, buy, or leave,"
  },
  {
    "beat": "B00",
    "start": 6.938,
    "end": 8.517,
    "text": "and why those scores are"
  },
  {
    "beat": "B00",
    "start": 8.517,
    "end": 11.055,
    "text": "probabilities, not certainties."
  },
  {
    "beat": "B01",
    "start": 11.055,
    "end": 13.234,
    "text": "Five thousand coffee-shop customers."
  },
  {
    "beat": "B01",
    "start": 13.234,
    "end": 14.442,
    "text": "Will this one click?"
  },
  {
    "beat": "B01",
    "start": 14.442,
    "end": 15.634,
    "text": "Will this one buy?"
  },
  {
    "beat": "B01",
    "start": 15.634,
    "end": 17.13,
    "text": "Is this one about to leave?"
  },
  {
    "beat": "B01",
    "start": 17.13,
    "end": 18.721,
    "text": "A model answers: eighty-nine,"
  },
  {
    "beat": "B01",
    "start": 18.721,
    "end": 20.511,
    "text": "seventy, sixty-eight percent."
  },
  {
    "beat": "B01",
    "start": 20.511,
    "end": 21.943,
    "text": "But how does it know?"
  },
  {
    "beat": "B02",
    "start": 21.943,
    "end": 22.923,
    "text": "It doesn't know."
  },
  {
    "beat": "B02",
    "start": 22.923,
    "end": 24.438,
    "text": "It estimates probabilities"
  },
  {
    "beat": "B02",
    "start": 24.438,
    "end": 26.045,
    "text": "from past behavior."
  },
  {
    "beat": "B03",
    "start": 26.045,
    "end": 28.998,
    "text": "It starts with events: emails, clicks, visits,"
  },
  {
    "beat": "B03",
    "start": 28.998,
    "end": 31.822,
    "text": "product views, carts, purchases, each with a"
  },
  {
    "beat": "B03",
    "start": 31.822,
    "end": 34.119,
    "text": "customer ID and a timestamp."
  },
  {
    "beat": "B04",
    "start": 34.119,
    "end": 36.185,
    "text": "Events become features, counted only"
  },
  {
    "beat": "B04",
    "start": 36.185,
    "end": 37.935,
    "text": "before the prediction date."
  },
  {
    "beat": "B04",
    "start": 37.935,
    "end": 39.454,
    "text": "Visits in thirty days."
  },
  {
    "beat": "B04",
    "start": 39.454,
    "end": 40.903,
    "text": "Purchases in ninety."
  },
  {
    "beat": "B04",
    "start": 40.903,
    "end": 42.831,
    "text": "Days since last activity."
  },
  {
    "beat": "B05",
    "start": 42.831,
    "end": 44.255,
    "text": "Then define the target."
  },
  {
    "beat": "B05",
    "start": 44.255,
    "end": 45.786,
    "text": "Click within seven days?"
  },
  {
    "beat": "B05",
    "start": 45.786,
    "end": 46.928,
    "text": "Buy within seven?"
  },
  {
    "beat": "B05",
    "start": 46.928,
    "end": 49.155,
    "text": "Churn, in this demo, means thirty days"
  },
  {
    "beat": "B05",
    "start": 49.155,
    "end": 51.348,
    "text": "with no click, visit, or purchase."
  },
  {
    "beat": "B05",
    "start": 51.348,
    "end": 53.844,
    "text": "Real businesses define it differently."
  },
  {
    "beat": "B06",
    "start": 53.844,
    "end": 55.256,
    "text": "Training pairs past features"
  },
  {
    "beat": "B06",
    "start": 55.256,
    "end": 56.667,
    "text": "with what happened next."
  },
  {
    "beat": "B06",
    "start": 56.667,
    "end": 58.334,
    "text": "Earlier months train the model."
  },
  {
    "beat": "B06",
    "start": 58.334,
    "end": 60.338,
    "text": "A later month it never saw tests it,"
  },
  {
    "beat": "B06",
    "start": 60.338,
    "end": 62.397,
    "text": "so the future can't leak in."
  },
  {
    "beat": "B07",
    "start": 62.397,
    "end": 64.542,
    "text": "Customer A: twenty-two visits this"
  },
  {
    "beat": "B07",
    "start": 64.542,
    "end": 66.434,
    "text": "month, ten purchases in ninety"
  },
  {
    "beat": "B07",
    "start": 66.434,
    "end": 68.385,
    "text": "days, active yesterday."
  },
  {
    "beat": "B08",
    "start": 68.385,
    "end": 69.822,
    "text": "Click: eighty-nine percent."
  },
  {
    "beat": "B08",
    "start": 69.822,
    "end": 70.987,
    "text": "Buy: sixty-one."
  },
  {
    "beat": "B08",
    "start": 70.987,
    "end": 72.732,
    "text": "Churn risk: under one percent."
  },
  {
    "beat": "B08",
    "start": 72.732,
    "end": 73.759,
    "text": "That week, Customer A"
  },
  {
    "beat": "B08",
    "start": 73.759,
    "end": 75.132,
    "text": "clicked, but didn't buy."
  },
  {
    "beat": "B08",
    "start": 75.132,
    "end": 77.449,
    "text": "A probability is not a promise."
  },
  {
    "beat": "B09",
    "start": 77.449,
    "end": 78.831,
    "text": "Customer B: silent for"
  },
  {
    "beat": "B09",
    "start": 78.831,
    "end": 80.162,
    "text": "seventy-four days."
  },
  {
    "beat": "B09",
    "start": 80.162,
    "end": 81.36,
    "text": "Click: two percent."
  },
  {
    "beat": "B09",
    "start": 81.36,
    "end": 83.365,
    "text": "Churn risk: seventy-three."
  },
  {
    "beat": "B10",
    "start": 83.365,
    "end": 84.713,
    "text": "Scores rank everyone."
  },
  {
    "beat": "B10",
    "start": 84.713,
    "end": 86.495,
    "text": "The team sets cutoffs for high,"
  },
  {
    "beat": "B10",
    "start": 86.495,
    "end": 87.845,
    "text": "medium, and at risk."
  },
  {
    "beat": "B10",
    "start": 87.845,
    "end": 89.335,
    "text": "Those are business choices,"
  },
  {
    "beat": "B10",
    "start": 89.335,
    "end": 90.883,
    "text": "not laws of nature."
  },
  {
    "beat": "B11",
    "start": 90.883,
    "end": 93.378,
    "text": "Each segment gets something to test: a"
  },
  {
    "beat": "B11",
    "start": 93.378,
    "end": 95.808,
    "text": "new-roast email, an offer, a win-back"
  },
  {
    "beat": "B11",
    "start": 95.808,
    "end": 97.65,
    "text": "message, or fewer emails."
  },
  {
    "beat": "B11",
    "start": 97.65,
    "end": 100.175,
    "text": "Consent and human review still apply."
  },
  {
    "beat": "B12",
    "start": 100.175,
    "end": 101.096,
    "text": "Does it work?"
  },
  {
    "beat": "B12",
    "start": 101.096,
    "end": 102.972,
    "text": "On the unseen month, customers"
  },
  {
    "beat": "B12",
    "start": 102.972,
    "end": 104.849,
    "text": "scored near fifty-five percent"
  },
  {
    "beat": "B12",
    "start": 104.849,
    "end": 106.8,
    "text": "bought at fifty-six percent."
  },
  {
    "beat": "B12",
    "start": 106.8,
    "end": 108.39,
    "text": "That's calibration."
  },
  {
    "beat": "B13",
    "start": 108.39,
    "end": 110.253,
    "text": "But prediction isn't causation."
  },
  {
    "beat": "B13",
    "start": 110.253,
    "end": 112.302,
    "text": "A high scorer might have bought anyway."
  },
  {
    "beat": "B13",
    "start": 112.302,
    "end": 114.333,
    "text": "Only a holdout test shows whether the"
  },
  {
    "beat": "B13",
    "start": 114.333,
    "end": 116.206,
    "text": "campaign caused anything."
  },
  {
    "beat": "B14",
    "start": 116.206,
    "end": 118.806,
    "text": "Salesforce documents Einstein Engagement"
  },
  {
    "beat": "B14",
    "start": 118.806,
    "end": 121.665,
    "text": "Scoring predicting opens, clicks, subscriber"
  },
  {
    "beat": "B14",
    "start": 121.665,
    "end": 123.815,
    "text": "retention, and web conversion."
  },
  {
    "beat": "B14",
    "start": 123.815,
    "end": 126.741,
    "text": "But opens are noisy: Apple Mail can download"
  },
  {
    "beat": "B14",
    "start": 126.741,
    "end": 129.003,
    "text": "email images in the background."
  },
  {
    "beat": "B14",
    "start": 129.003,
    "end": 129.99,
    "text": "And bad data makes"
  },
  {
    "beat": "B14",
    "start": 129.99,
    "end": 131.805,
    "text": "confident, wrong scores."
  },
  {
    "beat": "B15",
    "start": 131.805,
    "end": 133.518,
    "text": "Claude isn't the predictor here."
  },
  {
    "beat": "B15",
    "start": 133.518,
    "end": 135.165,
    "text": "It explains scores in plain"
  },
  {
    "beat": "B15",
    "start": 135.165,
    "end": 136.873,
    "text": "language, flags leakage, and"
  },
  {
    "beat": "B15",
    "start": 136.873,
    "end": 138.72,
    "text": "drafts the next experiment."
  },
  {
    "beat": "B15",
    "start": 138.72,
    "end": 140.561,
    "text": "People decide what's fair."
  },
  {
    "beat": "B16",
    "start": 140.561,
    "end": 142.657,
    "text": "So, can AI predict your next click?"
  },
  {
    "beat": "B16",
    "start": 142.657,
    "end": 144.295,
    "text": "It turns past behavior into"
  },
  {
    "beat": "B16",
    "start": 144.295,
    "end": 146.618,
    "text": "probabilities that people can test."
  },
  {
    "beat": "B16",
    "start": 146.618,
    "end": 150.007,
    "text": "Events. Features. Model. Probability."
  },
  {
    "beat": "B16",
    "start": 150.007,
    "end": 151.502,
    "text": "Action. Measure."
  },
  {
    "beat": "B16",
    "start": 151.502,
    "end": 153.056,
    "text": "Prediction is not certainty."
  }
]