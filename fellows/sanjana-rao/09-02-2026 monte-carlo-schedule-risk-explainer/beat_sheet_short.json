    {
      "beat_id": "S01",
      "act": "OUTPUT",
      "narration_text": "The trick is this. Instead of giving each task a single number, give it a range: a best case, a likely case, and a worst case. Then let the computer play out your whole project ten thousand times. You get a picture like this. Your original plan sits way over on the hopeful edge. The date you can actually promise, the P80, is further out, and that gap is the risk you couldn't see before.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "S01_ShortHist",
          "file": "scenes_short.py"
