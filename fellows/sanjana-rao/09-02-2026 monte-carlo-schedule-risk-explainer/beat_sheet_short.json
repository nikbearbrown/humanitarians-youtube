            "topic": "HUMANITARIANS AI  |  PROJECT MANAGEMENT",
            "segment": "Monte Carlo Schedule Risk",
            "command": "Turn my project plan into a simulated finish date I can actually commit to.",
            "runningText": "simulating 10,000 schedules...",
