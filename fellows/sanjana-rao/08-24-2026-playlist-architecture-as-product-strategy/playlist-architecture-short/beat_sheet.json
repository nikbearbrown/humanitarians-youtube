    {
      "beat_id": "B01",
      "act": "HOOK",
      "narration_text": "Most channels treat playlists like folders. That's the mistake. A folder is where you file a video. A playlist is a promise about what someone watches next.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "PlaylistHook916",
          "props": {
            "sparkLine": "Start with the mistake."
          },
          "rendered": {
            "out": "media/B01.mp4",
            "at": ""
          }
        }
      },
      "estimated_duration_s": 12,
      "audio_file": "mp3/beat-B01.mp3",
      "actual_duration_s": 9.64,
      "build": {
        "status": "VIDEO",
        "src": "media\\B01.mp4",
        "filled_by": "media",
        "at": "2026-08-23T18:11:53"
      }
    },
    {
      "beat_id": "B02",
      "act": "FRAMEWORK",
      "narration_text": "Every playlist has to answer three questions. Who is it for? What do they want after video one? And what should they do at the end? Can't answer all three? It's not a product. It's a pile.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "PlaylistThreeQuestions916",
          "props": {
            "sparkLine": "The framework: three questions."
          },
          "rendered": {
            "out": "media/B02.mp4",
            "at": ""
          }
        }
      },
      "estimated_duration_s": 15,
      "audio_file": "mp3/beat-B02.mp3",
      "actual_duration_s": 11.43,
