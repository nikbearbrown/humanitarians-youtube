  "beats": [
    {
      "beat_id": "B00",
      "narration_text": "Hi, my name is Ushasvi Rachel, and this video is about data leakage and how it can make machine-learning models appear more accurate than they really are. What if an excellent validation score comes from information the model should never have seen? Data leakage can make a model appear far more capable than it will be in the real world.",
      "estimated_duration_s": 27,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "drawon",
        "visual_intent": "Portrait-native validation warning.",
        "remotion": {
          "pattern": "DataLeakageVertical",
          "props": {
            "kind": "warning"
          },
          "rendered": {
            "out": "media/B00.mp4",
            "at": "2026-09-24T17:40:00-04:00"
          }
        }
      },
      "audio_file": "mp3/beat-B00.mp3",
      "actual_duration_s": 19.86,
      "build": {
        "status": "VIDEO",
        "src": "media/B00.mp4",
        "filled_by": "remotion:DataLeakageVertical",
        "at": "2026-09-25T14:19:03"
      }
    },
    {
      "beat_id": "B01",
      "narration_text": "Leakage occurs when training or feature construction uses information that would not legitimately exist when a prediction is made. The information may come from the target, the future, or the evaluation set.",
      "estimated_duration_s": 17,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "drawon",
        "visual_intent": "Portrait-native leakage definition and sources.",
        "remotion": {
          "pattern": "DataLeakageVertical",
          "props": {
            "kind": "definition"
          },
          "rendered": {
            "out": "media/B01.mp4",
            "at": "2026-09-24T17:40:00-04:00"
          }
        }
      },
      "audio_file": "mp3/beat-B01.mp3",
      "actual_duration_s": 13.06,
      "build": {
        "status": "VIDEO",
        "src": "media/B01.mp4",
        "filled_by": "remotion:DataLeakageVertical",
        "at": "2026-09-25T14:19:03"
      }
    },
    {
      "beat_id": "B02",
      "narration_text": "Target leakage happens when a feature directly or indirectly reveals the outcome. Imagine a hypothetical model predicting subscription cancellation while using account closed date. That field may reveal who cancelled, but it would not exist when the prediction is actually needed.",
      "estimated_duration_s": 21,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "drawon",
        "visual_intent": "Portrait-native hypothetical cancellation table.",
        "remotion": {
          "pattern": "DataLeakageVertical",
          "props": {
            "kind": "target"
          },
          "rendered": {
            "out": "media/B02.mp4",
            "at": "2026-09-24T17:40:00-04:00"
          }
        }
      },
      "audio_file": "mp3/beat-B02.mp3",
      "actual_duration_s": 17.54,
      "build": {
        "status": "VIDEO",
        "src": "media/B02.mp4",
        "filled_by": "remotion:DataLeakageVertical",
        "at": "2026-09-25T14:19:03"
      }
    },
    {
      "beat_id": "B03",
      "narration_text": "Future, or temporal, leakage uses information recorded after the prediction point. For example, a hypothetical model cannot legitimately predict tomorrow’s sales using information that becomes available only after tomorrow has occurred.",
      "estimated_duration_s": 18,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "drawon",
        "visual_intent": "Portrait-native prediction-time boundary.",
        "remotion": {
          "pattern": "DataLeakageVertical",
          "props": {
            "kind": "future"
          },
          "rendered": {
            "out": "media/B03.mp4",
            "at": "2026-09-24T17:40:00-04:00"
          }
        }
      },
      "audio_file": "mp3/beat-B03.mp3",
      "actual_duration_s": 15.36,
      "build": {
        "status": "VIDEO",
        "src": "media/B03.mp4",
        "filled_by": "remotion:DataLeakageVertical",
        "at": "2026-09-25T14:19:03"
      }
    },
    {
      "beat_id": "B04",
      "narration_text": "Train-test contamination occurs when validation or test information influences preprocessing, feature selection, or training. Held-out data should represent information the pipeline has not already learned from.",
      "estimated_duration_s": 17,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "drawon",
        "visual_intent": "Portrait-native contamination paths.",
        "remotion": {
          "pattern": "DataLeakageVertical",
          "props": {
            "kind": "contamination"
          },
          "rendered": {
            "out": "media/B04.mp4",
            "at": "2026-09-24T17:40:00-04:00"
          }
        }
      },
      "audio_file": "mp3/beat-B04.mp3",
      "actual_duration_s": 14.04,
      "build": {
        "status": "VIDEO",
        "src": "media/B04.mp4",
        "filled_by": "remotion:DataLeakageVertical",
        "at": "2026-09-25T14:19:03"
      }
    },
    {
      "beat_id": "B05",
      "narration_text": "Split the data appropriately before fitting preprocessing. Learn scaling, imputation, or feature-selection rules from the training data. Then apply those fitted rules to held-out data without refitting them.",
      "estimated_duration_s": 18,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "drawon",
        "visual_intent": "Stacked unsafe and appropriate preprocessing workflows.",
        "remotion": {
          "pattern": "DataLeakageVertical",
          "props": {
            "kind": "preprocessing"
          },
          "rendered": {
            "out": "media/B05.mp4",
            "at": "2026-09-24T17:40:00-04:00"
          }
        }
      },
      "audio_file": "mp3/beat-B05.mp3",
      "actual_duration_s": 12.99,
      "build": {
        "status": "VIDEO",
        "src": "media/B05.mp4",
        "filled_by": "remotion:DataLeakageVertical",
        "at": "2026-09-25T14:19:03"
      }
    },
    {
      "beat_id": "B06",
      "narration_text": "For temporal prediction, a standard random split may mix past and future observations in ways that do not match deployment. A time-aware split can train on earlier periods and evaluate on later ones. Random splitting is not always wrong. The correct split depends on the prediction setting.",
      "estimated_duration_s": 23,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "drawon",
        "visual_intent": "Portrait-native random and time-aware split comparison.",
        "remotion": {
          "pattern": "DataLeakageVertical",
          "props": {
            "kind": "temporal"
          },
          "rendered": {
            "out": "media/B06.mp4",
            "at": "2026-09-24T17:40:00-04:00"
          }
        }
      },
      "audio_file": "mp3/beat-B06.mp3",
      "actual_duration_s": 17.94,
      "build": {
        "status": "VIDEO",
        "src": "media/B06.mp4",
        "filled_by": "remotion:DataLeakageVertical",
        "at": "2026-09-25T14:19:03"
      }
    },
    {
      "beat_id": "B07",
      "narration_text": "For every feature, ask: would this value genuinely exist when the prediction is made? If it was created later or derived from the outcome, it does not belong in the model as though it were known in advance.",
      "estimated_duration_s": 18,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "drawon",
        "visual_intent": "Portrait-native feature availability audit.",
        "remotion": {
          "pattern": "DataLeakageVertical",
          "props": {
            "kind": "audit"
          },
          "rendered": {
            "out": "media/B07.mp4",
            "at": "2026-09-24T17:40:00-04:00"
          }
        }
      },
      "audio_file": "mp3/beat-B07.mp3",
      "actual_duration_s": 12.35,
      "build": {
        "status": "VIDEO",
        "src": "media/B07.mp4",
        "filled_by": "remotion:DataLeakageVertical",
        "at": "2026-09-25T14:19:03"
      }
    },
    {
      "beat_id": "B08",
      "narration_text": "Leakage is not overfitting. Overfitting means the model learns its legitimate training data too specifically. Leakage means the model received information it should never have had. Both can hurt real-world generalization, but they are different problems. Strong validation performance alone does not prove leakage.",
      "estimated_duration_s": 24,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "drawon",
        "visual_intent": "Portrait-native leakage versus overfitting distinction.",
        "remotion": {
          "pattern": "DataLeakageVertical",
          "props": {
            "kind": "compare"
          },
          "rendered": {
            "out": "media/B08.mp4",
            "at": "2026-09-24T17:40:00-04:00"
          }
        }
      },
      "audio_file": "mp3/beat-B08.mp3",
      "actual_duration_s": 19.78,
      "build": {
        "status": "VIDEO",
        "src": "media/B08.mp4",
        "filled_by": "remotion:DataLeakageVertical",
        "at": "2026-09-25T14:19:03"
      }
    },
    {
      "beat_id": "B09",
      "narration_text": "An honest evaluation must preserve the same information boundary the model will face after deployment. Before asking how accurate your model is, ask whether it had access to information it would actually have in the real world.",
      "estimated_duration_s": 19,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "drawon",
        "visual_intent": "Portrait-native final information-boundary takeaway.",
        "remotion": {
