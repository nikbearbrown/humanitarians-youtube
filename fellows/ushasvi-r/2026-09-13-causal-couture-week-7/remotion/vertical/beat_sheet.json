    {
      "beat_id": "B01",
      "narration_text": "The original validation uses a row-level bootstrap. It samples eligible observations, re-estimates the effect, and repeats the process to form an empirical uncertainty distribution.",
      "estimated_duration_s": 13,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "drawon",
        "visual_intent": "Portrait-native row-bootstrap flow.",
