        "filled_by": "remotion:CausalCoutureWeek7Vertical",
        "at": "2026-09-05T16:02:46"
      }
    },
    {
      "beat_id": "B03",
      "narration_text": "Those observations may share baseline demand, popularity, engagement behavior, inventory patterns, or other product-level characteristics. Rows from the same SKU may therefore be related.",
      "estimated_duration_s": 14,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "drawon",
        "visual_intent": "Portrait-native within-SKU dependence visual.",
        "remotion": {
          "pattern": "CausalCoutureWeek7Vertical",
          "props": {
