          }
        }
      },
      "audio_file": "mp3/beat-B01.mp3",
      "actual_duration_s": 12.67,
      "build": {
        "status": "VIDEO",
        "src": "media/B01.mp4",
        "filled_by": "remotion:CausalCoutureWeek7Vertical",
        "at": "2026-09-05T16:02:46"
      }
    },
    {
      "beat_id": "B02",
      "narration_text": "But the analytical grain is date by SKU. The same product appears across multiple dates, so several observations can belong to one SKU over time.",
      "estimated_duration_s": 14,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "drawon",
        "visual_intent": "Portrait-native repeated date-by-SKU structure.",
        "remotion": {
          "pattern": "CausalCoutureWeek7Vertical",
          "props": {
            "kind": "grain"
          },
          "rendered": {
            "out": "media/B02.mp4",
            "at": "2026-09-05T16:00:00-04:00"
