        "at": "2026-09-05T16:02:46"
      }
    },
    {
      "beat_id": "B04",
      "narration_text": "This does not make row-level resampling useless or automatically wrong. It means independent row sampling may provide an incomplete uncertainty picture when observations are clustered within products.",
      "estimated_duration_s": 14,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "drawon",
        "visual_intent": "Portrait-native methodological limitation visual.",
