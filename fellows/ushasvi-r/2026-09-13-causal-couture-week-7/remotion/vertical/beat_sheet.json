    },
    {
      "beat_id": "B05",
      "narration_text": "Week 7 adds an SKU-level cluster bootstrap. Instead of sampling individual rows, it samples entire SKU clusters with replacement and retains all eligible observations belonging to each selected product.",
      "estimated_duration_s": 17,
