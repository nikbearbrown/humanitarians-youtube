      }
    },
    {
      "beat_id": "B01",
      "narration_text": "If a model says it is 90 percent confident, should it be correct about 90 percent of the time? Calibration asks whether probabilities correspond reasonably well to observed frequencies across groups of similar predictions—not whether one individual prediction is guaranteed correct.",
      "estimated_duration_s": 21,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "kinetic",
        "visual_intent": "Large 90 percent meter and group-level definition.",
        "remotion": {
          "pattern": "ModelCalibrationVertical",
          "props": {
            "kind": "definition"
          },
          "rendered": {
            "out": "media/B01.mp4",
            "at": "2026-10-16T17:57:00"
          }
        }
      },
      "audio_file": "mp3/beat-B01.mp3",
      "actual_duration_s": 17.41,
      "build": {
        "status": "VIDEO",
        "src": "media/B01.mp4",
        "filled_by": "remotion:ModelCalibrationVertical",
        "at": "2026-10-16T18:02:46"
      }
    },
    {
      "beat_id": "B02",
      "narration_text": "Prediction is what outcome the model chooses. Confidence or probability is how strongly it estimates that outcome. The chosen class and the quality of its probability are separate questions.",
      "estimated_duration_s": 15,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "branch",
        "visual_intent": "Stacked prediction versus probability cards.",
        "remotion": {
          "pattern": "ModelCalibrationVertical",
          "props": {
            "kind": "prediction"
          },
          "rendered": {
            "out": "media/B02.mp4",
            "at": "2026-10-16T17:57:00"
          }
        }
      },
      "audio_file": "mp3/beat-B02.mp3",
      "actual_duration_s": 11.86,
      "build": {
        "status": "VIDEO",
        "src": "media/B02.mp4",
        "filled_by": "remotion:ModelCalibrationVertical",
        "at": "2026-10-16T18:02:46"
      }
    },
    {
      "beat_id": "B03",
      "narration_text": "Accuracy asks how often class predictions are correct. Calibration asks whether probabilities match observed frequencies. An accurate model is not automatically calibrated, and a calibrated model is not automatically good.",
      "estimated_duration_s": 16,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "divergence",
        "visual_intent": "Vertical Accuracy not equal Calibration comparison.",
        "remotion": {
          "pattern": "ModelCalibrationVertical",
          "props": {
            "kind": "accuracy"
          },
          "rendered": {
            "out": "media/B03.mp4",
            "at": "2026-10-16T17:57:00"
          }
        }
      },
      "audio_file": "mp3/beat-B03.mp3",
      "actual_duration_s": 14.23,
      "build": {
        "status": "VIDEO",
        "src": "media/B03.mp4",
        "filled_by": "remotion:ModelCalibrationVertical",
        "at": "2026-10-16T18:02:46"
      }
    },
    {
      "beat_id": "B04",
      "narration_text": "Overconfidence means reported probabilities are higher than observed success supports. Underconfidence means the model is systematically more cautious than outcomes justify. These are conceptual patterns across many comparable predictions—not empirical results from one dataset.",
      "estimated_duration_s": 18,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "scale",
        "visual_intent": "Full-width overconfidence and underconfidence meters.",
        "remotion": {
          "pattern": "ModelCalibrationVertical",
          "props": {
            "kind": "confidence"
          },
          "rendered": {
            "out": "media/B04.mp4",
            "at": "2026-10-16T17:57:00"
          }
        }
      },
      "audio_file": "mp3/beat-B04.mp3",
      "actual_duration_s": 18.13,
      "build": {
        "status": "VIDEO",
        "src": "media/B04.mp4",
        "filled_by": "remotion:ModelCalibrationVertical",
        "at": "2026-10-16T18:02:46"
      }
    },
    {
      "beat_id": "B05",
      "narration_text": "Calibration matters because confidence can control automated decisions, human-review thresholds, prioritization, and risk-sensitive workflows. Poorly calibrated scores may route the same prediction into the wrong process.",
      "estimated_duration_s": 16,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "threshold",
        "visual_intent": "Decision-routing grid and human-review threshold.",
        "remotion": {
          "pattern": "ModelCalibrationVertical",
          "props": {
            "kind": "stakes"
          },
          "rendered": {
            "out": "media/B05.mp4",
            "at": "2026-10-16T17:57:00"
          }
        }
      },
      "audio_file": "mp3/beat-B05.mp3",
      "actual_duration_s": 14.74,
      "build": {
        "status": "VIDEO",
        "src": "media/B05.mp4",
        "filled_by": "remotion:ModelCalibrationVertical",
        "at": "2026-10-16T18:02:46"
      }
    },
    {
      "beat_id": "B06",
      "narration_text": "A reliability diagram groups predictions into probability bins, such as 60, 70, 80, and 90 percent. Within each group, compare average predicted probability with observed outcome frequency.",
      "estimated_duration_s": 16,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "isotype",
        "visual_intent": "Stacked probability-bin framework.",
        "remotion": {
          "pattern": "ModelCalibrationVertical",
          "props": {
            "kind": "bins"
          },
          "rendered": {
            "out": "media/B06.mp4",
            "at": "2026-10-16T17:57:00"
          }
        }
      },
      "audio_file": "mp3/beat-B06.mp3",
      "actual_duration_s": 13.87,
      "build": {
        "status": "VIDEO",
        "src": "media/B06.mp4",
        "filled_by": "remotion:ModelCalibrationVertical",
        "at": "2026-10-16T18:02:46"
      }
    },
    {
      "beat_id": "B07",
      "narration_text": "Better alignment indicates better calibration within the evaluated data. The diagonal is a reference, not a demand for perfect alignment. Finite samples fluctuate, and even perfect calibration would not eliminate uncertainty.",
      "estimated_duration_s": 17,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "drawon",
        "visual_intent": "Phone-readable portrait reliability diagram.",
        "remotion": {
          "pattern": "ModelCalibrationVertical",
          "props": {
            "kind": "diagram"
          },
