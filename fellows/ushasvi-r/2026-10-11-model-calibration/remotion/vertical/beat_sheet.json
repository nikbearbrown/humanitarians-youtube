      "actual_duration_s": 15.0,
      "build": {
        "status": "VIDEO",
        "src": "media/B07.mp4",
        "filled_by": "remotion:ModelCalibrationVertical",
        "at": "2026-10-16T18:02:46"
      }
    },
    {
      "beat_id": "B08",
      "narration_text": "Calibration can change across datasets, time periods, subgroups, and deployment environments. Platt scaling, isotonic regression, and temperature scaling are recalibration examples; none is universally best. And calibration remains distinct from classification or discrimination performance.",
      "estimated_duration_s": 20,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "flow",
        "visual_intent": "Monitoring factors, recalibration examples, and distinction.",
        "remotion": {
          "pattern": "ModelCalibrationVertical",
          "props": {
            "kind": "monitor"
          },
          "rendered": {
            "out": "media/B08.mp4",
            "at": "2026-10-16T17:57:00"
          }
        }
      },
      "audio_file": "mp3/beat-B08.mp3",
      "actual_duration_s": 19.65,
      "build": {
        "status": "VIDEO",
        "src": "media/B08.mp4",
        "filled_by": "remotion:ModelCalibrationVertical",
        "at": "2026-10-16T18:02:46"
      }
    },
    {
      "beat_id": "B09",
      "narration_text": "A prediction tells you what the model thinks will happen. Calibration tells you how much you should trust the probability attached to that prediction.",
      "estimated_duration_s": 12,
      "shot": {
