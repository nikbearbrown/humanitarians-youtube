    },
    {
      "beat_id": "B05",
      "narration_text": "Simpson’s Paradox occurs when a trend in aggregated data changes, disappears, or reverses after the data is separated into meaningful groups.",
      "estimated_duration_s": 14,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
