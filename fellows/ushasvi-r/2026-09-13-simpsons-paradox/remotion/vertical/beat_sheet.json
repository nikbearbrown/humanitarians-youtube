      "beat_id": "B04",
      "narration_text": "Overall, A appears stronger. Within high-intent customers, B is stronger. Within low-intent customers, B is stronger again. This reversal is a classic example of Simpson’s Paradox.",
      "estimated_duration_s": 16,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "drawon",
        "visual_intent": "Stacked portrait aggregate-versus-subgroup reversal.",
