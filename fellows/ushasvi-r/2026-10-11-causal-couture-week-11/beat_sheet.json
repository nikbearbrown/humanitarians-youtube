        "status": "VIDEO",
        "src": "media/B09.mp4",
        "filled_by": "remotion:CausalCoutureWeek11",
        "at": "2026-10-14T15:20:19"
      }
    },
    {
      "beat_id": "B10",
      "narration_text": "A positive primary estimate may coexist with an unexpected impossible-direction temporal relationship. That creates methodological caution around residual structure or confounding. A placebo calculation that executed successfully did not automatically pass.",
      "estimated_duration_s": 24,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "drawon",
        "visual_intent": "Primary estimate and temporal-placebo tension.",
        "remotion": {
          "pattern": "CausalCoutureWeek11",
          "props": {
            "kind": "placebo"
          },
          "rendered": {
            "out": "media/B10.mp4",
            "at": "2026-10-14T15:00:00"
          }
        }
      },
      "audio_file": "mp3/beat-B10.mp3",
      "actual_duration_s": 16.66,
      "build": {
        "status": "VIDEO",
        "src": "media/B10.mp4",
        "filled_by": "remotion:CausalCoutureWeek11",
        "at": "2026-10-14T15:20:19"
      }
    },
    {
      "beat_id": "B11",
      "narration_text": "An estimate can remain stable across observed-control models while changing direction under hypothetical confounding pressure. These tests examine different vulnerabilities. A synthetic direction change is a warning, not evidence that the hypothetical confounder exists.",
      "estimated_duration_s": 24,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "drawon",
        "visual_intent": "Robustness and sensitivity comparison.",
        "remotion": {
          "pattern": "CausalCoutureWeek11",
          "props": {
            "kind": "sensitivity"
          },
          "rendered": {
            "out": "media/B11.mp4",
            "at": "2026-10-14T15:00:00"
          }
        }
      },
      "audio_file": "mp3/beat-B11.mp3",
      "actual_duration_s": 15.59,
      "build": {
        "status": "VIDEO",
        "src": "media/B11.mp4",
        "filled_by": "remotion:CausalCoutureWeek11",
        "at": "2026-10-14T15:20:19"
      }
    },
    {
      "beat_id": "B12",
      "narration_text": "A favorable estimate may remain difficult to interpret when inventory suppresses observed sales or treatment variation is insufficient for meaningful comparison. Inventory and overlap limitations belong beside the estimate, not in footnotes.",
      "estimated_duration_s": 21,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "drawon",
        "visual_intent": "Estimate with visible inventory and overlap warnings.",
        "remotion": {
          "pattern": "CausalCoutureWeek11",
          "props": {
