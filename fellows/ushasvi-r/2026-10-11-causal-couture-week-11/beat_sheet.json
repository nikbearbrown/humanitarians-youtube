      "audio_file": "mp3/beat-B12.mp3",
      "actual_duration_s": 15.04,
      "build": {
        "status": "VIDEO",
        "src": "media/B12.mp4",
        "filled_by": "remotion:CausalCoutureWeek11",
        "at": "2026-10-14T15:20:19"
      }
    },
    {
      "beat_id": "B13",
      "narration_text": "Week 11 proposes three qualitative readiness categories. Insufficient Evidence for Action calls for data and execution investigation. Analyst Review Required covers conflicts, sensitivity, overlap, or inventory concerns. Exploratory Interpretation Only means no major concern appeared within scope, but the estimate remains observational. No automated classifier or endpoint was implemented.",
      "estimated_duration_s": 34,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "drawon",
        "visual_intent": "Three large proposed readiness cards.",
        "remotion": {
          "pattern": "CausalCoutureWeek11",
          "props": {
            "kind": "readiness"
          },
          "rendered": {
            "out": "media/B13.mp4",
            "at": "2026-10-14T15:00:00"
          }
        }
      },
      "audio_file": "mp3/beat-B13.mp3",
      "actual_duration_s": 24.55,
      "build": {
        "status": "VIDEO",
        "src": "media/B13.mp4",
        "filled_by": "remotion:CausalCoutureWeek11",
        "at": "2026-10-14T15:20:19"
      }
    },
    {
      "beat_id": "B14",
      "narration_text": "This framework does not automatically authorize inventory purchases, advertising-spend changes, or pricing decisions. Those choices also require validation, business constraints, cost-benefit analysis, and operational context.",
      "estimated_duration_s": 20,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "drawon",
        "visual_intent": "Full-frame operational decision warning.",
        "remotion": {
