      "audio_file": "mp3/beat-B14.mp3",
      "actual_duration_s": 14.66,
      "build": {
        "status": "VIDEO",
        "src": "media/B14.mp4",
        "filled_by": "remotion:CausalCoutureWeek11",
        "at": "2026-10-14T15:20:19"
      }
    },
    {
      "beat_id": "B15",
      "narration_text": "Three analytical modes remain distinct. Descriptive analytics asks what patterns are visible. Scenario simulation asks what happens under modeled conditions. Observational causal estimation asks what effect is estimated under assumptions and available controls. They are not interchangeable.",
      "estimated_duration_s": 23,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "drawon",
        "visual_intent": "Three-mode analytical comparison.",
        "remotion": {
          "pattern": "CausalCoutureWeek11",
          "props": {
            "kind": "modes"
          },
          "rendered": {
            "out": "media/B15.mp4",
            "at": "2026-10-14T15:00:00"
          }
        }
      },
      "audio_file": "mp3/beat-B15.mp3",
      "actual_duration_s": 17.58,
