    {
      "beat_id": "B04",
      "act": "SECURITY",
      "role_note": "Agent hooks as event-action pairs, plus a security tool integration.",
      "narration_text": "Hooks automate the checks. A hook is an event and an action: the editor watches for something, then responds on its own. Save a file, and it runs a security scan. Save, and it runs your tests. And tools like Checkmarx plug in, flagging security issues as you write.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 16.9,
