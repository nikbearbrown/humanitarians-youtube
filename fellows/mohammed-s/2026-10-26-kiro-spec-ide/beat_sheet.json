    {
      "beat_id": "B02",
      "act": "MECHANISM",
      "role_note": "Prompt-only vs spec-first: the same request handed to both.",
      "narration_text": "Ask a prompt-only tool for password reset and you get two hundred lines of code \u2014 and you find the edge cases later. Kiro takes the same request and writes requirements first, then a design, then a task list. Only then does it code, one task at a time.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 16.9,
