    {
      "beat_id": "B07",
      "act": "PROOF",
      "role_note": "Falsifiability beat: the three checks that enforce 'don't touch business or UI'.",
      "narration_text": "Verify is three checks. A diff guard reads every change inside the protected paths. An import, an annotation, a namespace: allowed. Anything else, like this flipped comparison, fails the run. Then the baseline tests rerun, and are compared one by one. Then the app deploys to the target server in a container, and its screenshots are compared with the baseline.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 19.4,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "reveal",
        "show": [
          {
            "at": "0.213",
            "event": "hunk 1: javax \u2192 jakarta import, ticks 'allowed'"
          },
