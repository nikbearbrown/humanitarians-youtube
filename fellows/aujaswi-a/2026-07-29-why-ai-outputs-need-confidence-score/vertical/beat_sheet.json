    {
      "beat_id": "B01",
      "act": "overview",
      "narration_text": "Most AI tools return one answer with no sense of how sure the system actually is. That is not a small omission, it is a design flaw.",
      "voice": "af_bella",
      "engine": "kokoro",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "remotion": {
          "pattern": "ClaudeComposerAsk916",
          "props": {
            "greeting": "",
            "topic": "MEDHAVY · STEM/AI",
            "segment": "The Problem",
            "command": "Why isn't a single answer enough?",
            "runningText": "thinking it through…",
            "folderLabel": "@HumanitariansAI",
            "output": [
              "No confidence signal means no way to judge the answer."
            ],
            "largeText": true
          },
          "rendered": {
            "out": "media/B01.mp4",
            "at": "2026-09-24T18:08:52.400537+00:00"
          }
