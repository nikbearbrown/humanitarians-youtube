    {
      "beat_id": "B01",
      "act": "overview",
      "narration_text": "I built a multi command system prompt that walks people through idea capture, conflict checking, and scoping questions before any tool gets built.",
      "voice": "af_bella",
      "engine": "kokoro",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "remotion": {
          "pattern": "ClaudeComposerAsk",
          "props": {
            "greeting": "",
            "topic": "MEDHAVY · STEM/AI",
            "segment": "The Build",
            "command": "What did you actually build?",
            "runningText": "thinking it through…",
            "folderLabel": "@HumanitariansAI",
            "output": [
              "A structured workflow, not a single vague prompt."
            ]
          },
          "rendered": {
            "out": "media/B01.mp4",
            "at": "2026-09-24T18:21:30.851892+00:00"
          }
