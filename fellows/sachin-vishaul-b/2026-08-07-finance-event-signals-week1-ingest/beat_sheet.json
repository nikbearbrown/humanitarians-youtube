      "beat_id": "B03",
      "act": "code (initial)",
      "narration_text": "The generated client sets Accept-Encoding to gzip by hand — looks careful, and it's wrong. Go's own transport already negotiates compression; a manual header just disables the automatic decode.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 12,
      "shot": {
        "type": "REMOTION",
        "remotion": {
          "pattern": "GitHubCodeViewer",
          "props": {
            "path": [
              "finance-event-signals",
              "services",
              "ingest-gateway",
              "secclient.go"
            ],
            "branch": "master",
            "lang": "go",
            "lines": [
              "func (c *secClient) Get(ctx context.Context, url string) ([]byte, int, error) {",
              "\treq, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)",
              "\treq.Header.Set(\"User-Agent\", c.ua)",
              "\treq.Header.Set(\"Accept-Encoding\", \"gzip, deflate\")",
              "\tresp, err := c.http.Do(req)"
            ],
            "caption": "Sets Accept-Encoding by hand — disables Go's automatic gzip decode."
          },
          "rendered": {
            "out": "media/B03.mp4",
            "at": ""
          }
        }
      },
