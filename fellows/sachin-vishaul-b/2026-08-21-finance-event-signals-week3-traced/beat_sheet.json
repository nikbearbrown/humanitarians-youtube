    {
      "beat_id": "B03",
      "act": "code",
      "narration_text": "recordCarrier reads and writes the record's own headers. ProduceSpan injects the context on the way out; ConsumeSpan extracts it on the way in and starts a linked child span.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 13,
      "shot": {
        "type": "REMOTION",
        "remotion": {
          "pattern": "GitHubCodeViewer",
          "props": {
            "path": [
              "finance-event-signals",
              "services",
              "common",
              "kafka.go"
            ],
            "branch": "master",
            "lang": "go",
            "lines": [
              "type recordCarrier struct{ rec *kgo.Record }",
              "func ProduceSpan(ctx context.Context, tr trace.Tracer, name string, rec *kgo.Record) (context.Context, trace.Span) {",
              "\tctx, span := tr.Start(ctx, name, trace.WithSpanKind(trace.SpanKindProducer))",
              "\totel.GetTextMapPropagator().Inject(ctx, recordCarrier{rec})",
              "\treturn ctx, span",
              "}"
            ],
            "caption": "The record's own headers are the only channel trace context has across a Kafka topic."
          },
          "rendered": {
            "out": "media/B03.mp4",
            "at": ""
          }
        }
      },
