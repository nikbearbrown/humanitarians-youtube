    {
      "beat_id": "B02",
      "act": "PROBLEM",
      "narration_text": "Start with the problem. A language model answers from patterns it absorbed during training. It has never seen your syllabus, your company handbook, or a policy that changed last month. Ask anyway, and it may still answer, fluently and wrong. Fluent isn't the same as correct.",
      "voice": "af_bella",
      "engine": "kokoro",
      "speed": 0.95,
      "estimated_duration_s": 17,
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "remotion": {
          "pattern": "RagTwoAnswers916",
          "props": {
            "question": "Can I submit Lab 3 late?",
            "spark": "Fluent isn't correct.",
            "leftLabel": "From memory",
            "leftAnswer": "Yes. Late labs are accepted for up to one week with no penalty.",
            "stamp": "no source",
            "stampAt": 0.7526,
            "rightLabel": "With retrieval",
            "footnote": "The “from memory” answer is invented on purpose, to show the failure.",
            "durationSeconds": 18.23,
            "footnoteShort": "Invented answer, on purpose."
          },
          "rendered": {
            "out": "media/B02.mp4",
            "at": "2026-11-06T18:21:05.106055+00:00"
          }
        }
      },
      "audio_file": "mp3/beat-B02.mp3",
      "actual_duration_s": 17.83,
