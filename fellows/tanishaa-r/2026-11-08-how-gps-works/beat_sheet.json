            "command": "How does GPS know where I am?",
            "runningText": "thinking…",
            "output": [
              "Your phone listens to satellites,",
              "times their signals,",
              "and works out where it must be."
            ],
            "folderLabel": "@HumanitariansAI",
            "modelLabel": "Claude",
