  "beats": [
    {
      "beat_id": "B00",
      "act": "ASK",
      "narration_text": "Hi, I am Tanishaa, and this video is about how GPS knows where you are. The voice you're hearing is Bella, an AI narrator reading a script Claude drafted and I approved.",
      "voice": "af_bella",
      "engine": "kokoro",
      "speed": 0.95,
      "estimated_duration_s": 13,
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "remotion": {
