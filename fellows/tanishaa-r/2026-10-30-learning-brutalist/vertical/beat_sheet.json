      "beat_id": "B01",
      "act": "FRAMEWORK",
      "narration_text": "Brutalist builds a video in steps. Every video starts as a beat sheet, one entry for each moment. The narration is generated first, and its measured length becomes the clock that every picture is timed to.",
      "voice": "af_bella",
      "engine": "kokoro",
      "speed": 0.95,
      "estimated_duration_s": 16,
      "shot": {
