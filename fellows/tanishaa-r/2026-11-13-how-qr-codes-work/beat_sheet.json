    {
      "beat_id": "B05",
      "act": "FRAMEWORK",
      "narration_text": "Here's the trick. A QR code carries more than your message. It also carries extra recovery data, worked out with a bit of math called Reed-Solomon, the same idea that lets a scratched CD keep playing. There are four levels. The lowest can recover about seven percent of the code. The highest, about thirty.",
      "voice": "af_bella",
      "engine": "kokoro",
      "speed": 0.95,
      "estimated_duration_s": 20,
      "shot": {
