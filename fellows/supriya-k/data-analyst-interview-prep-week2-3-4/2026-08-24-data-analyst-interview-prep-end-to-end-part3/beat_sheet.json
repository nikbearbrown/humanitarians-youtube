    {
      "beat_id": "B03",
      "act": "FAILURE-MODE",
      "narration_text": "Here's where it breaks. The common failure is all Situation, no Result: candidates set up the scene and never say what happened. The Result is the point. If your story doesn't land on an outcome, you haven't used STAR. You've just narrated.",
      "voice": "af_bella",
      "engine": "kokoro",
      "estimated_duration_s": 16,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "StateCardPair",
          "props": {
            "sparkLine": "All Situation, no Result.",
            "cards": [
              {
                "label": "Situation",
                "detail": "filled in",
                "accent": "TEAL"
              },
              {
                "label": "Task",
                "detail": "filled in",
                "accent": "TEAL"
              },
              {
                "label": "Action",
                "detail": "filled in",
                "accent": "TEAL"
              },
              {
                "label": "Result",
