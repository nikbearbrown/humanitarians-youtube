    {
      "beat_id": "B01",
      "act": "METHOD",
      "narration_text": "STAR is how interviewers evaluate answers to behavioral and situational questions. Situation sets the scene, briefly. Task names your objective. Action is what you did, and why — not \"we.\" Result is the outcome, quantified where possible, plus what you learned.",
      "voice": "af_bella",
      "engine": "kokoro",
      "estimated_duration_s": 17,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "StateCardPair",
          "props": {
            "sparkLine": "One structure, four parts.",
            "cards": [
              {
                "label": "Situation",
                "detail": "the scenario, brief",
                "accent": "SLATE"
              },
              {
                "label": "Task",
                "detail": "your objective",
                "accent": "SLATE"
              },
              {
                "label": "Action",
                "detail": "what YOU did — not \"we\"",
                "accent": "SLATE"
              },
              {
                "label": "Result",
                "detail": "outcome, quantified + learned",
                "accent": "TEAL"
              }
            ],
            "scale": 1.3,
            "handle": "Supriya"
          },
          "rendered": {
            "out": "media/B01.mp4",
            "at": ""
          }
        },
        "show": [
          {
            "at": "0%",
            "event": "four SLATE cards build left to right, one per narrated word: S, T, A"
          },
          {
            "at": "on \"Result\"",
            "event": "the fourth card locks in TEAL, distinct from the other three"
          }
        ]
      },
      "audio_file": "mp3/beat-B01.mp3",
      "actual_duration_s": 17.11,
      "build": {
        "status": "VIDEO",
        "src": "media/B01.mp4",
        "filled_by": "media",
        "at": "2026-10-16T10:47:22"
      }
    },
