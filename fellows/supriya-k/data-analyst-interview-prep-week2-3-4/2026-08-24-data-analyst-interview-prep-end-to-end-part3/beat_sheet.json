      "engine": "kokoro",
      "estimated_duration_s": 18,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "LabelChip",
          "props": {
            "sparkLine": "Behavioral + situational.",
            "chips": [
              "conflict",
              "time management",
              "problem-solving",
              "interpersonal skills"
            ],
            "footer": "“tell me about a time…”",
            "scale": 1.6,
            "handle": "Supriya"
          },
          "rendered": {
            "out": "media/B02.mp4",
            "at": ""
          }
        },
        "show": [
