    {
      "beat_id": "B00",
      "act": "PROBLEM",
      "narration_text": "A sudden traffic spike can send thousands of jobs to a service at once. If every job must be processed immediately, the service can become overwhelmed.",
      "visual_intent": "A burst of jobs converges on one service.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "annotate"
      },
      "estimated_duration_s": 7,
      "voice": "am_onyx",
      "engine": "kokoro",
      "voice_kokoro": "am_onyx",
      "actual_duration_s": 9.28,
      "audio_file": "mp3/beat-B00.mp3",
      "render_duration_s": 9.291666666666666,
      "build": {
        "status": "MANIM",
        "src": "manim\\B00.mp4",
        "filled_by": "manim",
        "at": "2026-10-15T00:21:40"
      }
    },
    {
      "beat_id": "B01",
      "act": "PROBLEM",
      "narration_text": "When incoming work arrives faster than a service can process it, requests pile up, response times increase, and failures can follow.",
      "visual_intent": "Pending work accumulates in front of an overloaded service.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "annotate"
      },
      "estimated_duration_s": 7,
      "voice": "am_onyx",
      "engine": "kokoro",
      "voice_kokoro": "am_onyx",
      "actual_duration_s": 7.66,
      "audio_file": "mp3/beat-B01.mp3",
      "render_duration_s": 7.666666666666667,
      "build": {
        "status": "MANIM",
        "src": "manim\\B01.mp4",
        "filled_by": "manim",
        "at": "2026-10-15T00:21:40"
      }
    },
    {
      "beat_id": "B02",
      "act": "SOLUTION",
      "narration_text": "A message queue adds a buffer between the system producing work and the system processing it.",
      "visual_intent": "Producer, message queue, and consumer are separated into a buffered architecture.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "annotate"
      },
      "estimated_duration_s": 5,
      "voice": "am_onyx",
      "engine": "kokoro",
      "voice_kokoro": "am_onyx",
      "actual_duration_s": 5.53,
      "audio_file": "mp3/beat-B02.mp3",
      "render_duration_s": 5.541666666666667,
      "build": {
        "status": "MANIM",
        "src": "manim\\B02.mp4",
        "filled_by": "manim",
        "at": "2026-10-15T00:21:40"
      },
      "qc": {
        "sparse_by_design": true,
        "sparse_reason": "Intentional architecture diagram with open space separating producer, queue, and consumer components."
      }
    },
    {
      "beat_id": "B03",
      "act": "PRODUCER",
      "narration_text": "Instead of waiting for every job to finish, producers place messages onto the queue so the work can be processed asynchronously.",
      "visual_intent": "Producer publishes messages into the queue and moves on.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "annotate"
      },
      "estimated_duration_s": 7,
      "voice": "am_onyx",
      "engine": "kokoro",
      "voice_kokoro": "am_onyx",
      "actual_duration_s": 7.36,
      "audio_file": "mp3/beat-B03.mp3",
      "render_duration_s": 7.375,
      "build": {
        "status": "MANIM",
        "src": "manim\\B03.mp4",
        "filled_by": "manim",
        "at": "2026-10-15T00:21:40"
      },
      "qc": {
        "sparse_by_design": true,
        "sparse_reason": "Intentional architecture diagram with open space used to show asynchronous message flow clearly."
      }
    },
    {
      "beat_id": "B04",
      "act": "CONSUMER",
      "narration_text": "Consumers pull messages from the queue at a rate they can safely handle, smoothing the flow of work.",
      "visual_intent": "Messages flow from the queue toward a consumer at a controlled rate.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "annotate"
      },
      "estimated_duration_s": 6,
      "voice": "am_onyx",
      "engine": "kokoro",
      "voice_kokoro": "am_onyx",
      "actual_duration_s": 5.87,
      "audio_file": "mp3/beat-B04.mp3",
      "render_duration_s": 5.875,
      "build": {
        "status": "MANIM",
        "src": "manim\\B04.mp4",
        "filled_by": "manim",
        "at": "2026-10-15T00:21:40"
      },
      "qc": {
        "sparse_by_design": true,
        "sparse_reason": "Intentional architecture diagram with open space used to show controlled consumer processing clearly."
      }
    },
    {
      "beat_id": "B05",
      "act": "BUFFER",
      "narration_text": "During a traffic spike, the queue absorbs the backlog. Messages wait there instead of overwhelming the consumers all at once.",
      "visual_intent": "A backlog remains buffered inside the queue while the consumer receives a steady flow.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "annotate"
      },
      "estimated_duration_s": 7,
      "voice": "am_onyx",
      "engine": "kokoro",
      "voice_kokoro": "am_onyx",
      "actual_duration_s": 7.27,
      "audio_file": "mp3/beat-B05.mp3",
      "render_duration_s": 7.291666666666667,
      "build": {
        "status": "MANIM",
        "src": "manim\\B05.mp4",
        "filled_by": "manim",
        "at": "2026-10-15T00:21:40"
      },
      "qc": {
        "sparse_by_design": true,
        "sparse_reason": "Intentional architecture diagram with open space around the queue to make the buffered backlog visually clear."
      }
    },
    {
      "beat_id": "B06",
      "act": "SCALE",
      "narration_text": "If the workload keeps growing, more consumers can be added to process messages in parallel and increase throughput.",
      "visual_intent": "One queue distributes work across multiple consumers.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "annotate"
      },
      "estimated_duration_s": 6,
      "voice": "am_onyx",
      "engine": "kokoro",
