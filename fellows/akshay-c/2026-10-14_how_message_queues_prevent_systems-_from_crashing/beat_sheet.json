        "src": "manim\\B06.mp4",
        "filled_by": "manim",
        "at": "2026-10-15T00:21:40"
      }
    },
    {
      "beat_id": "B07",
      "act": "PAYOFF",
      "narration_text": "Message queues decouple producers from consumers, absorb traffic spikes, and help services stay responsive under heavy load.",
      "visual_intent": "Complete producer to queue to consumers architecture with the main benefits summarized.",
