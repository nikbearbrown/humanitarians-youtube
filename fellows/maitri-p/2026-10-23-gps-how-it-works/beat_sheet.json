                "text": "can block signals entirely"
              },
              {
                "tag": "RESULT",
                "text": "accuracy varies from place to place"
              }
            ],
            "footer": "A bounced signal arrives late, so the distance looks longer",
            "sparkLine": "Open sky works best."
          },
