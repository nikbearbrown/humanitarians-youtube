    {
      "beat_id": "B04",
      "act": "MATH",
      "narration_text": "That's why timing must be so precise. Radio travels about three hundred thousand kilometres a second, so an error of one millionth of a second means about three hundred metres.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "TypesetMath",
          "props": {
            "title": "Why timing matters",
            "rows": [
              {
                "src": "data:image/svg+xml;base64,",
                "aspect": 5.6,
                "expression": "d = c \\times \\Delta t",
                "at": 1.0
              },
              {
                "src": "data:image/svg+xml;base64,",
                "aspect": 7.1591,
                "expression": "10^{-6}\\ \\mathrm{s} \\rightarrow 300\\ \\mathrm{m}",
                "at": 5.5
              }
            ],
            "note": "d: distance · c: speed of radio · Δt: delay",
            "conditions": "One millionth of a second wrong ≈ 300 metres wrong"
          },
          "rendered": {
            "out": "media/B04.mp4",
            "at": "2026-10-23T23:57:57.871929+00:00"
          }
        },
        "show": [
          {
            "at": 0.1,
            "event": "d = c × Δt"
          },
          {
            "at": 0.45,
            "event": "1 µs → 300 m"
          }
        ]
      },
      "estimated_duration_s": 11,
      "audio_file": "mp3/beat-B04.mp3",
      "engine": "kokoro",
      "voice": "af_bella",
      "actual_duration_s": 11.22
    },
    {
      "beat_id": "B05",
      "act": "LIMITS",
      "narration_text": "Tall buildings and tunnels can block signals, or bounce them, which throws off the delay. So accuracy varies from place to place.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "LessonExcerpt",
          "props": {
            "header": "Why accuracy varies",
            "subheader": "",
            "rows": [
              {
