    {
      "beat_id": "B02",
      "act": "SIGNAL",
      "narration_text": "GPS satellites constantly broadcast two things: the exact time, and where they are. Radio signals travel at a known speed, so the delay between sending and hearing tells your phone how far away each satellite is.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "AgentToolLoop",
          "props": {
            "stages": [
              "TIME + POSITION",
              "SIGNAL TRAVELS",
              "PHONE LISTENS",
              "DELAY = DISTANCE"
            ],
            "executeIndex": 3,
            "loopBack": false,
            "ports": [],
            "sparkLine": "Delay becomes distance."
          },
          "rendered": {
            "out": "media/B02.mp4",
            "at": "2026-10-23T23:54:29.145310+00:00"
          }
        },
        "show": [
          {
            "at": 0.05,
            "event": "stages light in narration order"
          }
        ]
      },
      "estimated_duration_s": 13,
      "audio_file": "mp3/beat-B02.mp3",
      "engine": "kokoro",
      "voice": "af_bella",
      "actual_duration_s": 14.29
    },
    {
      "beat_id": "B03",
      "act": "CIRCLES",
      "narration_text": "One satellite tells you you're somewhere on a circle. A second circle narrows it to two spots. A third pins down the one point where they all overlap, and a fourth satellite corrects your phone's less precise clock.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "Trilateration",
          "props": {
            "caption": "+ a fourth satellite corrects the phone's clock",
            "sparkLine": "Where the circles meet."
          },
          "rendered": {
            "out": "media/B03.mp4",
            "at": "2026-10-24T01:26:15.428944+00:00"
          }
        },
        "show": [
          {
            "at": 0.05,
            "event": "circle 1"
          },
          {
            "at": 0.3,
            "event": "circle 2, two candidate points"
          },
          {
