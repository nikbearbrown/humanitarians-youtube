      "voice": "af_bella",
      "actual_duration_s": 7.81
    },
    {
      "beat_id": "B01",
      "act": "BLUF",
      "narration_text": "Your phone doesn't tell the satellites anything. It only listens, and works out its position from what it hears.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "type-on",
        "remotion": {
          "pattern": "BrutalistHesitantWriter",
          "props": {
            "text": "Your phone sends its location to satellites.\nIt works it out by itself.",
            "triggerWords": "sends its location to",
            "replacementWords": "only listens to",
            "face": "serif",
            "fontSize": 62,
            "lineSpacing": 1.25,
            "align": "center",
            "seed": "gps-how-it-works-b01",
            "ink": "#3D3929",
