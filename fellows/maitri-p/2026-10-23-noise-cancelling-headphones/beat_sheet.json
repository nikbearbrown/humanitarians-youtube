  "beats": [
    {
      "beat_id": "B00",
      "act": "ASK",
      "narration_text": "Hi, I am Maitri and this video is about why noise-cancelling headphones work. How can headphones make things quieter by playing more sound?",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "type-on",
        "remotion": {
          "pattern": "ClaudeComposerAsk",
          "props": {
            "greeting": "Ciao, HAI",
            "topic": "Irreducibly Human",
            "segment": "Noise-Cancelling",
            "command": "How can headphones make things quieter by playing more sound?",
            "runningText": "listening to the waves…",
            "folderLabel": "@HumanitariansAI",
            "output": [
              "by adding the opposite sound",
              "quieter at your ear, not silence"
            ]
          },
          "rendered": {
            "out": "media/B00.mp4",
            "at": "2026-10-23T21:19:56.693400+00:00"
          }
        }
      },
      "estimated_duration_s": 9,
      "audio_file": "mp3/beat-B00.mp3",
      "engine": "kokoro",
      "voice": "af_bella",
      "actual_duration_s": 8.6
    },
    {
      "beat_id": "B01",
      "act": "BLUF",
      "narration_text": "Noise-cancelling headphones don't just block sound. They add an opposite sound, so the noise you hear gets quieter. Not silent. Quieter.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "type-on",
        "remotion": {
          "pattern": "BrutalistHesitantWriter",
          "props": {
            "text": "Noise-cancelling headphones block sound.\nThe noise at your ear gets quieter.",
            "triggerWords": "block sound",
            "replacementWords": "add opposite sound",
            "face": "serif",
            "fontSize": 64,
            "lineSpacing": 1.25,
            "align": "center",
            "seed": "noise-cancelling-b01",
            "ink": "#3D3929",
            "accent": "#D97757",
            "bg": "#F2F0E9"
          },
          "rendered": {
            "out": "media/B01.mp4",
            "at": "2026-10-23T21:21:54.915152+00:00"
          }
        },
        "show": [
          {
            "at": 0.0,
            "event": "writer types 'block sound'"
          },
          {
            "at": 0.5,
            "event": "corrected to 'add opposite sound'"
          }
        ]
      },
      "estimated_duration_s": 10,
      "audio_file": "mp3/beat-B01.mp3",
      "engine": "kokoro",
      "voice": "af_bella",
      "lead_silence_s": 0.8,
      "actual_duration_s": 8.94
    },
    {
      "beat_id": "B02",
      "act": "FRAMEWORK",
      "narration_text": "Sound reaches your ears as tiny changes in air pressure: a little higher, then a little lower. That repeating pattern is a sound wave.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "WaveCancel",
          "props": {
            "phase": "pressure",
            "sparkLine": "Sound is a pressure wave."
          },
          "rendered": {
            "out": "media/B02.mp4",
            "at": "2026-10-23T21:23:05.918184+00:00"
          }
        },
        "show": [
          {
            "at": 0.05,
            "event": "wave draws and travels"
          },
          {
            "at": 0.4,
            "event": "higher / lower pressure labels"
          }
        ]
      },
      "estimated_duration_s": 10,
      "audio_file": "mp3/beat-B02.mp3",
      "engine": "kokoro",
      "voice": "af_bella",
      "actual_duration_s": 8.58
    },
    {
      "beat_id": "B03",
      "act": "MECHANISM",
      "narration_text": "A microphone on the headphones picks up the outside noise. The headphones then play a sound with the opposite pressure changes: high where the noise is low. When the two meet at your ear, they mostly cancel out.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "WaveCancel",
          "props": {
            "phase": "cancel",
            "sparkLine": "Opposite waves, smaller result."
          },
          "rendered": {
            "out": "media/B03.mp4",
            "at": "2026-10-23T21:24:20.918669+00:00"
          }
        },
        "show": [
          {
            "at": 0.04,
            "event": "outside noise wave"
          },
          {
            "at": 0.28,
            "event": "opposite wave, flipped"
          },
          {
            "at": 0.55,
            "event": "their computed sum: a much smaller wave, not a flat line"
          }
        ]
      },
      "estimated_duration_s": 15,
      "audio_file": "mp3/beat-B03.mp3",
      "engine": "kokoro",
      "voice": "af_bella",
      "actual_duration_s": 12.93
    },
    {
      "beat_id": "B04",
      "act": "PATH",
      "narration_text": "Follow the path: outside noise, to the microphone, to the speaker inside the cup, to your ear. This happens at your ear only. The room stays just as loud.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "AgentToolLoop",
          "props": {
            "stages": [
              "OUTSIDE NOISE",
              "MICROPHONE",
              "SPEAKER",
              "YOUR EAR"
            ],
            "executeIndex": 2,
            "loopBack": false,
            "ports": [],
            "sparkLine": "Quieter at your ear, not the room."
          },
          "rendered": {
            "out": "media/B04.mp4",
            "at": "2026-10-23T21:25:29.342432+00:00"
          }
        },
        "show": [
          {
            "at": 0.05,
            "event": "stages light in narration order"
          }
        ]
      },
      "estimated_duration_s": 11,
      "audio_file": "mp3/beat-B04.mp3",
      "engine": "kokoro",
      "voice": "af_bella",
      "actual_duration_s": 9.75
    },
    {
      "beat_id": "B05",
      "act": "MATH",
      "narration_text": "In numbers: the pressure at your ear is the noise plus the opposite sound. Make the opposite sound close to minus the noise, and what reaches you becomes much smaller, though not zero.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "TypesetMath",
          "props": {
            "title": "What reaches your ear",
            "rows": [
              {
                "src": "data:image/svg+xml;base64,",
                "aspect": 9.3514,
                "expression": "p_{\\mathrm{ear}} = p_{\\mathrm{noise}} + p_{\\mathrm{anti}}",
                "at": 1.0
              },
              {
                "src": "data:image/svg+xml;base64,",
                "aspect": 8.697,
                "expression": "p_{\\mathrm{anti}} \\approx -\\,p_{\\mathrm{noise}}",
                "at": 4.5
              },
              {
                "src": "data:image/svg+xml;base64,",
                "aspect": 6.2326,
                "expression": "|p_{\\mathrm{ear}}| \\ll |p_{\\mathrm{noise}}|",
                "at": 8.0
              }
            ],
            "note": "p: air pressure change · much smaller, not zero",
            "conditions": "In the animation, an opposite wave 12% too weak and slightly mistimed still leaves about 24% of the noise"
          },
          "rendered": {
            "out": "media/B05.mp4",
            "at": "2026-10-23T21:27:07.727292+00:00"
          }
        },
        "show": [
          {
            "at": 0.1,
            "event": "sum rule"
          },
          {
            "at": 0.4,
            "event": "opposite ≈ minus noise"
          },
          {
            "at": 0.7,
            "event": "much smaller, not zero"
          }
        ]
      },
      "estimated_duration_s": 12,
      "audio_file": "mp3/beat-B05.mp3",
      "engine": "kokoro",
      "voice": "af_bella",
      "actual_duration_s": 11.48
    },
    {
      "beat_id": "B06",
      "act": "LIMITS",
      "narration_text": "It works best on steady sounds, like an engine's hum, because the pattern repeats and is easy to match. Voices and sudden sounds change too fast, so you may still hear them. The ear cushions also block some sound physically.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "LessonExcerpt",
          "props": {
            "header": "What it handles",
            "subheader": "",
            "rows": [
              {
                "tag": "ENGINE HUM",
                "text": "steady and repeating — easier to reduce",
                "emphasis": true
              },
              {
                "tag": "VOICES, BANGS",
                "text": "change quickly — may still get through"
              },
              {
                "tag": "EAR CUSHIONS",
                "text": "block some sound physically"
              }
            ],
            "footer": "Quieter — never perfect silence",
            "sparkLine": "Best on steady hums."
          },
          "rendered": {
            "out": "media/B06.mp4",
            "at": "2026-10-23T21:28:13.572781+00:00"
          }
        },
        "show": [
          {
