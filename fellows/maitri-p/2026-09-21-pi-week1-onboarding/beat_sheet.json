    {
      "beat_id": "B03",
      "act": "FRAMEWORK",
      "narration_text": "Pi sends a request to the model with instructions and tools. If the model asks to read a file or run a command, Pi runs it and returns the real output, or the error. The model picks its next step, until it answers.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "AgentToolLoop",
          "props": {
            "stages": [
              "REQUEST",
              "MODEL DECIDES",
              "PI RUNS TOOL",
              "REAL OUTPUT"
            ],
            "executeIndex": 2,
            "loopBack": true,
            "ports": [
              "read file",
              "run command"
            ],
            "sparkLine": "Ask, run, observe, repeat."
          },
          "rendered": {
            "out": "media/B03.mp4",
            "at": "2026-10-23T18:41:43.066659+00:00"
          }
        },
        "show": [
