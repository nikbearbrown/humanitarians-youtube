    {
      "beat_id": "B05",
      "act": "MATH",
      "narration_text": "Put simply, each run leaves a trace of actions and outputs. Memory means reviewing that trace, keeping a lesson, and adding it to the next task's context.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "TypesetMath",
          "props": {
            "title": "Where memory could fit",
            "rows": [
              {
                "src": "data:image/svg+xml;base64,",
                "aspect": 12.9286,
                "expression": "\\tau = (a_1, o_1, a_2, o_2, \\ldots, a_T, o_T)",
                "at": 1.0
              },
              {
                "src": "data:image/svg+xml;base64,",
                "aspect": 6.4048,
                "expression": "m = \\mathrm{review}(\\tau)",
                "at": 4.0
              },
              {
                "src": "data:image/svg+xml;base64,",
                "aspect": 6.5526,
                "expression": "c_{\\mathrm{next}} = c \\oplus m",
                "at": 6.5
              }
            ],
            "note": "a: tool request · o: real output or error · m: kept lesson",
            "conditions": "A framing for the experiment, not a measured result"
          },
          "rendered": {
            "out": "media/B05.mp4",
            "at": "2026-10-23T18:24:08.637064+00:00"
          }
        },
        "show": [
