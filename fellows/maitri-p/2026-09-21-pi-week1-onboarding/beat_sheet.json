    {
      "beat_id": "B04",
      "act": "THESIS",
      "narration_text": "The key distinction: seeing an error in one run is not remembering a lesson for the next. Pi can use the current conversation. My experiment needs a way to review a run, keep what's useful, and bring it into a fresh task.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "LessonExcerpt",
          "props": {
            "header": "Key distinction",
            "subheader": "",
            "rows": [
              {
                "tag": "WITHIN A RUN",
                "text": "Pi can use the error in the current conversation"
              },
              {
                "tag": "ACROSS RUNS",
                "text": "a lesson must be reviewed, kept, and brought into a fresh task",
                "emphasis": true
              }
            ],
            "footer": "No memory improvement was measured in week one",
            "sparkLine": "Seeing is not remembering."
          },
          "rendered": {
