          },
          {
            "at": 0.75,
            "event": "episodic / semantic / procedural chips appear on their spoken names"
          }
        ]
      },
      "estimated_duration_s": 15,
      "audio_file": "mp3/beat-B03.mp3",
      "engine": "kokoro",
      "voice": "af_bella",
      "actual_duration_s": 15.59
    },
    {
      "beat_id": "B04",
      "act": "RESEARCH",
      "narration_text": "This builds on prior work: workflow memory that reuses routines from past tasks, Reflexion's self-critique between attempts, and MemGPT, which pages context in and out of storage.",
