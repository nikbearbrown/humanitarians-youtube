    },
    {
      "beat_id": "B03",
      "act": "FRAMEWORK",
      "narration_text": "Memory is a loop: capture a task, extract what mattered, store it, and retrieve it next time. Episodic memory recalls last run's failed command. Semantic holds facts, like a repo's layout. Procedural keeps a workflow that worked.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "AgentToolLoop",
          "props": {
            "stages": [
              "CAPTURE",
              "EXTRACT",
              "STORE",
              "RETRIEVE"
            ],
            "executeIndex": 3,
            "loopBack": true,
            "ports": [
              "episodic",
              "semantic",
              "procedural"
            ],
            "sparkLine": "Capture, keep, reuse."
          },
          "rendered": {
            "out": "media/B03.mp4",
            "at": "2026-10-03T04:58:56.082215+00:00"
          }
        },
        "show": [
