        "remotion": {
          "pattern": "ClaudeComposerAsk",
          "props": {
            "greeting": "Hi, Bella",
            "topic": "Irreducibly Human",
            "segment": "What Does a P-Value Actually Mean?",
            "command": "What does a p-value actually mean?",
            "runningText": "",
            "output": [
              "It assumes there's no real effect.",
              "Then asks how likely data this extreme is.",
              "Small p: unlikely under that assumption."
            ],
            "folderLabel": "@HumanitariansAI",
            "largeText": true,
            "modelLabel": "Claude"
          },
          "rendered": {
            "out": "media/B00.mp4",
            "at": "2026-10-15T22:15:42.172613+00:00"
          }
        }
