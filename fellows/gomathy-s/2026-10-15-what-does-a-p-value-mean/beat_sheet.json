      "voice": "af_bella",
      "engine": "kokoro",
      "estimated_duration_s": 6.4,
      "actual_duration_s": 5.57,
      "audio_file": "mp3/beat-B00.mp3"
    },
    {
      "beat_id": "B01",
      "act": "Beat 2 — the BLUF",
      "lead_silence_s": 0.8,
      "qc": {
        "sparse_by_design": true,
        "sparse_reason": "Hesitant-writer beat: three short typed lines on a mostly-cream page (house exemption named in final_frame_check.py's sparse_by_design_beats() docstring)."
      },
      "narration_text": "A p-value isn't the chance you're right. It's how likely data this extreme would be if there were no real effect.",
      "shot": {
        "type": "MANIM",
        "source": "manim",
        "manim": "scenes.py::B01_HesitantWriter",
        "show": [
          {
            "at": 0.0,
            "event": "'A p-value is' / 'the chance you're right.' types in on two lines"
          },
          {
            "at": 0.4,
            "event": "'the chance you're right.' dims and backspaces out"
          },
          {
            "at": 0.55,
            "event": "'how likely data this extreme is' / 'if there's no real effect.' types in its place"
          }
        ]
      },
      "voice": "af_bella",
      "engine": "kokoro",
      "estimated_duration_s": 6.6,
      "actual_duration_s": 6.17,
      "audio_file": "mp3/beat-B01.mp3"
    },
    {
      "beat_id": "B02",
      "act": "Act 1 — assume no effect",
      "qc": {
        "sparse_by_design": true,
        "sparse_reason": "FormBCard's card grid for 2-3 short items doesn't reach 55% fill by design (same characteristic as the passing FormBCard beats in knowledge-cutoff and claude-liam-context-window)."
      },
      "narration_text": "First, assume no effect — the null hypothesis — and that the model holds.",
      "shot": {
        "type": "REMOTION",
        "remotion": {
          "pattern": "FormBCard",
          "props": {
            "title": "Assume first",
            "items": [
              {
                "label": "Null hypothesis",
                "sub": "No effect, no difference"
              },
              {
                "label": "The model",
                "sub": "Its assumptions hold"
              }
            ]
          },
          "rendered": {
            "out": "media/B02.mp4",
            "at": "2026-10-15T22:17:28.362495+00:00"
          }
        },
        "show": [
          {
            "at": 0.0,
            "event": "title 'Assume first' settles"
          },
          {
            "at": 0.3,
            "event": "items reveal in order: Null hypothesis, The model"
          }
        ]
      },
      "voice": "af_bella",
      "engine": "kokoro",
      "estimated_duration_s": 4.6,
      "actual_duration_s": 4.2,
      "audio_file": "mp3/beat-B02.mp3"
    },
    {
      "beat_id": "B03",
      "act": "Act 1 — the shaded share",
      "narration_text": "If the null is true, how often would data this extreme, or more, turn up? That share is the p-value.",
      "shot": {
        "type": "MANIM",
        "source": "manim",
        "manim": "scenes.py::B03_TailShare",
        "show": [
          {
            "at": 0.0,
            "event": "title 'If the Null Is True'; bell curve draws; ILLUSTRATIVE label"
          },
          {
            "at": 0.3,
            "event": "'Your data' marker drops onto the curve's right side"
          },
          {
            "at": 0.5,
            "event": "the tail beyond the marker shades in; 'At least this extreme'"
          },
          {
            "at": 0.8,
            "event": "'Shaded share = p-value' lands under the curve"
          }
        ]
      },
      "voice": "af_bella",
      "engine": "kokoro",
      "estimated_duration_s": 6.0,
      "actual_duration_s": 6.12,
      "audio_file": "mp3/beat-B03.mp3"
    },
    {
      "beat_id": "B04",
      "act": "Act 1 — worked example",
      "narration_text": "Nine heads in ten fair flips? Nine or more: about one percent.",
      "shot": {
        "type": "MANIM",
        "source": "manim",
        "manim": "scenes.py::B04_CoinFlips",
        "show": [
          {
            "at": 0.0,
            "event": "title 'Is This Coin Fair?'; ILLUSTRATIVE label"
          },
          {
            "at": 0.15,
            "event": "ten coin tiles flip in: nine H, one T"
          },
          {
            "at": 0.55,
            "event": "typeset P(X ≥ 9) = 11/1024 ≈ 0.011 writes in"
          },
          {
            "at": 0.8,
            "event": "'About 1% — if the coin is fair' settles beneath"
          }
        ]
      },
      "voice": "af_bella",
      "engine": "kokoro",
      "estimated_duration_s": 4.8,
      "actual_duration_s": 4.06,
      "audio_file": "mp3/beat-B04.mp3"
    },
