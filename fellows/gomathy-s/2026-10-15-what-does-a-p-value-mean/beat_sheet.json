        "type": "REMOTION",
        "show": [
          {
            "at": 0.0,
            "event": "composer sits empty, spark idle"
          },
          {
            "at": 0.2,
            "event": "the ask types itself into the composer"
          },
          {
            "at": 0.6,
            "event": "send arms"
          },
          {
