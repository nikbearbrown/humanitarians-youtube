      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "kinetic",
        "remotion": {
          "pattern": "SlateCard",
          "props": {
            "headline": "One real fix: Benchmark Self-Evolving — a fully automated, multi-agent system that generates harder test cases.",
            "eyebrow": "THE APPROACH",
            "topic": "BENCHMARK SELF-EVOLVING"
          },
          "rendered": {
            "out": "media/B05.mp4",
            "at": ""
          }
        }
      },
      "estimated_duration_s": 12,
      "audio_file": "mp3/beat-B05.mp3",
      "narration_text": "One real fix: Benchmark Self-Evolving — a fully automated, multi-agent system that generates harder test cases from existing ones.",
      "engine": "kokoro",
      "voice": "af_bella",
      "actual_duration_s": 9.15,
      "build": {
        "status": "VIDEO",
        "src": "media/B05.mp4",
