        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "kinetic",
        "remotion": {
          "pattern": "SlateCard",
          "props": {
            "headline": "A good automated patch. Not a permanent fix.",
            "eyebrow": "THE LIMITATION",
            "topic": "SURFACE-LEVEL TRANSFORMATIONS"
          },
          "rendered": {
            "out": "media/B09.mp4",
            "at": ""
          }
        }
      },
      "estimated_duration_s": 14,
      "audio_file": "mp3/beat-B09.mp3",
      "narration_text": "One real limitation: this approach works through surface-level transformations — structural, semantic perturbations. It tests robustness, not the underlying task complexity. A good automated patch. Not a permanent fix.",
      "engine": "kokoro",
      "voice": "af_bella",
      "actual_duration_s": 15.21,
      "build": {
        "status": "VIDEO",
