        "remotion": {
          "pattern": "SlateCard",
          "props": {
            "headline": "Hi, I'm Shivpriya — this video is about a real problem in AI evaluation: benchmarks quietly stop measuring what they were built to measure.",
            "eyebrow": "EXECUTIVE SUMMARY",
            "topic": "AI EVALUATION · BENCHMARK ROT"
