      },
      "estimated_duration_s": 15,
      "audio_file": "mp3/beat-B01.mp3",
      "narration_text": "Hi, I'm Shivpriya, and this video is about a real problem in AI evaluation: benchmarks quietly stop measuring what they were built to measure. I'll walk through why that happens, and one real automated system built to fix it.",
      "engine": "kokoro",
      "voice": "af_bella",
      "actual_duration_s": 14.74,
      "build": {
        "status": "VIDEO",
        "src": "media/B01.mp4",
