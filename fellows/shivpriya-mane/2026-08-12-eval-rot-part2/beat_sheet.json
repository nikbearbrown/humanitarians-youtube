          "props": {
            "items": [
              "Same-family judge — over-rewards its own outputs",
              "Cross-family judge — different training, no shared bias"
            ],
            "cols": 2,
            "caption": "The fix: judge from a different model lineage than the generator"
          },
          "rendered": {
            "out": "media/B08.mp4",
