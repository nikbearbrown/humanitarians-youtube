      "estimated_duration_s": 15,
      "audio_file": "mp3/beat-B07.mp3",
      "narration_text": "Here's the deeper problem. Most automated evals now use an LLM as the judge. Tune a model against a judge with verbosity bias or self-preference bias, and gradient pressure finds both — the eval score climbs while the actual product gets worse.",
      "engine": "kokoro",
      "voice": "af_bella",
      "actual_duration_s": 16.62,
      "build": {
        "status": "VIDEO",
        "src": "media/B07.mp4",
