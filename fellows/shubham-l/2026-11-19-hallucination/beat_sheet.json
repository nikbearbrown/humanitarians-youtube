        "type": "GRAPHIC",
        "source": "remotion",
        "lane": "remotion",
        "motion": "reveal",
        "show": [
          {
            "at": "0.06",
            "event": "real source types in line by line"
          },
          {
            "at": "0.50",
            "event": "the output it actually printed reveals"
          }
        ],
        "remotion": {
          "pattern": "FellowCode",
          "props": {
            "eyebrow": "I RAN IT",
            "title": "",
            "sparkLine": "Three true sentences in.",
            "filename": "code/bigram.py",
            "outputLabel": "what it printed",
            "logo": "logo-outro/humanitarians/humanitarians-logo-1.svg",
            "handle": "@HumanitariansAI",
            "code": "from collections import Counter, defaultdict\ntext = (\"paris is the capital of france . \"\n        \"berlin is the capital of germany . \"\n        \"rome is the capital of italy .\")\nw = text.split()\nnxt = defaultdict(Counter)\nfor a, b in zip(w, w[1:]):\n    nxt[a][b] += 1\ntotal = sum(nxt[\"of\"].values())\nfor word, c in nxt[\"of\"].most_common():\n    print(f\"P({word} | 'of') = {c/total:.2f}\")",
            "printed": "P(france | 'of') = 0.33\nP(germany | 'of') = 0.33\nP(italy | 'of') = 0.33",
            "durationSeconds": 15.91
          },
          "rendered": {
            "out": "media/B02.mp4",
            "at": "2026-11-27T01:47:03.674540+00:00"
          }
        }
