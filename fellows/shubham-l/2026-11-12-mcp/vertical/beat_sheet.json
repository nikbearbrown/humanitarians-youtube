    {
      "beat_id": "B02",
      "act": "FRAMEWORK",
      "narration_text": "The problem is multiplication. Five assistants and ten tools used to mean fifty custom integrations. M C P agrees on the shape of the connection instead. Tools run as M C P servers. Assistants act as M C P clients. Write a server once, and any compatible assistant can use it, the way any device fits a standard port.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "lane": "remotion",
        "motion": "reveal",
        "show": [
