    {
      "beat_id": "B04",
      "act": "WORKED_EXAMPLE",
      "narration_text": "To feel the difference, I wrote a tiny script of my own. Not Medhavy's code, my re-derivation. Same launch, two methods. The closed-form answer says forty point eight two metres. Stepping time forward lands at forty two with big steps, and forty one with small ones. Stepping only approaches the truth. The formula is just there.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "lane": "remotion",
        "motion": "reveal",
        "show": [
          {
            "at": "0.06",
            "event": "real source types in line by line"
          },
          {
            "at": "0.50",
            "event": "the output it actually printed reveals"
          }
        ],
        "remotion": {
          "pattern": "FellowCode",
          "props": {
            "eyebrow": "I RAN IT",
            "title": "",
            "sparkLine": "Formula vs. time steps.",
            "filename": "week-2/code/projectile.py",
            "outputLabel": "what it printed",
            "logo": "logo-outro/humanitarians/humanitarians-logo-1.svg",
            "handle": "@HumanitariansAI",
            "code": "closed_range = v0**2 * math.sin(2 * a) / g\npeak = (v0 * math.sin(a))**2 / (2 * g)\nfor dt in (0.1, 0.01):\n    x, y = 0.0, 0.0\n    vx, vy = v0 * math.cos(a), v0 * math.sin(a)\n    while True:\n        x, y, vy = x + vx*dt, y + vy*dt, vy - g*dt\n        if y < 0: break\n    print(f\"stepped dt={dt}: range {x:.2f} m\")",
            "printed": "stepped dt=0.1: range 42.43 m\nstepped dt=0.01: range 41.01 m\nclosed form:    range 40.82 m, peak 10.20 m",
            "durationSeconds": 17.92
          },
