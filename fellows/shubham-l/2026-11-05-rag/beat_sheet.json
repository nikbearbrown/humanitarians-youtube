    {
      "beat_id": "B03",
      "act": "WORKED_EXAMPLE",
      "narration_text": "Here's the retrieve step, written small enough to read. Four physics passages, and a student asking what launch angle gives a projectile the longest range. The script turns each text into word weights, rare words count more, and measures how closely each passage points the same way as the question.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "lane": "remotion",
        "motion": "reveal",
        "show": [
          {
            "at": "0.06",
            "event": "real source types in line by line"
          },
          {
            "at": "0.50",
            "event": "the output it actually printed reveals"
          }
        ],
        "remotion": {
          "pattern": "FellowCode",
          "props": {
            "eyebrow": "I RAN IT",
            "title": "",
            "sparkLine": "Score every passage.",
            "filename": "code/retrieve.py",
            "outputLabel": "similarity to the question",
            "logo": "logo-outro/humanitarians/humanitarians-logo-1.svg",
            "handle": "@HumanitariansAI",
            "code": "query = (\"what launch angle gives a projectile \"\n         \"the longest range\")\nidf = {t: math.log((N + 1) / (df[t] + 1)) + 1\n       for t in df}\ndef vec(s):\n    tf = Counter(t for t in tok(s) if t in idf)\n    return {t: c * idf[t] for t, c in tf.items()}\ndef cos(a, b):\n    dot = sum(a[t] * b.get(t, 0) for t in a)\n    # ... divided by both vector lengths ...",
            "printed": "ch3 projectile: 0.64\nch5 circular: 0.19\nch7 energy: 0.10\nch1 units: 0.00",
            "durationSeconds": 16.49
          }
        }
      },
