    {
      "beat_id": "B02",
      "act": "FRAMEWORK",
      "narration_text": "R A G has three moves. Retrieve: score every passage in your collection against the question and keep the best. Augment: paste those passages into the prompt. Generate: the model answers, using the text right in front of it. The model itself never changes. It just gets the right page, every time it's asked.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "lane": "remotion",
        "motion": "reveal",
        "show": [
          {
            "at": "0.05",
