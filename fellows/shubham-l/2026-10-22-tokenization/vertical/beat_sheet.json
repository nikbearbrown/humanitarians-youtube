    {
      "beat_id": "B02",
      "act": "FRAMEWORK",
      "narration_text": "The method most models use is called byte-pair encoding, and it's one rule repeated. Split every word into letters. Count which neighbouring pairs appear most often across the text. Merge the winner into a single new symbol. Then do it again, and again, until you have as many tokens as you want.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "lane": "remotion",
        "motion": "reveal",
        "show": [
          {
            "at": "0.05",
            "event": "eyebrow + title land"
          },
          {
            "at": "0.10",
            "event": "stages light one by one, in narration order"
          },
          {
            "at": "0.80",
            "event": "footer line lands"
          }
        ],
        "remotion": {
          "pattern": "FellowFlow916",
          "props": {
            "eyebrow": "BYTE-PAIR ENCODING",
            "title": "One rule, repeated.",
            "sparkLine": "Count, merge, repeat.",
            "stages": [
              {
                "label": "Split into letters",
                "desc": "plus an end-of-word mark"
              },
              {
                "label": "Count every pair",
                "desc": "weighted by word frequency"
              },
              {
                "label": "Merge the top pair",
                "desc": "it becomes one symbol",
                "accent": true
              },
              {
                "label": "Repeat",
                "desc": "until the vocabulary is big enough"
              }
            ],
            "footer": "Real tokenizers run tens of thousands of merges.",
            "logo": "logo-outro/humanitarians/humanitarians-logo-1.svg",
            "handle": "@HumanitariansAI",
            "durationSeconds": 16.08
          },
          "rendered": {
            "out": "media/B02.mp4",
            "at": "2026-11-27T01:39:45.547018+00:00"
          }
        }
      },
