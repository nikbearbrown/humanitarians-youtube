    {
      "beat_id": "B03",
      "act": "WORKED_EXAMPLE",
      "narration_text": "Here's a version I ran on four words: low, lower, newest, widest. First merge: e and s, seen nine times. Then e s plus t. Then est at the end of a word. Only then l and o. After four merges, newest is n, e, w, and one token, est. The ending everyone shares became a single piece first.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "lane": "remotion",
        "motion": "reveal",
        "show": [
          {
            "at": "0.06",
            "event": "real source types in line by line"
          },
          {
            "at": "0.50",
            "event": "the output it actually printed reveals"
          }
        ],
        "remotion": {
          "pattern": "FellowCode916",
          "props": {
            "eyebrow": "I RAN IT",
            "title": "",
            "sparkLine": "Watch the merges.",
            "filename": "code/bpe.py",
            "outputLabel": "what it printed",
            "logo": "logo-outro/humanitarians/humanitarians-logo-1.svg",
            "handle": "@HumanitariansAI",
            "code": "corpus = {\"low\": 5, \"lower\": 2,\n          \"newest\": 6, \"widest\": 3}\nfor step in range(1, 5):\n    pairs = Counter()\n    for sym, n in words.items():\n        for a, b in zip(sym, sym[1:]):\n            pairs[(a, b)] += n\n    (a, b), count = pairs.most_common(1)[0]\n    # ... merge every (a, b) into one symbol ...",
            "printed": "merge 1: e+s -> es  (9x)\nmerge 2: es+t -> est  (9x)\nmerge 3: est+</w> -> est</w>  (9x)\nmerge 4: l+o -> lo  (7x)\nnewest -> n e w est</w>",
            "durationSeconds": 17.87
          },
          "rendered": {
