    {
      "beat_id": "B02B",
      "act": "THE CHECK — code",
      "role_note": "ClaudeCodeBeat — the 4KVideoChecker Apps Script (rebuilt, no names)",
      "narration_text": "Here's the check itself. A scheduled Apps Script scans every new video in Drive, reads its width and height, and marks it pass or fail — four K means thirty-eight-forty by twenty-one-sixty, in either orientation. No human in the loop.",
      "shot": {
        "type": "GRAPHIC",
        "source": null,
        "motion": "fade",
        "remotion": {
          "pattern": "ClaudeCodeBeat916",
          "props": {
            "title": "4KVideoChecker.gs",
            "code": "// runs on a timer\nfunction check_(file) {\n  const {width, height} =\n    probe_(file);\n  const ok =\n    (width >= 3840 &&\n     height >= 2160) ||\n    (width >= 2160 &&\n     height >= 3840);\n  return ok\n    ? \"PASS\" : \"FAIL\";\n}",
            "sparkLine": "The gate runs itself now.",
            "durationSeconds": 16,
            "language": "javascript"
          },
          "rendered": {
            "out": "media/B02B.mp4",
            "at": "2026-11-13T21:36:51.550344+00:00"
          }
