    {
      "beat_id": "S01",
      "act": "CORE",
      "narration_text": "Before you let AI touch a task, ask three things. Is it mechanical -- just reshaping what's already written? Is it reversible -- can you check and undo it? And is the truth actually on the board, or in someone's head? Three greens, let it draft. Any red, you decide. AI drafts and surfaces; you commit.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "S01_TicketTest",
          "file": "scenes_short.py"
        }
      },
      "estimated_duration_s": 18.75,
      "voice": "af_bella",
      "engine": "kokoro",
      "voice_kokoro": "af_bella",
      "build": {
        "status": "MANIM",
        "src": "manim\\S01.mp4",
        "filled_by": "manim:S01_TicketTest",
        "at": "2026-09-29T14:56:03"
      },
      "audio_file": "mp3/beat-S01.mp3",
      "actual_duration_s": 18.75,
      "render_duration_s": 18.75
    },
    {
