    {
      "beat_id": "S00",
      "act": "INTRO",
      "narration_text": "Hi, I'm Sanjana. AI just moved into Jira, Trello, and Asana. Here's the one test for what to hand it -- and what to keep -- in under a minute.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "ClaudeComposerAsk916",
          "props": {
            "greeting": "Hi, Sanjana",
            "topic": "Irreducibly Human",
            "segment": "AI in PM Tools",
            "command": "AI is now inside Jira and Trello. Which project work do I hand to it, and which do I keep for a human?",
            "runningText": "sorting the board work...",
            "folderLabel": "@HumanitariansAI",
            "modelLabel": "Claude",
            "effortLabel": "High",
            "output": [
              "AI is great at reshaping what's already written",
              "it should DRAFT and SURFACE, never DECIDE and COMMIT",
              "one test tells you which side a task is on"
            ]
          },
          "rendered": {
            "out": "",
            "at": ""
          }
        }
      },
      "estimated_duration_s": 9.22,
      "voice": "af_bella",
      "engine": "kokoro",
      "voice_kokoro": "af_bella",
      "build": {
        "status": "VIDEO",
