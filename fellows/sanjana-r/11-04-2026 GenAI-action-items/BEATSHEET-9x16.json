        "type": "GRAPHIC",
        "source": null,
        "motion": "fade",
        "remotion": {
          "pattern": "ClaudeCodeBeat916",
          "props": {
            "title": "actions.py",
            "code": "def summarize(path):\n    for ln in open(path):\n        print(ln.strip())\n\n# a tidy list of topics —\n# no owner, no date,\n# nothing to act on",
            "sparkLine": "A tidy list of topics.",
            "durationSeconds": 15
          },
