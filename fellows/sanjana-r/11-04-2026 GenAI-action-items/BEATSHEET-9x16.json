    {
      "beat_id": "B06",
      "act": "CODE — revised",
      "role_note": "ClaudeCodeBeat — the triage that a summary can't do",
      "narration_text": "Now the model returns structured rows — task, owner, due, impact, urgency. And your code does the part a summary never could: priority is impact plus urgency, a gap is anything with no owner or no date, and it sorts highest first.",
      "shot": {
        "type": "GRAPHIC",
        "source": null,
        "motion": "fade",
        "remotion": {
          "pattern": "ClaudeCodeBeat916",
          "props": {
            "title": "actions.py",
            "code": "# each row: task, owner,\n# due, impact, urgency\ndef pr(a):\n    return (a[\"impact\"]\n            + a[\"urgency\"])\ndef gap(a):\n    return (not a[\"owner\"]\n            or not a[\"due\"])\n\nfor a in sorted(items,\n        key=pr):\n    print(pr(a), a[\"task\"])",
            "sparkLine": "Owner, due, priority — and the gaps.",
            "durationSeconds": 15
          },
          "rendered": {
