    {
      "beat_id": "C02",
      "act": "Act 2",
      "narration_text": "We upgraded to a one-D ResNet and introduced data augmentation. Random rolling, noise, and scaling forced the model to learn true features. Pre-training accuracy dropped to eighty-two percent, but validation accuracy jumped to seventy-eight point nine percent.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 25,
      "shot": {
        "type": "REMOTION",
        "remotion": {
