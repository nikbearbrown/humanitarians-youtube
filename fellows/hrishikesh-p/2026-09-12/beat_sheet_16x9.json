        "remotion": {
          "pattern": "ClaudeVerdictArtifact",
          "props": {
            "artifactTitle": "Legacy Baseline",
            "artifactHeading": "The Overfitting Problem",
            "artifactLines": [
              "Baseline performance: Legacy CNN reached a bloated 99.30% training accuracy but completely failed to generalize.",
              "Evaluation collapse: Validation accuracy stalled and test accuracy reached only an unusable 53.70%.",
              "Architectural limits: The shallow model memorized the dataset exactly instead of learning generalized Raman features.",
              "Action item: Abandoned the legacy pipeline in favor of a deeper model architecture capable of real representation learning."
            ]
          },
          "rendered": {
