      "beat_id": "B01",
      "act": "OVERVIEW",
      "narration_text": "The previous team built a convolutional neural network to classify Raman spectroscopy data. It's a solid foundation, but there's a catch when it moves from the lab to real-world samples.",
      "shot": {
        "type": "STILL",
        "source": "media",
        "motion": "kenburns"
      },
      "estimated_duration_s": 15,
      "lead_silence_s": 0.8,
