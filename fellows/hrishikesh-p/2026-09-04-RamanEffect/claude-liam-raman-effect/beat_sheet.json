      "beat_id": "B01",
      "act": "OVERVIEW",
      "narration_text": "The Raman Effect in one breath. When a laser hits a sample, almost all the photons bounce back with the exact same energy. But a tiny fraction hit a molecule, change its vibration, and scatter back with a different wavelength. That shift is the chemical fingerprint.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "BrutalistHesitantWriter",
          "props": {
            "text": "When a laser hits a sample, almost all the photons\nbounce back with the exact same energy.\nBut a tiny fraction change the molecule's vibration,\nand scatter back with a different wavelength.",
            "triggerWords": "are absorbed completely",
            "replacementWords": "bounce back with the exact same energy",
            "seed": "1928"
          }
        }
      },
      "estimated_duration_s": 15,
      "lead_silence_s": 0.8,
      "actual_duration_s": 14.57,
      "audio_file": "mp3/beat-B01.mp3",
