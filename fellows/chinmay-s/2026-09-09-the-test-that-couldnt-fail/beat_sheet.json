        "src": "media\\B05.mp4",
        "filled_by": "remotion:IdxStatement",
        "at": "2026-09-09T19:15:39"
      }
    },
    {
      "beat_id": "B06",
      "act": "DIST",
      "narration_text": "So what can a generator learn from that? The shape of each column on its own. And it does. The synthetic distributions track the real ones closely — a little wider, slightly shifted, essentially the same curve.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "stagger",
        "remotion": {
          "pattern": "SynthParticleHist",
          "props": {},
