      }
    },
    {
      "beat_id": "B08",
      "act": "PRAIN",
      "narration_text": "Here are the seven results. Zero. Zero. Zero point zero zero zero three. Zero, zero, zero, and zero. Every numeric column lands below the threshold. By the rule the notebook just wrote down, all seven failed.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "stagger",
        "remotion": {
          "pattern": "SynthPValueRain",
          "props": {},
