      }
    },
    {
      "beat_id": "B11",
      "act": "LESSON",
      "narration_text": "The data did not change. The criterion did. A threshold you pick after seeing your results is not a threshold — it is a description of the results.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "IdxStatement",
          "props": {
            "eyebrow": "THE FIRST LESSON",
            "headline": "A threshold chosen afterwards is not a threshold.",
