      "build": {
        "status": "VIDEO",
        "src": "media\\B13.mp4",
        "filled_by": "remotion:IdxStatement",
        "at": "2026-09-09T19:15:39"
      }
    },
    {
      "beat_id": "B14",
      "act": "UTILITY",
      "narration_text": "Now the strongest claim. Train a model on synthetic data, test it on real data. If it performs, the synthetic data carries real analytical value. The notebook reports accuracy of zero point seven eight five.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "IdxStatement",
          "props": {
            "eyebrow": "CLAIM TWO — UTILITY",
            "headline": "Train on synthetic. Test on real.",
            "kicker": "reported accuracy 0.785 — and an F1 of zero"
          },
          "rendered": {
            "out": "media/B14.mp4",
            "at": "2026-09-09T00:00:00"
          }
        }
      },
      "estimated_duration_s": 13.4,
      "audio_file": "mp3/beat-B14.mp3",
