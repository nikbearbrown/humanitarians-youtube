      }
    },
    {
      "beat_id": "B17",
      "act": "SIGNAL",
      "narration_text": "Because there is nothing to learn. Every one of those six features correlates with diabetes at under one and a half hundredths. They were drawn independently, so no model, on real or synthetic data, could ever predict it.",
      "shot": {
        "type": "GRAPHIC",
