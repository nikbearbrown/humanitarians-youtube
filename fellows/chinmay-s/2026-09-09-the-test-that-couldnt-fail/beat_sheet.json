      "build": {
        "status": "VIDEO",
        "src": "media\\B14.mp4",
        "filled_by": "remotion:IdxStatement",
        "at": "2026-09-09T19:15:39"
      }
    },
    {
      "beat_id": "B15",
      "act": "BASERATE",
      "narration_text": "But look at what the model does. It predicts no diabetes, every single time, for all ten thousand patients. And in this dataset, seventy-eight point five percent of patients do not have diabetes. The accuracy is not a result. It is the base rate.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "stagger",
        "remotion": {
          "pattern": "SynthBaseRate",
