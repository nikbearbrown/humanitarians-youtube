      }
    },
    {
      "beat_id": "B12",
      "act": "CHI",
      "narration_text": "The categorical test has a deeper problem. It cross-tabulates real against synthetic row by row — but row five of one has nothing to do with row five of the other. Shuffle a column so the marginals are identical, and the test still returns a comfortable pass.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "stagger",
        "remotion": {
          "pattern": "SynthChiSquareProof",
          "props": {},
