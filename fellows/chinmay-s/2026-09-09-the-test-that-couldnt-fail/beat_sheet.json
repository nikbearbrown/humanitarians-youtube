      "build": {
        "status": "VIDEO",
        "src": "media\\B12.mp4",
        "filled_by": "remotion:SynthChiSquareProof",
        "at": "2026-09-09T19:15:39"
      }
    },
    {
      "beat_id": "B13",
      "act": "LESSON2",
      "narration_text": "So that test passes when the columns match, and passes when they are unrelated. It cannot fail. Which means it was never evidence of anything.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "IdxStatement",
          "props": {
            "eyebrow": "THE SECOND LESSON",
            "headline": "Run your test on data you know is wrong.",
            "kicker": "if it still passes, it was never measuring"
          },
          "rendered": {
            "out": "media/B13.mp4",
            "at": "2026-09-09T00:00:00"
          }
        }
      },
      "estimated_duration_s": 9.5,
