      }
    },
    {
      "beat_id": "B18",
      "act": "CAUSE",
      "narration_text": "The notebook reads that zero as class imbalance, and suggests better sampling. But balancing classes cannot create a relationship that was never generated in the first place.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "IdxStatement",
          "props": {
