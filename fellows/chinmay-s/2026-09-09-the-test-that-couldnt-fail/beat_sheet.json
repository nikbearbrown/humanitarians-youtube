      }
    },
    {
      "beat_id": "B07",
      "act": "FIDELITY",
      "narration_text": "Now the first claim: fidelity. The notebook runs a Kolmogorov Smirnov test on every numeric column, and it states the rule up front. High p-values, above zero point zero five, mean the distributions are similar.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "IdxStatement",
          "props": {
            "eyebrow": "CLAIM ONE — FIDELITY",
            "headline": "The rule, written down before the test.",
            "kicker": "p greater than 0.05 means “statistically similar”"
          },
          "rendered": {
            "out": "media/B07.mp4",
            "at": "2026-09-09T00:00:00"
          }
        }
