        "src": "media\\B16.mp4",
        "filled_by": "remotion:KidFixedScores",
        "at": "2026-09-25T11:47:53"
      }
    },
    {
      "beat_id": "B17",
      "act": "MEANING",
      "narration_text": "Nothing about the answers changed. Not one letter. Only the marking changed. And that is the whole point of the story.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "IdxStatement",
          "props": {
            "eyebrow": "WHAT CHANGED",
            "headline": "The answers never moved. The marking did.",
