        "src": "media\\B17.mp4",
        "filled_by": "remotion:IdxStatement",
        "at": "2026-09-25T11:47:53"
      }
    },
    {
      "beat_id": "B18",
      "act": "CLOSE",
      "narration_text": "A score tells you about two things at once: the thing being tested, and the thing doing the testing. If you only ever check one of them, you are reading half the answer.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "IdxStatement",
          "props": {
            "eyebrow": "THE LAST THOUGHT",
            "headline": "Every score is really two scores.",
            "kicker": "one for the student, one for the test"
          },
          "rendered": {
            "out": "media/B18.mp4",
            "at": "2026-09-25T00:00:00"
          }
        }
      },
      "estimated_duration_s": 12.7,
      "audio_file": "mp3/beat-B18.mp3",
