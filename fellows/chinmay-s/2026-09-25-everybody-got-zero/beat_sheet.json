        "src": "media\\B18.mp4",
        "filled_by": "remotion:IdxStatement",
        "at": "2026-09-25T11:47:53"
      }
    },
    {
      "beat_id": "B19",
      "act": "VERDICT",
      "narration_text": "So here is what we found. Three separate problems, and not one of them was the robot's fault.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "stagger",
        "remotion": {
          "pattern": "ClaudeVerdictArtifact",
          "props": {
            "artifactTitle": "The test where everybody got zero",
            "artifactHeading": "What we found",
            "artifactLines": [
              "The full stop: a correct answer ending in a dot scores nothing, because the dot stays stuck to the word.",
