          }
        }
      },
      "estimated_duration_s": 9.6,
      "audio_file": "mp3/beat-B15.mp3",
      "actual_duration_s": 7.17,
      "build": {
        "status": "VIDEO",
        "src": "media\\B15.mp4",
        "filled_by": "remotion:IdxStatement",
        "at": "2026-09-25T11:47:53"
      }
    },
    {
      "beat_id": "B16",
      "act": "FIXED",
      "narration_text": "So mend the marker. Teach it to ignore full stops, and to understand letters with accents. Then mark the very same answers again. Sixty percent becomes one hundred percent.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "stagger",
        "remotion": {
