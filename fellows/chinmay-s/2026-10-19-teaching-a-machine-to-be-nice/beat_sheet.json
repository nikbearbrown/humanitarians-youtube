    {
      "beat_id": "B06",
      "act": "GAPS",
      "narration_text": "It never worked out what the word not means, so not great looks positive to it. And it adores piled-up praise — the more times you say very and amazing, the higher it scores you, even when a real reader would find it ridiculous.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "IdxStatement",
          "props": {
            "eyebrow": "TWO BLIND SPOTS",
            "headline": "It cannot hear the word “not”.",
            "kicker": "and it rewards saying “very” over and over"
          },
          "rendered": {
            "out": "media/B06.mp4",
            "at": "2026-10-19T00:00:00"
          }
        }
      },
      "estimated_duration_s": 16.9,
      "audio_file": "mp3/beat-B06.mp3",
      "actual_duration_s": 14.1,
      "build": {
        "status": "VIDEO",
        "src": "media\\B06.mp4",
        "filled_by": "remotion:IdxStatement",
        "at": "2026-10-19T23:28:20"
      }
    },
    {
      "beat_id": "B07",
      "act": "BESTOF",
      "narration_text": "Before anything clever, here is the lazy idea that works. Write several reviews, let the judge pick the best one, and throw the rest away. No training at all.",
