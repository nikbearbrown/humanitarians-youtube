        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "stagger",
        "remotion": {
          "pattern": "KidJudgeBlindSpot",
          "props": {
            "rows": [
              {
                "text": "the food was great .",
                "truth": "+1.00",
                "judge": "+1.07",
                "fooled": false
              },
              {
                "text": "the food was very great .",
                "truth": "+1.50",
                "judge": "+1.75",
                "fooled": false
              },
              {
                "text": "the food was terrible .",
                "truth": "-1.00",
                "judge": "-1.92",
                "fooled": false
              },
              {
                "text": "the food was not great .",
                "truth": "-0.50",
                "judge": "+0.04",
                "fooled": true
              },
              {
                "text": "the food was not terrible .",
                "truth": "+0.50",
                "judge": "-0.69",
                "fooled": true
              },
              {
                "text": "the food was very great . we will definitely come back .",
                "truth": "+1.25",
                "judge": "+0.97",
                "fooled": false
              },
              {
                "text": "the food was great . the food was great . the food was great .",
                "truth": "-0.50",
                "judge": "+1.30",
                "fooled": true
              }
            ]
          },
          "rendered": {
            "out": "media/B05.mp4",
            "at": "2026-10-19T00:00:00"
          }
        }
