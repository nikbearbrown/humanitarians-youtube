        "src": "media\\B12.mp4",
        "filled_by": "remotion:KidLeash",
        "at": "2026-10-19T23:28:20"
      }
    },
    {
      "beat_id": "B13",
      "act": "WORKS",
      "narration_text": "And now it works. With a middling lead the reviews score +1.19, almost everything is a proper sentence, and it still has things to say. Too short a lead and every review sounds the same. Too long and we are back to nonsense.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "IdxStatement",
          "props": {
            "eyebrow": "THE LEAD WORKS",
            "headline": "Good reviews, and still proper sentences.",
            "kicker": "the lead length is the whole art of it"
          },
          "rendered": {
