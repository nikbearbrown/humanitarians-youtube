    {
      "beat_id": "B19",
      "act": "VERDICT",
      "narration_text": "So here is the whole story. A machine that writes. Two hundred examples to show it what nice looks like. A judge built from thousands of human choices that were themselves only right about three quarters of the time. A judge with blind spots. And a machine that found every single one of them the moment we let it off the lead.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "stagger",
        "remotion": {
          "pattern": "ClaudeVerdictArtifact",
          "props": {
