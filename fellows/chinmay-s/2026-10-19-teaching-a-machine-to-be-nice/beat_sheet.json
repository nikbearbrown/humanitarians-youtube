    {
      "beat_id": "B08",
      "act": "NOWTRAIN",
      "narration_text": "But we want the machine itself to get better, not just to guess repeatedly. So we let it practise: write a review, see what the judge scores it, and change slightly to score higher next time. Over and over. With no other rules at all.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "IdxStatement",
          "props": {
            "eyebrow": "NOW LET IT PRACTISE",
            "headline": "Chase the score. Nothing else.",
            "kicker": "what could possibly go wrong"
          },
          "rendered": {
            "out": "media/B08.mp4",
            "at": "2026-10-19T00:00:00"
          }
        }
      },
      "estimated_duration_s": 17.3,
      "audio_file": "mp3/beat-B08.mp3",
