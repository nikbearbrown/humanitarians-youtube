        "at": "2026-10-19T23:28:20"
      }
    },
    {
      "beat_id": "B14",
      "act": "DPO",
      "narration_text": "There is a second route that skips the judge entirely. Instead of building one, you show the machine the pairs directly and say: make the preferred one more likely, and the other one less. It is simpler, and much faster.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "IdxStatement",
          "props": {
            "eyebrow": "THE SHORTCUT",
            "headline": "Skip the judge. Learn straight from the pairs.",
            "kicker": "no separate judge to fool"
          },
          "rendered": {
            "out": "media/B14.mp4",
            "at": "2026-10-19T00:00:00"
          }
        }
      },
      "estimated_duration_s": 15.4,
      "audio_file": "mp3/beat-B14.mp3",
      "actual_duration_s": 13.23,
      "build": {
        "status": "VIDEO",
        "src": "media\\B14.mp4",
        "filled_by": "remotion:IdxStatement",
        "at": "2026-10-19T23:28:20"
      }
    },
    {
      "beat_id": "B15",
      "act": "DPOBREAK",
      "narration_text": "Except on this run it goes wrong in its own way. Pushing the worse review down drags the better one down with it, and the writing falls apart — only 36 percent proper sentences, and a true score of -1.15.",
      "shot": {
        "type": "GRAPHIC",
