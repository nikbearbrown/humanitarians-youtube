    },
    {
      "beat_id": "B16",
      "act": "DPOFIX",
      "narration_text": "The repair is a reminder. Alongside pushing the bad one down, keep practising the good one. That brings it back: 96 percent proper sentences, and a true score of +0.97.",
      "shot": {
