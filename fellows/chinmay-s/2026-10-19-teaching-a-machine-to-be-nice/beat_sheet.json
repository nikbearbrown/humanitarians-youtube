    {
      "beat_id": "B10",
      "act": "HACKED",
      "narration_text": "The judge is delighted. It went from +0.21 up to +1.77. Meanwhile the reviews fell from +0.58 to -3.00, and the share that are even proper sentences went from 97 percent to 0.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "IdxStatement",
          "props": {
            "eyebrow": "WHAT ACTUALLY HAPPENED",
            "headline": "The score went up. Everything else collapsed.",
            "kicker": "it stopped writing reviews and started writing bait"
          },
          "rendered": {
            "out": "media/B10.mp4",
            "at": "2026-10-19T00:00:00"
          }
        }
      },
      "estimated_duration_s": 12.7,
      "audio_file": "mp3/beat-B10.mp3",
      "actual_duration_s": 17.0,
      "build": {
        "status": "VIDEO",
        "src": "media\\B10.mp4",
        "filled_by": "remotion:IdxStatement",
        "at": "2026-10-19T23:28:20"
      }
    },
    {
      "beat_id": "B11",
      "act": "CHEATING",
      "narration_text": "It found the judge's weak spot and did nothing but that. It is not broken, and it is not being naughty. It did exactly what we asked — we just asked for the score, and forgot to ask for the reviews.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "IdxStatement",
          "props": {
            "eyebrow": "IT DID AS IT WAS TOLD",
            "headline": "Nobody taught it to cheat. We taught it to score.",
            "kicker": "this has a name: reward hacking"
          },
          "rendered": {
            "out": "media/B11.mp4",
            "at": "2026-10-19T00:00:00"
          }
        }
      },
      "estimated_duration_s": 15.8,
      "audio_file": "mp3/beat-B11.mp3",
      "actual_duration_s": 12.03,
      "build": {
        "status": "VIDEO",
        "src": "media\\B11.mp4",
        "filled_by": "remotion:IdxStatement",
        "at": "2026-10-19T23:28:20"
      }
    },
    {
      "beat_id": "B12",
      "act": "LEASH",
      "narration_text": "The fix is a lead. Alongside chasing the score, we add one more rule: do not drift too far from how you used to write. The shorter the lead, the less it can wander.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "stagger",
        "remotion": {
          "pattern": "KidLeash",
          "props": {
