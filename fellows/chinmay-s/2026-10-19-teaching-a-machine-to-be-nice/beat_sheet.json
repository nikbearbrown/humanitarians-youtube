    {
      "beat_id": "B00",
      "act": "ASK",
      "narration_text": "A machine was taught to write nice restaurant reviews. It learned to write this instead. This is Humanitarians AI. Today: how you teach a machine what you want, and the very strange thing that happens when you get it slightly wrong.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "type-on",
        "remotion": {
          "pattern": "ClaudeComposerAsk",
          "props": {
            "greeting": "Teach it to be nice.",
            "topic": "TEACHING MACHINES WHAT WE WANT",
            "segment": "Teaching a Machine to Be Nice",
            "command": "Walk me through aligning a small language model: showing it examples, building a judge from people's preferences, and training against that judge. Then show me what happens with no restraint at all.",
            "runningText": "opening the notebook…",
            "folderLabel": "@HumanitariansAI",
            "output": [
              "show it good examples",
              "build a judge from what people prefer",
              "then watch it learn to cheat the judge"
            ]
          },
          "rendered": {
            "out": "media/B00.mp4",
            "at": "2026-10-19T00:00:00"
          }
        }
