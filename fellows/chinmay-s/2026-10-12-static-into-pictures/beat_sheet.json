    },
    {
      "beat_id": "B14",
      "act": "LIMIT",
      "narration_text": "Fifty steps is four times faster and still gives a clean spiral. Twenty is ten times faster and still works. But five steps falls apart completely — and look at its score. It is about the same as pure static. You went faster and arrived nowhere.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "IdxStatement",
          "props": {
            "eyebrow": "TOO BIG A STEP",
            "headline": "At five steps, you may as well not have bothered.",
            "kicker": "the same score as the random dots you started from"
          },
          "rendered": {
            "out": "media/B14.mp4",
            "at": "2026-10-12T00:00:00"
          }
        }
      },
      "estimated_duration_s": 17.7,
      "audio_file": "mp3/beat-B14.mp3",
      "actual_duration_s": 15.89,
      "build": {
        "status": "VIDEO",
        "src": "media\\B14.mp4",
        "filled_by": "remotion:IdxStatement",
        "at": "2026-10-12T13:09:16"
      }
    },
    {
      "beat_id": "B15",
      "act": "STEER",
      "narration_text": "Last trick, and it is the one in every picture app you have used. Now there are two shapes, and we tell the machine which one we want. There is a dial for how hard to insist.",
