        "at": "2026-10-12T13:09:16"
      }
    },
    {
      "beat_id": "B18",
      "act": "SNEAKY",
      "narration_text": "And one sneaky detail that is easy to miss. The machine itself never changed. Not one thing was re-learned. The dial only changes how you ask — which is why you can move it for every picture, without ever retraining anything.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "IdxStatement",
          "props": {
            "eyebrow": "THE SNEAKY BIT",
            "headline": "The dial is in the asking, not the machine.",
            "kicker": "nothing was retrained between any of those settings"
