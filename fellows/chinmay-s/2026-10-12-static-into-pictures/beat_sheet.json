    },
    {
      "beat_id": "B12",
      "act": "READING",
      "narration_text": "Read the bars. Real dots score about zero — that is as good as it gets. Our machine's two hundred step version is so close to that line you can barely see its bar. Pure static is right off the end.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "IdxStatement",
          "props": {
            "eyebrow": "READING THE SCORES",
            "headline": "The made-up spirals land almost on the real ones.",
            "kicker": "and pure static is nowhere near"
