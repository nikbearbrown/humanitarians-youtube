            "at": "2026-10-12T00:00:00"
          }
        }
      },
      "estimated_duration_s": 13.5,
      "audio_file": "mp3/beat-B01.mp3",
      "actual_duration_s": 10.13,
      "build": {
        "status": "VIDEO",
        "src": "media\\B01.mp4",
        "filled_by": "remotion:KidGuessGame",
        "at": "2026-10-12T15:38:23"
      }
    },
    {
      "beat_id": "B02",
      "act": "CORPUS",
      "narration_text": "To practise, it reads real computer code — 2,053,690 characters of it, pulled straight off the machine it is running on. Nobody wrote it specially. It is just 73 ordinary files.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "IdxStatement",
          "props": {
            "eyebrow": "THE PRACTICE BOOK",
            "headline": "Two million characters of real code.",
            "kicker": "no special training set — just files already on the computer"
          },
          "rendered": {
            "out": "media/B02.mp4",
            "at": "2026-10-12T00:00:00"
          }
        }
      },
      "estimated_duration_s": 11.9,
      "audio_file": "mp3/beat-B02.mp3",
      "actual_duration_s": 14.34,
      "build": {
        "status": "VIDEO",
        "src": "media\\B02.mp4",
        "filled_by": "remotion:IdxStatement",
        "at": "2026-10-12T15:38:23"
      }
    },
    {
      "beat_id": "B03",
      "act": "ALPHABET",
      "narration_text": "Now, how hard is this game? There are 96 different characters it could pick. Guessing blind, it is choosing between all of them. Counting which letters tend to follow which gets it down to about eleven. And the real machine, when it is finished, gets down to about five.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "stagger",
        "remotion": {
          "pattern": "KidAlphabetShrink",
          "props": {
            "stages": [
              {
                "label": "guessing blindly",
                "choices": 96,
                "hero": false
              },
              {
                "label": "just counting letter pairs",
                "choices": 12,
                "hero": false
              },
              {
                "label": "the finished machine",
                "choices": 5,
                "hero": true
              }
            ]
          },
          "rendered": {
            "out": "media/B03.mp4",
            "at": "2026-10-12T00:00:00"
          }
        }
      },
      "estimated_duration_s": 18.8,
      "audio_file": "mp3/beat-B03.mp3",
      "actual_duration_s": 16.58,
      "build": {
        "status": "VIDEO",
        "src": "media\\B03.mp4",
        "filled_by": "remotion:KidAlphabetShrink",
        "at": "2026-10-12T15:38:23"
      }
    },
    {
      "beat_id": "B04",
      "act": "SHORTCUTS",
      "narration_text": "Before it starts, it invents shortcuts. It looks for pieces that keep appearing and glues them into single chunks. And the very first thing it discovers is a bit funny.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "stagger",
        "remotion": {
          "pattern": "KidShortcuts",
          "props": {
            "merges": [
              "  ",
              "    ",
              "        ",
              "\\n        ",
              "__",
              ", ",
              "se",
              "er",
              "\\n    ",
              "re"
            ],
            "charsPerToken": "2.38"
          },
          "rendered": {
            "out": "media/B04.mp4",
            "at": "2026-10-12T00:00:00"
          }
        }
      },
      "estimated_duration_s": 11.5,
      "audio_file": "mp3/beat-B04.mp3",
      "actual_duration_s": 9.98,
      "build": {
        "status": "VIDEO",
        "src": "media\\B04.mp4",
        "filled_by": "remotion:KidShortcuts",
        "at": "2026-10-12T15:38:23"
      }
    },
    {
      "beat_id": "B05",
      "act": "SPACES",
      "narration_text": "The commonest thing in computer code is empty space — 28.8 percent of everything it read. So its first shortcuts are runs of blank space. Then little word pieces. Then, eventually, whole real words.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "IdxStatement",
          "props": {
            "eyebrow": "THE FUNNY PART",
            "headline": "Its first discovery was: lots of nothing.",
            "kicker": "indentation, which in Python is how the code is shaped"
          },
          "rendered": {
            "out": "media/B05.mp4",
            "at": "2026-10-12T00:00:00"
          }
        }
      },
      "estimated_duration_s": 13.1,
      "audio_file": "mp3/beat-B05.mp3",
      "actual_duration_s": 13.67,
      "build": {
        "status": "VIDEO",
        "src": "media\\B05.mp4",
        "filled_by": "remotion:IdxStatement",
        "at": "2026-10-12T15:38:23"
      }
    },
    {
      "beat_id": "B06",
      "act": "LOOKBACK",
      "narration_text": "Now the clever bit, and this is the idea the whole thing is built on. To guess the next character, each character looks back at the ones before it, and decides which of them matter.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "stagger",
        "remotion": {
          "pattern": "KidLookBack",
          "props": {},
          "rendered": {
            "out": "media/B06.mp4",
            "at": "2026-10-12T00:00:00"
          }
        }
      },
      "estimated_duration_s": 13.5,
      "audio_file": "mp3/beat-B06.mp3",
      "actual_duration_s": 10.67,
      "build": {
        "status": "VIDEO",
        "src": "media\\B06.mp4",
        "filled_by": "remotion:KidLookBack",
        "at": "2026-10-12T15:38:23"
      }
    },
    {
      "beat_id": "B07",
      "act": "ONLYBACK",
      "narration_text": "And it can only ever look backwards, never forwards. That rule matters more than it sounds. If it could peek ahead, it would simply read the answer, learn nothing, and be useless the moment you asked it something new.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "IdxStatement",
          "props": {
            "eyebrow": "ONE STRICT RULE",
            "headline": "No peeking at what comes next.",
            "kicker": "the answer is right there — so it must be hidden"
          },
          "rendered": {
            "out": "media/B07.mp4",
            "at": "2026-10-12T00:00:00"
          }
        }
      },
      "estimated_duration_s": 15.0,
      "audio_file": "mp3/beat-B07.mp3",
      "actual_duration_s": 12.59,
      "build": {
        "status": "VIDEO",
        "src": "media\\B07.mp4",
        "filled_by": "remotion:IdxStatement",
        "at": "2026-10-12T15:38:23"
      }
    },
    {
