    {
      "beat_id": "B00",
      "act": "ASK",
      "narration_text": "Somebody built a tiny version of the thing behind ChatGPT, by hand, out of nothing. This is Humanitarians AI. It is small enough to understand completely, and it learned to write computer code by playing one very boring game, a few million times.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "type-on",
        "remotion": {
          "pattern": "ClaudeComposerAsk",
          "props": {
            "greeting": "Show me how it learns.",
            "topic": "HOW TEXT MACHINES LEARN",
            "segment": "Finishing Your Sentences",
            "command": "Walk me through a GPT built from scratch in NumPy — what game it plays, how it gets good at it, and how we know the maths is actually right.",
            "runningText": "opening the notebook…",
            "folderLabel": "@HumanitariansAI",
            "output": [
              "the game: guess the next character",
              "the trick: look back at what came before",
              "the proof: check the maths twice"
            ]
          },
          "rendered": {
            "out": "media/B00.mp4",
            "at": "2026-10-12T00:00:00"
          }
        }
