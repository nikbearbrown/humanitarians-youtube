    {
      "beat_id": "B01",
      "act": "GAME",
      "narration_text": "Here is the game. You get some text, and you guess the very next character. That is it. That is the whole job. Do it well enough, millions of times over, and you can write.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "stagger",
        "remotion": {
          "pattern": "KidGuessGame",
          "props": {},
