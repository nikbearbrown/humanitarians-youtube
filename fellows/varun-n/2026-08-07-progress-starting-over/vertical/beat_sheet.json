    {
      "beat_id": "B01",
      "act": "overview",
      "narration_text": "The earlier physics videos were not approved, so on August third I reset. I deleted the old builds but kept the storyboards, because the problem was the visual style, not the ideas.",
      "voice": "bm_george",
      "engine": "kokoro",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "remotion": {
          "pattern": "ClaudeComposerAsk916",
          "props": {
            "greeting": "The reset,",
            "topic": "MEDHAVY · PROGRESS UPDATE",
            "segment": "The Reset",
            "command": "rm -r builds/ --keep storyboards/",
            "runningText": "clearing old builds...",
            "folderLabel": "@HumanitariansAI",
            "output": [
              "Old builds deleted",
              "Storyboards kept"
            ],
            "largeText": true
          },
          "rendered": {
            "out": "media/B01.mp4",
            "at": "2026-09-30T13:47:54.010775+00:00"
          }
        }
      },
      "audio_file": "mp3/beat-B01.mp3",
      "actual_duration_s": 12.1,
      "render_duration_s": 12.1,
