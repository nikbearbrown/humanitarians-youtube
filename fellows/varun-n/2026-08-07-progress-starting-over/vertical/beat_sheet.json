      "engine": "kokoro",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "remotion": {
          "pattern": "ClaudeComposerAsk916",
          "props": {
            "greeting": "The sample,",
            "topic": "MEDHAVY · PROGRESS UPDATE",
            "segment": "Ball and Feather",
            "command": "build sample --section 3.5 ball-and-feather",
            "runningText": "building sample...",
            "folderLabel": "@HumanitariansAI",
