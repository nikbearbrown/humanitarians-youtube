        "filled_by": "remotion:ClaudeComposerAsk916",
        "at": "2026-09-30T10:36:13"
      }
    },
    {
      "beat_id": "B04",
      "act": "visual",
      "narration_text": "I rejected the first render. Text and images overlapped, and the narration was too fast. Our spot-check QC had missed the overlaps, so we now inspect every frame of a video before any render is shown.",
      "voice": "bm_george",
      "engine": "kokoro",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "remotion": {
          "pattern": "TopicChipGrid916",
          "props": {
