            "items": [
              "Text over images",
              "Narration too fast",
              "Spot-check QC missed it"
            ],
            "caption": "Now: inspect every frame first",
            "folderLabel": "@HumanitariansAI"
          },
          "rendered": {
            "out": "media/B04.mp4",
            "at": "2026-09-30T13:52:39.833108+00:00"
          }
        }
      },
