    {
      "beat_id": "B01",
      "act": "overview",
      "narration_text": "On September twenty-first, captions went from eighteen to fifteen point. Gaps inside words traced back to Manim and Pango with Open Sans, so I switched to PT Sans. The supplied 4K outro turned out to be 478 by 850, so it was upscaled.",
      "voice": "bm_george",
      "engine": "kokoro",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "remotion": {
          "pattern": "ClaudeComposerAsk916",
          "props": {
            "greeting": "The polish,",
            "topic": "MEDHAVY · PROGRESS UPDATE",
            "segment": "Captions and Outro",
            "command": "fix captions --size 15pt --font \"PT Sans\"",
            "runningText": "rendering samples...",
            "folderLabel": "@HumanitariansAI",
            "output": [
              "Captions: 18 pt -> 15 pt",
              "In-word gaps: Pango + Open Sans",
              "Font: PT Sans",
              "\"4K\" outro was 478x850"
