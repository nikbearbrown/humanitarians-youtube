    {
      "beat_id": "B02",
      "act": "RETRIEVAL",
      "narration_text": "Grade retrieval with two numbers. Recall: of all the relevant chunks, how many did you actually retrieve? Miss some, and the answer can't be complete. Precision: of the chunks you retrieved, how many were relevant? Pull in junk, you distract the model. Both need a labeled set of right answers.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "hold",
        "show": [
          {
            "at": "Recall",
            "event": "the Relevant circle + recall ratio highlight"
          },
          {
            "at": "Precision",
            "event": "the Retrieved circle + precision ratio highlight (accent)"
          }
        ],
        "remotion": {
          "pattern": "ChipGrid",
          "props": {
            "caption": "measured against a labeled ground-truth set"
          },
          "rendered": {
            "out": "media/B02.mp4",
            "at": ""
          }
        }
      },
      "estimated_duration_s": 21,
