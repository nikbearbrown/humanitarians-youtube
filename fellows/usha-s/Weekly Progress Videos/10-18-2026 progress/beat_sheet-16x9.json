    {
      "beat_id": "B04",
      "act": "literature review",
      "narration_text": "My first literature review is The Ambiguities of Uncertainty: a review of uncertainty frameworks relevant to the assessment of environmental change, by Luke D. Bevan, published in Futures in twenty twenty two.",
      "voice": "af_bella",
      "engine": "kokoro",
      "voice_kokoro": "af_bella",
      "shot": {
        "type": "MANIM",
        "source": "manim",
        "manim": "scenes.py::B04_Paper",
        "visual_intent": "The citation card for paper one.",
