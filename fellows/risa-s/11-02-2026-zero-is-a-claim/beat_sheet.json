            "topic": "CLAUDE CODE · MEDHAVY TEXTBOOK",
            "segment": "The chapters still at zero",
            "greeting": "The search,",
            "runningText": "searching the zero chapters...",
            "folderLabel": "@HumanitariansAI"
          },
          "rendered": {
