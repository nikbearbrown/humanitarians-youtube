      }
    },
    {
      "beat_id": "B03",
      "act": "ASK",
      "role_note": "composer: the chapters that still say zero",
      "narration_text": "Then I checked the chapters that still showed zero. A search for the word figure in each one turned up chapter twenty-eight, where six captions had no colon after the number, so the pattern skipped all of them. Chapters twelve and thirty-four were false alarms: central figure, mitotic figures.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "slide",
        "remotion": {
          "pattern": "ClaudeComposerAsk",
          "props": {
