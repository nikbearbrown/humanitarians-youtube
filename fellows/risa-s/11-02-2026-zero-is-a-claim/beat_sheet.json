        "filled_by": "media",
        "at": "2026-11-19T18:41:29"
      }
    },
    {
      "beat_id": "B04",
      "act": "OUTPUT",
      "role_note": "fix two: the colon",
      "narration_text": "The second fix relaxed the pattern so it no longer requires a colon right after the number. After that, chapter fourteen went from two detected figures to ten. The earlier pattern had been silently missing a large number of existing figures across many chapters.",
      "visual_intent": "Real drifted caption names from the actual repo animating toward a clean sectioned scheme. Show the mechanism, not a count.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "rise",
        "remotion": {
          "pattern": "GitHubCodeDiff",
          "props": {
            "file": "FIGURE_RE: the changed part",
            "badge": "FIX 2",
            "lines": [
              {
                "gutter": "-",
                "text": "(:\\s*[^<]*</strong>)",
                "kind": "del"
              },
              {
                "gutter": "+",
                "text": "([^<]*</strong>)",
                "kind": "add"
              },
              {
                "gutter": "+",
                "text": "Chapter 14: 2 figures detected -> 10",
                "kind": "add"
              }
            ],
            "caption": "no colon required after the number"
          },
          "rendered": {
            "out": "media/B04.mp4",
            "at": ""
          }
        }
