    {
      "beat_id": "B01",
      "act": "PROBLEM",
      "role_note": "what the script saw, what the file had",
      "narration_text": "The first dry run said chapter one needed no changes, because it had no figure captions at all. But chapter one has figures. The captions were written with an extra space after the strong tag, and the pattern did not allow for it. The script had not found nothing. It had missed everything.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "slide",
        "remotion": {
          "pattern": "ClaudeCodeBeat",
          "props": {
            "title": "what the script saw, and what the file had",
            "code": "# what the script saw\nChapter 1: 0 captions found  ->  \"no changes needed\"\n\n# what the file had\n<strong> Figure 1.1: ... </strong>\n#        ^ a space after <strong>",
            "sparkLine": "Zero captions is not the same as no captions."
          },
          "rendered": {
            "out": "media/B01.mp4",
            "at": ""
          }
        }
      },
      "estimated_duration_s": 28,
      "overlay": {
        "credit": "Risa Samanta"
      },
      "audio_file": "mp3/beat-B01.mp3",
      "actual_duration_s": 17.62,
      "build": {
        "status": "VIDEO",
        "src": "media/B01.mp4",
        "filled_by": "media",
        "at": "2026-11-19T18:41:29"
      }
    },
    {
      "beat_id": "B02",
      "act": "OUTPUT",
      "role_note": "fix one: whitespace",
      "narration_text": "The fix was one small token: allow whitespace after the strong tag. Re-running every chapter then found three more figures in chapter one, and one more in chapter fourteen.",
      "visual_intent": "Real drifted caption names from the actual repo animating toward a clean sectioned scheme. Show the mechanism, not a count.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "rise",
        "remotion": {
          "pattern": "GitHubCodeDiff",
          "props": {
            "file": "FIGURE_RE: the changed part",
            "badge": "FIX 1",
            "lines": [
              {
                "gutter": "-",
                "text": "(<strong>Figure\\s+)",
                "kind": "del"
              },
              {
                "gutter": "+",
                "text": "(<strong>\\s*Figure\\s+)",
                "kind": "add"
              }
            ],
            "caption": "allow optional whitespace after <strong>"
          },
          "rendered": {
            "out": "media/B02.mp4",
            "at": ""
          }
        }
      },
      "estimated_duration_s": 22,
