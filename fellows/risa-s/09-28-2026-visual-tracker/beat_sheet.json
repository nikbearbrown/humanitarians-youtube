    {
      "beat_id": "B03",
      "act": "CODE",
      "role_note": "project structure, from the README",
      "narration_text": "The script is a handful of small files, each with one job: reading the Config sheet, colors and dropdowns, the change log, comments, filter views for each person, a setup checker, and optional email alerts. The helper functions are tested in Node before anything is pushed.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "ClaudeCodeBeat",
          "props": {
            "title": "project structure",
            "code": "src/\n  Code.js           menu, setup, onEdit trigger\n  Config.js         reads the Config sheet\n  Formatting.js     status colors + dropdowns\n  Log.js            change history sheet\n  Comments.js       \"Add comment\" action\n  FilterViews.js    per-person filter views\n  Validate.js       \"Check for problems\"\n  Alerts.js         optional email alerts\n  lib.js            pure helpers, unit-tested in Node",
            "sparkLine": "Each file has one job."
          },
          "rendered": {
