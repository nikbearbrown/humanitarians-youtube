    {
      "beat_id": "B03",
      "act": "Act 2 — the lifecycle",
      "narration_text": "Ingestion — every asset enters through one door, not scattered folders. Metadata — tagged at intake, so it's searchable, not just stored. Taxonomy — a structure the whole team actually follows. Naming conventions — consistent, so a file's name tells you what it is before you open it. QA — nothing goes live without a check. Governance — rules that keep the system clean as it scales.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 24,
