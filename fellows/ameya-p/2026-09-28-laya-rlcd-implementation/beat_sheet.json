        "filled_by": "remotion:NikBearBrownTerminalAsk",
        "at": "2026-10-03T14:03:39"
      }
    },
    {
      "beat_id": "B04",
      "act": "CONCEPT",
      "narration_text": "The engine itself, rl_training dot py, handles the optimization step. It runs the forward pass, applies Group Relative Policy Optimization logit perturbations, calculates the calibration reward, and updates the parameters with decoupled learning rates.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "NikBearBrownTerminalAsk",
          "props": {
            "command": "head rlcd/rl_training.py",
            "topic": "LAYA MODEL \u00c2\u00b7 IMPLEMENTATION",
            "segment": "Code Output",
            "runningText": "tail -n 5 rlcd/rl_training.py",
            "output": [
              "loss_rl = -adv * log_p",
              "loss_ce = -y * log_softmax(logits)",
              "loss = (loss_rl + w_ce * loss_ce) / accum"
            ]
          },
          "rendered": {
            "out": "media/B04.mp4",
            "at": "2026-10-03T20:59:54.015158+00:00"
          }
        }
