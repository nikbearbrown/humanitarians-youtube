    {
      "beat_id": "B03",
      "act": "CONCEPT",
      "narration_text": "Next is the reward strategy. Using strictly proper scoring rules, like the Brier score, ensures the agent's reward is maximized only when its reported confidence exactly matches the true probability of correctness.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "NikBearBrownTerminalAsk",
          "props": {
            "command": "cat rlcd/reward_strategies/brier.py",
            "topic": "LAYA MODEL \u00c2\u00b7 IMPLEMENTATION",
            "segment": "Code Output",
            "runningText": "grep 'reward' rlcd/reward_strategies/brier.py",
            "output": [
              "def reward(confidence, outcome):",
              "    return -(confidence - outcome)**2"
            ]
          },
          "rendered": {
            "out": "media/B03.mp4",
            "at": "2026-10-03T20:57:28.405895+00:00"
          }
        }
      },
      "audio_file": "mp3/beat-B03.mp3",
      "actual_duration_s": 12.99,
      "render_duration_s": 13.0,
