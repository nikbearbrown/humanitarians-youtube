    {
      "beat_id": "B04",
      "act": "APPROACH",
      "narration_text": "The simplest fix: score each decision with a proper scoring rule. Negative confidence minus outcome, squared. Only one policy maximizes it, stating your real probability of being right. No auxiliary model, no aggregation. Just a per-sample reward, straight into the policy update.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "voice_kokoro": "am_onyx",
      "estimated_duration_s": 20,
      "audio_file": "mp3/beat-B04.mp3",
