            "rows": [
              {
                "src": "data:image/svg+xml;base64,",
                "aspect": 13.76,
                "expression": "reward = -(confidence - outcome)^2",
                "at": 0
              }
            ],
            "note": "Maximized only when stated confidence matches the true probability of being correct.",
            "conditions": "Negative Brier score · per-sample · no aggregation needed"
