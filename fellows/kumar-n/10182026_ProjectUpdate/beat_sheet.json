            "event": "model block appears"
          },
          {
            "at": 2.6,
            "event": "prune / quantize / distill: block shrinks"
          },
          {
            "at": 9.2,
            "event": "arrow to field device"
          },
          {
            "at": 12.6,
            "event": "'Accuracy on real SERS? Untested' card"
          },
          {
