      "beat_id": "B00",
      "act": "ASK",
      "narration_text": "Jambo. I'm Liam, in for Kumar Karthik. Two more weeks, one more section: four point five, training strategies for limited data. The old draft listed two strategies. The new one says when to use each, and how far the evidence really goes. Here's what changed.",
      "new_visual_element": "Composer: what changed in 4.5?",
      "shot": {
        "type": "REMOTION",
        "remotion": {
          "pattern": "ClaudeComposerAsk",
          "props": {
            "greeting": "Jambo, Liam",
            "topic": "SERS-ML · PAPER 2 · §4.5",
            "segment": "Section 4.5 Update",
            "command": "/review what changed in section 4.5?",
            "runningText": "diffing draft against final…",
            "folderLabel": "@KumarKarthik",
            "output": [
              "1. Strategy matched to the bottleneck",
              "2. Gap claim → SMAE + SemiRaman evidence",
              "3. Caveat: Raman, not yet SERS"
            ]
          },
          "rendered": {
            "out": "media/B00.mp4",
            "at": "2026-10-19T01:12:42.510061+00:00"
          }
        }
      },
      "audio_file": "mp3/beat-B00.mp3",
      "actual_duration_s": 14.02,
      "render_duration_s": 14.041666666666666,
      "build": {
        "status": "VIDEO",
