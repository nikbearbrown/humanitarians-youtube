            "at": "2026-10-19T02:39:15.910271+00:00"
          }
        }
      },
      "audio_file": "mp3/beat-B01.mp3",
      "actual_duration_s": 6.74,
      "render_duration_s": 6.75,
      "build": {
        "status": "VIDEO",
