        "type": "REMOTION",
        "remotion": {
          "pattern": "ClaudeComposerAsk",
          "props": {
            "greeting": "Bonjour, Liam",
            "topic": "SERS · SUBSTRATES",
            "segment": "Gold vs. Silver",
            "command": "/explain should I use gold or silver for my SERS substrate?",
            "runningText": "checking plasmon resonance…",
            "folderLabel": "@KumarKarthik",
            "output": [
              "1. Match the metal to the laser",
              "2. Silver + 532 nm, gold + 785 nm",
              "3. Test on your real substrate"
            ]
