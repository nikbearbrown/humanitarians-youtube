        "filled_by": "manim",
        "at": "2026-10-18T22:57:19"
      }
    },
    {
      "beat_id": "B04",
      "act": "TWIST",
      "narration_text": "Here's the twist. Hot spots form where particles cluster, and clustering shifts the resonance toward the red. So the absorbance peak of your particle suspension is an unreliable guide to the best laser. A 2014 study found exactly that, for both gold and silver. Test your actual substrate at your actual wavelength.",
      "new_visual_element": "Aggregation red-shift",
      "shot": {
        "type": "GRAPHIC",
        "source": "own",
        "lane": "manim",
        "show": [
          {
            "at": 0.0,
            "event": "title + footer"
          },
          {
            "at": 0.8,
            "event": "isolated particle + grey band"
          },
          {
            "at": 4.4,
            "event": "cluster + orange band (red-shifted)"
          },
          {
            "at": 8.2,
            "event": "red-shift arrow + legend"
          },
          {
            "at": 10.6,
            "event": "laser moves from grey peak to orange peak"
          },
          {
            "at": 14.1,
            "event": "kicker"
          }
        ]
      },
      "graphic": {
        "engine": "manim",
        "manim": "B04_ClusterShift",
        "production_viz": {
          "label": "Clusters shift the peak",
          "mechanic": "Second resonance band appears to the red; laser line follows it",
          "note": "SCHEMATIC. Ameer et al. 2014: nanoparticle UV-vis intensity is an unreliable predictor of optimal excitation wavelength for AuNPs and AgNPs; enhancement is far more sensitive to aggregation state."
        }
      },
      "audio_file": "mp3/beat-B04.mp3",
