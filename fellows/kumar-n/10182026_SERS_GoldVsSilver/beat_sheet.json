    },
    {
      "beat_id": "B03",
      "act": "PAIRING",
      "narration_text": "In practice, that gives a common pairing: silver with a green, five thirty-two nanometre laser, and gold with a near-infrared, seven eighty-five. A 2022 glyphosate study tested both metals at three laser lines, and got its best results with exactly those two pairings.",
      "new_visual_element": "Ag+532 / Au+785",
      "shot": {
        "type": "GRAPHIC",
        "source": "own",
        "lane": "manim",
        "show": [
          {
            "at": 0.0,
            "event": "title + footer"
          },
          {
            "at": 0.8,
            "event": "silver + 532 nm"
          },
          {
            "at": 3.6,
            "event": "gold + 785 nm"
          },
          {
            "at": 6.4,
            "event": "Mikac et al. 2022 caption"
          },
          {
            "at": 10.0,
            "event": "kicker"
          }
        ]
      },
      "graphic": {
        "engine": "manim",
        "manim": "B03_CommonPairing",
        "production_viz": {
          "label": "The common pairing",
          "mechanic": "Two cards, then a study caption",
          "note": "Mikac et al. (2022) Molecules 27(18):5767 — best glyphosate results with Ag NPs at 532 nm and Au NPs at 785 nm. Same pairing used by commercial substrates (e.g. Ocean Optics RAM-SERS)."
        }
      },
      "audio_file": "mp3/beat-B03.mp3",
      "actual_duration_s": 15.7,
      "render_duration_s": 15.708333333333334,
      "build": {
        "status": "MANIM",
