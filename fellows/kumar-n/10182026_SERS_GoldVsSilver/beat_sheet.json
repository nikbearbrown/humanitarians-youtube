    {
      "beat_id": "B02",
      "act": "RESONANCE",
      "narration_text": "SERS enhancement is strongest when your laser drives the metal's plasmon, the collective oscillation of its electrons, near resonance. Off resonance, the field boost drops. So the right metal is the one whose resonance lines up with the light you shine on it.",
      "new_visual_element": "Laser meets resonance",
      "shot": {
        "type": "GRAPHIC",
        "source": "own",
        "lane": "manim",
        "show": [
          {
            "at": 0.0,
            "event": "title + footer"
          },
          {
            "at": 0.8,
            "event": "wavelength axis + plasmon band"
          },
          {
            "at": 3.2,
            "event": "laser line + meter (off resonance)"
          },
          {
            "at": 5.9,
            "event": "laser slides toward resonance"
          },
          {
            "at": 8.1,
            "event": "laser on resonance; meter full"
          },
          {
            "at": 11.3,
            "event": "kicker"
          }
        ]
      },
      "graphic": {
        "engine": "manim",
        "manim": "B02_RideResonance",
        "production_viz": {
          "label": "Ride the resonance",
          "mechanic": "Laser line slides onto a resonance band; enhancement meter rises",
          "note": "SCHEMATIC: band shape and meter are not data."
        }
      },
      "audio_file": "mp3/beat-B02.mp3",
      "actual_duration_s": 13.61,
