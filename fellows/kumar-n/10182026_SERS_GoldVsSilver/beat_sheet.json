        ]
      },
      "graphic": {
        "engine": "manim",
        "manim": "B05_ShelfLife",
        "production_viz": {
          "label": "Brightness vs shelf life",
          "mechanic": "Silver bar shrinks over two steps; gold barely changes",
          "note": "SCHEMATIC decay. Silver oxidation lowers SERS performance over time; gold more stable (e.g. Univ. of Baghdad study on aged Au vs Ag NP sensors; Ag oxidation noted in arXiv:2510.14706). Ag-dominant enhancement in Au–Ag comparison: arXiv:2510.14706."
        }
      },
