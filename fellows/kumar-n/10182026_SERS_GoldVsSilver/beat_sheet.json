    },
    {
      "beat_id": "B05",
      "act": "STABILITY",
      "narration_text": "Then there's shelf life. Silver often gives stronger enhancement, but it oxidizes, and its signal can fade over time. Gold is more stable. So the trade-off isn't just brightness, it's how long that brightness lasts.",
      "new_visual_element": "Silver fades, gold holds",
      "shot": {
        "type": "GRAPHIC",
        "source": "own",
        "lane": "manim",
        "show": [
          {
            "at": 0.0,
            "event": "title + footer"
          },
          {
            "at": 1.2,
            "event": "silver and gold signal bars"
          },
          {
            "at": 4.7,
            "event": "time passes: silver fades, gold holds"
          },
          {
            "at": 9.3,
            "event": "caption; kicker"
