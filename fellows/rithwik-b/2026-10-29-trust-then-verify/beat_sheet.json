          "pattern": "ClaudeCodeBeat",
          "props": {
            "title": "build_safety.py",
            "language": "python",
            "largeText": true,
            "brandLabel": "@HumanitariansAI",
            "sparkLine": "It only checks a file.",
            "code": "def require_paperwork(folder):\n    for name in ('FACTCHECK.md', 'SHOTLIST.md', 'PROMPTS.md'):\n        p = Path(folder) / name\n        if not p.is_file() or not p.read_text().strip():\n            raise BuildError(f'GATE F: missing or empty {name}; '\n                             'review is allowed, final is blocked')",
            "durationSeconds": 14.31
