# Media policy per fellows/README.md, rule of 2026-09-18:
# renders stay OUT, build inputs stay IN — excluded by LOCATION, not file type.
#
# OUT — produced by the pipeline from the beat sheet:
mp3/
audio/
media/
clips/
renders/
mp4/
_qc/
_work/
*-slate.mp4
*-cut.mp4

# IN, deliberately NOT ignored: beat_sheet.json, timings.json (kept at the
# folder root because mp3/ is an excluded location), QC contact sheets.

.venv/
__pycache__/
.DS_Store
Thumbs.db
