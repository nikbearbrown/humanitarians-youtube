        "src": "manim\\B05.mp4",
        "filled_by": "manim:B05",
        "at": "2026-09-11T15:59:59"
      }
    },
    {
      "beat_id": "B06",
      "act": "STATEMENT",
      "narration_text": "And here's the test: read a chunk alone. If it says 'increased forty percent due to this factor' with no subject, the chunking is broken.",
