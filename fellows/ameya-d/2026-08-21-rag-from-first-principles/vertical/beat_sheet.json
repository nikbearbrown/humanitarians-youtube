        "at": "2026-08-31T12:56:00"
      }
    },
    {
      "beat_id": "B05",
      "act": "STATEMENT",
      "narration_text": "But watch the top-k bug. Sort descending, or you will confidently return the least relevant chunks instead of the best.",
