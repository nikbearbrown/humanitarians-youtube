        "at": "2026-09-07T22:30:13"
      }
    },
    {
      "beat_id": "B03",
      "act": "LIST",
      "narration_text": "Exact caching keys on the question string. Semantic caching catches paraphrases. And the prompt cache bills a stable prefix at a fraction on reads.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B03",
          "file": "scenes.py"
        }
      },
      "audio_file": "mp3/beat-B03.mp3",
      "actual_duration_s": 9.05,
      "build": {
        "status": "MANIM",
        "src": "manim\\B03.mp4",
        "filled_by": "manim:B03",
        "at": "2026-09-07T22:30:13"
      }
    },
    {
      "beat_id": "B04",
      "act": "STATEMENT",
      "narration_text": "But semantic caching has a trap. Set the threshold too loose and you serve the answer to a different question — confidently. Evaluate it like retrieval.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B04",
          "file": "scenes.py"
        }
      },
      "audio_file": "mp3/beat-B04.mp3",
      "actual_duration_s": 10.24,
      "build": {
        "status": "MANIM",
        "src": "manim\\B04.mp4",
        "filled_by": "manim:B04",
        "at": "2026-09-07T22:30:13"
      }
    },
    {
      "beat_id": "B05",
      "act": "STATEMENT",
      "narration_text": "And invalidation is the genuinely hard part. When a document changes, tag your cached answers by source and purge them, or serve stale answers forever.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B05",
