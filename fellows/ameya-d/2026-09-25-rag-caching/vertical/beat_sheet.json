        "at": "2026-09-07T22:30:13"
      }
    },
    {
      "beat_id": "B06",
      "act": "STATEMENT",
      "narration_text": "Among your cost levers, cache first — then route easy queries, trim the context, and lean on the prompt cache. Nothing beats work you skip.",
