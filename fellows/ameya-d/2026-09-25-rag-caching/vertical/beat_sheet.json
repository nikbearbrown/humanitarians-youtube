    {
      "beat_id": "B02",
      "act": "STATEMENT",
      "narration_text": "A cold request runs the whole pipeline — over a second. A cache hit takes two microseconds, because it skips all of it.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B02",
          "file": "scenes.py"
        }
