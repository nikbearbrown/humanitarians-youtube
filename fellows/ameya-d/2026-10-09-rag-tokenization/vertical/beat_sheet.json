        "at": "2026-09-11T16:07:37"
      }
    },
    {
      "beat_id": "B02",
      "act": "STATEMENT",
      "narration_text": "Before a model reads text, it becomes tokens from a fixed vocabulary. A common word is one token. Everything else gets shredded into pieces.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B02",
          "file": "scenes.py"
        }
      },
      "audio_file": "mp3/beat-B02.mp3",
      "actual_duration_s": 8.68,
      "build": {
        "status": "MANIM",
        "src": "manim\\B02.mp4",
        "filled_by": "manim:B02",
        "at": "2026-09-11T16:07:37"
      }
    },
    {
      "beat_id": "B03",
      "act": "STATEMENT",
      "narration_text": "Two strings, both twenty characters. The plain sentence is six tokens. The dollar figure with EBITDA and a ticker is thirteen — more than double.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B03",
          "file": "scenes.py"
        }
      },
      "audio_file": "mp3/beat-B03.mp3",
      "actual_duration_s": 9.73,
      "build": {
        "status": "MANIM",
        "src": "manim\\B03.mp4",
        "filled_by": "manim:B03",
        "at": "2026-09-11T16:07:37"
      }
    },
    {
      "beat_id": "B04",
      "act": "LIST",
      "narration_text": "Characters per token tells the story. Business prose runs about eight. Everyday English, four. Dense financial text drops to one point six seven.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B04",
          "file": "scenes.py"
        }
      },
      "audio_file": "mp3/beat-B04.mp3",
      "actual_duration_s": 9.0,
      "build": {
        "status": "MANIM",
        "src": "manim\\B04.mp4",
        "filled_by": "manim:B04",
        "at": "2026-09-11T16:07:37"
      }
    },
    {
      "beat_id": "B05",
      "act": "STATEMENT",
      "narration_text": "So financial text costs two to three times more tokens — which hits your bill, your context window, and truncation all at once.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B05",
          "file": "scenes.py"
        }
      },
      "audio_file": "mp3/beat-B05.mp3",
      "actual_duration_s": 8.94,
      "build": {
        "status": "MANIM",
        "src": "manim\\B05.mp4",
        "filled_by": "manim:B05",
        "at": "2026-09-11T16:07:37"
      }
    },
    {
      "beat_id": "B06",
      "act": "STATEMENT",
      "narration_text": "And a popular model silently discards anything past three hundred eighty-four tokens — no warning. Measure in tokens, not characters.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B06",
          "file": "scenes.py"
        }
      },
      "audio_file": "mp3/beat-B06.mp3",
      "actual_duration_s": 9.56,
      "build": {
        "status": "MANIM",
        "src": "manim\\B06.mp4",
        "filled_by": "manim:B06",
        "at": "2026-09-11T16:07:37"
      }
    },
    {
      "beat_id": "B07",
      "act": "TITLE",
      "narration_text": "Count in tokens, not characters, and nothing gets thrown away in silence. This is Liam, in for Ameya.",
