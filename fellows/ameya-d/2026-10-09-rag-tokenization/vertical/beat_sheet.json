      "beat_id": "B01",
      "act": "TITLE",
      "narration_text": "Namaste — this is Liam, in for Ameya. Why financial text costs more, in ninety seconds.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B01",
