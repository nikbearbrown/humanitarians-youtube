        "at": "2026-09-07T22:23:09"
      }
    },
    {
      "beat_id": "B04",
      "act": "LIST",
      "narration_text": "Three options. Flat is exact and fine under a hundred thousand. HNSW is a graph you walk. IVF is a set of clusters you skip.",
      "shot": {
