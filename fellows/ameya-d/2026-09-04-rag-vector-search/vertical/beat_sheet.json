        "at": "2026-09-07T22:23:09"
      }
    },
    {
      "beat_id": "B05",
      "act": "STATEMENT",
      "narration_text": "HNSW drops you in at the top and takes big hops toward the neighborhood, then small ones. Log-n time, high recall — the cost is memory.",
