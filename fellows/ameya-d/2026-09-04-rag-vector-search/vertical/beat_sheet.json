    {
      "beat_id": "B02",
      "act": "STATEMENT",
      "narration_text": "Brute force compares your query against every vector. Fine at fifteen hundred — four milliseconds. At ten million, it's minutes. That's why approximate search exists.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B02",
          "file": "scenes.py"
        }
      },
      "audio_file": "mp3/beat-B02.mp3",
      "actual_duration_s": 10.52,
      "build": {
        "status": "MANIM",
        "src": "manim\\B02.mp4",
        "filled_by": "manim:B02",
        "at": "2026-09-07T22:23:09"
      }
    },
    {
      "beat_id": "B03",
      "act": "STATEMENT",
      "narration_text": "And every index makes the same trade: recall, against latency, against memory. Pick the corner that fits your problem.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B03",
          "file": "scenes.py"
        }
