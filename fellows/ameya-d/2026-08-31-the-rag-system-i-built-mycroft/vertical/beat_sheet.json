        "at": "2026-08-31T12:52:36"
      }
    },
    {
      "beat_id": "B02",
      "act": "STATEMENT",
      "narration_text": "Chunking moved quality more than anything. Switching from a naive split to recursive splitting took retrieval M R R from zero point eight three to a perfect one point zero.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B02",
          "file": "scenes.py"
        }
      },
      "audio_file": "mp3/beat-B02.mp3",
      "actual_duration_s": 10.54,
      "build": {
        "status": "MANIM",
        "src": "manim\\B02.mp4",
        "filled_by": "manim:B02",
        "at": "2026-08-31T12:52:36"
      }
    },
    {
      "beat_id": "B03",
      "act": "LIST",
      "narration_text": "Three results surprised me. A smaller model beat a larger one. Hit rate saturates while M R R still discriminates. And vector search is two tenths of a percent of the latency.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B03",
          "file": "scenes.py"
        }
      },
      "audio_file": "mp3/beat-B03.mp3",
      "actual_duration_s": 10.45,
      "build": {
        "status": "MANIM",
        "src": "manim\\B03.mp4",
        "filled_by": "manim:B03",
        "at": "2026-08-31T12:52:36"
      }
    },
    {
      "beat_id": "B04",
      "act": "STATEMENT",
      "narration_text": "Hybrid search beat either half alone. Dense plus keyword, fused by rank, lifted M R R from zero point six five to zero point eight one.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B04",
          "file": "scenes.py"
        }
      },
      "audio_file": "mp3/beat-B04.mp3",
      "actual_duration_s": 8.96,
      "build": {
        "status": "MANIM",
        "src": "manim\\B04.mp4",
        "filled_by": "manim:B04",
        "at": "2026-08-31T12:52:36"
      }
    },
    {
      "beat_id": "B05",
      "act": "LIST",
      "narration_text": "And where does the time go. Search, four milliseconds. Rerank, three hundred. The model, over a thousand. Optimise the cache first, not the vector math.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B05",
          "file": "scenes.py"
        }
      },
      "audio_file": "mp3/beat-B05.mp3",
      "actual_duration_s": 8.68,
      "build": {
        "status": "MANIM",
        "src": "manim\\B05.mp4",
        "filled_by": "manim:B05",
        "at": "2026-08-31T12:52:36"
      }
    },
    {
      "beat_id": "B06",
      "act": "STATEMENT",
      "narration_text": "The lesson from all of it: measure before you optimise. The surprises are exactly where the wins are.",
