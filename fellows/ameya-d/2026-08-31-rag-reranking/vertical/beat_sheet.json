        "filled_by": "manim:B03",
        "at": "2026-08-31T12:23:17"
      }
    },
    {
      "beat_id": "B04",
      "act": "TWO-STAGE",
      "narration_text": "So retrieve wide, then rerank narrow. Pull twenty candidates fast, then keep the best three. You get the recall of a big search and the precision of a slow, careful model.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B04",
          "file": "scenes.py"
