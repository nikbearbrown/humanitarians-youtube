    },
    {
      "beat_id": "B03",
      "act": "ENCODERS",
      "narration_text": "Two encoders tell the whole story. A bi-encoder encodes them separately, so it is fast and it retrieves. A cross-encoder reads them together, so it is accurate — and it only reranks.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B03",
          "file": "scenes.py"
        }
      },
      "audio_file": "mp3/beat-B03.mp3",
      "actual_duration_s": 11.9,
      "build": {
