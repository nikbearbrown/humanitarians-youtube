    {
      "beat_id": "B05",
      "act": "OFFLINE",
      "narration_text": "The important architectural choice is offline operation. Researchers may be handling large amounts of footage without reliable internet, so the interface should let the work continue locally and sync when connectivity returns.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
