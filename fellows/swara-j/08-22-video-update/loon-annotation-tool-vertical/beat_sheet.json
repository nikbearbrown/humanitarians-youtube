    {
      "beat_id": "B02",
      "act": "WORKFLOW",
      "narration_text": "The workflow is deliberately straightforward: upload the footage, extract frames, display one frame, choose the loon label, draw a box, and save the annotation.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "stagger",
        "remotion": {
          "pattern": "ClaudeScienceChipGrid916",
          "props": {
            "sparkLine": "One clean loop.",
            "items": [
              "Upload footage",
              "Extract frames",
              "Open a frame",
              "Choose Loon",
              "Draw the box",
              "Save annotation"
            ],
            "cols": 2,
            "caption": "Simple enough for a researcher, structured enough for a dataset."
          },
          "rendered": {
            "out": "media/B02.mp4",
            "at": ""
          }
        }
      },
      "estimated_duration_s": 11,
      "audio_file": "mp3/beat-B02.mp3",
