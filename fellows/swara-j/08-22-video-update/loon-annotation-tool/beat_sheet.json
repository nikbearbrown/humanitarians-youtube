    },
    {
      "beat_id": "B02",
      "act": "WORKFLOW",
      "narration_text": "The workflow is deliberately straightforward: upload the footage, extract frames, display one frame, choose the loon label, draw a box, and save the annotation.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "stagger",
        "show": {
          "events": [
            {
              "at": 0.1,
              "event": "the six workflow steps arrive one by one in order"
            },
            {
              "at": 0.8,
              "event": "the saved annotation settles as the result"
            }
          ]
        },
        "remotion": {
          "pattern": "ClaudeScienceChipGrid",
          "props": {
            "sparkLine": "One clean loop.",
            "items": [
              "Upload footage",
              "Extract frames",
              "Open a frame",
              "Choose Loon",
              "Draw the box",
              "Save annotation"
            ],
            "cols": 3,
            "caption": "Simple enough for a researcher, structured enough for a dataset."
          },
          "rendered": {
            "out": "media/B02.mp4",
            "at": ""
          }
        }
      },
