    {
      "beat_id": "B07",
      "act": "LOOP",
      "narration_text": "Eventually, the process can work in reverse. The model proposes a box, the researcher verifies or corrects it, and that correction becomes another training example. That is the human-in-the-loop system we're aiming for.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "show": {
          "events": [
            {
              "at": 0.15,
              "event": "the model proposes a loon box"
            },
            {
              "at": 0.45,
              "event": "a researcher corrects the box"
            },
            {
              "at": 0.75,
              "event": "the corrected example loops back into training"
            }
          ]
        },
        "remotion": {
          "pattern": "ClaudeScienceChipGrid",
