        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "show": {
          "events": [
            {
              "at": 0.2,
              "event": "the single Loon label lands in terracotta"
            },
            {
              "at": 0.55,
              "event": "box controls appear around the target"
            },
            {
              "at": 0.82,
              "event": "extra labels fade away, leaving one focused tool"
            }
          ]
        },
        "remotion": {
          "pattern": "ClaudeScienceLayerStack",
          "props": {
