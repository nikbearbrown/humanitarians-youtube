    {
      "beat_id": "B04",
      "act": "STACK",
      "narration_text": "On the frontend, we're planning React and TypeScript for the annotation interface. The backend will use Python and FastAPI, with PostgreSQL storing projects, frames, and annotations. FFmpeg handles frame extraction.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "stagger",
        "show": {
          "events": [
            {
              "at": 0.12,
              "event": "frontend and backend layers stack into the platform"
            },
            {
              "at": 0.48,
              "event": "PostgreSQL attaches to the data layer"
            },
            {
              "at": 0.78,
              "event": "FFmpeg feeds extracted frames into the interface"
            }
          ]
        },
        "remotion": {
