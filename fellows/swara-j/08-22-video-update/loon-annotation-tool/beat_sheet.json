    {
      "beat_id": "B01",
      "act": "WHY",
      "narration_text": "Before an AI model can detect loons, we have to teach it what a loon looks like in our footage. A researcher identifies each bird and draws a bounding box around it. Those boxes become ground-truth data.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "show": {
          "events": [
            {
              "at": 0.15,
              "event": "a raw frame label appears"
            },
            {
              "at": 0.45,
              "event": "a loon target is isolated"
            },
            {
              "at": 0.75,
              "event": "a terracotta bounding box locks around it"
            }
          ]
        },
        "remotion": {
          "pattern": "ClaudeScienceLayerStack",
          "props": {
            "sparkLine": "Teach the model what counts.",
            "layers": [
              {
                "title": "Raw drone frame",
                "sub": "pixels with no answer yet"
              },
              {
                "title": "Researcher annotation",
                "sub": "one loon, boxed by a human",
                "accent": true
              },
              {
                "title": "Ground-truth example",
                "sub": "a labeled target the model can learn from"
              }
            ],
            "caption": "Human judgment becomes training data."
          },
          "rendered": {
            "out": "media/B01.mp4",
            "at": ""
          }
        }
      },
      "estimated_duration_s": 12,
