                "title": "Box controls",
                "sub": "move · resize · delete"
              },
              {
                "title": "Save",
                "sub": "commit the annotation to the project"
              }
            ],
            "caption": "Scope is a feature when the workflow is new."
          },
          "rendered": {
            "out": "media/B03.mp4",
