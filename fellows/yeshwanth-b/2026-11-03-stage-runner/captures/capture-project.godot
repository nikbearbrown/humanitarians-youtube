; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Stage Runner"
config/description="Fly the blue wisp up three ruined city stages, blast the monster army and defeat the Cerberus."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://assets/ui/icon.png"
config/use_custom_user_dir=true
config/custom_user_dir_name="stage-runner-filmcapture"

[audio]

default_bus_layout="res://default_bus_layout.tres"

[autoload]

Audio="*res://scripts/audio.gd"
GameState="*res://scripts/game_state.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=3840
window/size/window_height_override=2160
window/size/borderless=true
window/size/always_on_top=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemies"
2d_physics/layer_4="player_bullets"
2d_physics/layer_5="enemy_bullets"
2d_physics/layer_6="pickups"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
