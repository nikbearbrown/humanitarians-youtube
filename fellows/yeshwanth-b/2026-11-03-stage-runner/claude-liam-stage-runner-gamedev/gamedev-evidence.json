 "excerpts": [
  {
   "beat_id": "B03",
   "path": "scenes/stage_1.tscn",
   "start_line": 1,
   "end_line": 7,
   "text": "[gd_scene load_steps=2 format=3]\n\n[ext_resource type=\"Script\" path=\"res://scripts/game.gd\" id=\"1_game\"]\n\n[node name=\"Stage1\" type=\"Node2D\"]\nscript = ExtResource(\"1_game\")\nstage_id = 1"
  },
  {
   "beat_id": "B05",
   "path": "scripts/game.gd",
   "start_line": 19,
   "end_line": 33,
   "text": "const STAGES := {\n\t1: {\n\t\t\"name\": \"Ruined Street\",\n\t\t\"tile\": \"res://assets/world/stage1_tile.png\",\n\t\t\"cover\": \"res://assets/world/stage1.jpg\",\n\t\t\"tint\": Color(1, 1, 1),\n\t\t\"scroll\": 70.0,\n\t\t\"interval\": 2.0,        # Army.cs\n\t\t\"min_interval\": 1.3,\n\t\t\"goal\": 2000,\n\t\t\"speed_scale\": 1.0,\n\t\t\"drop_chance\": 0.07,\n\t\t\"army\": [\"worm_green\", \"slime_green\", \"rat_brown\", \"boneworm_green\", \"worm_brown\"],\n\t\t\"music\": \"stage\",\n\t\t\"boss\": false,"
  },
  {
   "beat_id": "B07",
   "path": "scripts/player.gd",
   "start_line": 95,
   "end_line": 102,
   "text": "\t\t\tmove = Input.get_vector(\"move_left\", \"move_right\", \"move_up\", \"move_down\")\n\t\t\twants_fire = Input.is_action_pressed(\"fire\")\n\t\t\tfocus = Input.is_action_pressed(\"focus\")\n\tvar speed := MOVE_SPEED * (FOCUS_FACTOR if focus else 1.0)\n\tposition += move.limit_length(1.0) * speed * delta\n\t# MainChar clamps to the camera bounds; here the bounds are the playfield.\n\tposition.x = clampf(position.x, field.position.x + 28, field.end.x - 28)\n\tposition.y = clampf(position.y, field.position.y + 34, field.end.y - 30)"
  },
  {
   "beat_id": "B09",
   "path": "scripts/player.gd",
   "start_line": 122,
   "end_line": 131,
   "text": "func _shoot() -> void:\n\tvar angles: Array = [0.0]\n\tif spread_time > 0.0:\n\t\tangles = [-0.2, 0.0, 0.2]\n\tfor angle in angles:\n\t\tvar bullet := BulletScript.new()\n\t\tbullet.position = position + Vector2(0, -30)\n\t\tbullet.velocity = Vector2.UP.rotated(angle) * BULLET_SPEED\n\t\tbullet.field = field\n\t\tbullet_parent.add_child(bullet)"
  },
  {
   "beat_id": "B11",
   "path": "scripts/enemy.gd",
   "start_line": 96,
   "end_line": 108,
   "text": "\tposition.y += speed * delta\n\tmatch pattern:\n\t\t\"weave\":\n\t\t\tposition.x = base_x + sin(age * 2.4 + phase) * 70.0\n\t\t\"hunt\":\n\t\t\tif is_instance_valid(target) and target.visible and position.y < target.position.y:\n\t\t\t\tbase_x = move_toward(base_x, target.position.x, 70.0 * delta)\n\t\t\tposition.x = base_x\n\t\t\tsprite.flip_h = target != null and is_instance_valid(target) and target.position.x > position.x\n\t\t\"hop\":\n\t\t\tvar squash := sin(age * 6.0 + phase)\n\t\t\tsprite.scale = Vector2(1.0 + squash * 0.08, 1.0 - squash * 0.08)\n\tposition.x = clampf(position.x, field.position.x + 30, field.end.x - 30)"
  },
  {
   "beat_id": "B13",
   "path": "scripts/game.gd",
   "start_line": 511,
   "end_line": 516,
   "text": "func _drop_pickup(at: Vector2) -> void:\n\tvar pickup := PickupScript.new()\n\tpickup.kind = \"heart\" if player.lives < PlayerScript.MAX_LIVES and randf() < 0.4 else \"spread\"\n\tpickup.field = FIELD\n\tpickup.position = at\n\tworld.call_deferred(\"add_child\", pickup)"
  },
  {
   "beat_id": "B15",
   "path": "scripts/player.gd",
   "start_line": 152,
   "end_line": 164,
   "text": "func take_hit() -> void:\n\tif invulnerable > 0.0 or not alive:\n\t\treturn\n\tlives -= 1\n\tAudio.play(\"player_hit\")\n\thit.emit(lives)\n\tif lives <= 0:\n\t\talive = false\n\t\tvisible = false\n\t\tset_deferred(\"monitoring\", false)\n\t\tdied.emit()\n\telse:\n\t\tinvulnerable = INVULNERABLE_TIME"
  },
  {
   "beat_id": "B17",
   "path": "scripts/game.gd",
   "start_line": 550,
   "end_line": 558,
   "text": "func _show_game_over() -> void:\n\t# MainChar: gameOverScreen.SetActive(true); Time.timeScale = 0\n\tif config.boss:\n\t\tgame_over_score.text = \"Score: %d\\nThe Cerberus still guards the gate.\" % score\n\telse:\n\t\tgame_over_score.text = \"Score: %d     /%d\" % [score, config.goal]\n\tgame_over_menu.visible = true\n\tget_tree().paused = true\n\tgame_over_menu.get_meta(\"buttons\")[0].grab_focus()"
  },
  {
   "beat_id": "B19",
   "path": "scripts/game.gd",
   "start_line": 579,
   "end_line": 591,
   "text": "\tbanner.scale = Vector2(0.4, 0.4)\n\tvar tween := create_tween()\n\ttween.tween_property(banner, \"scale\", Vector2.ONE, 0.45).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)\n\ttween.tween_interval(0.6)\n\t# The wisp runs off the top of the screen toward the next stage.\n\ttween.tween_property(player, \"position:y\", -80.0, 1.1).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)\n\ttween.tween_interval(0.4)\n\ttween.tween_callback(func():\n\t\tGameState.complete_stage(stage_id, score, kills)\n\t\tif stage_id >= GameState.STAGE_COUNT:\n\t\t\tGameState.go_to(\"game_clear\")   # GameManager: SceneManager.LoadScene(\"ClearTheGame\")\n\t\telse:\n\t\t\tGameState.go_to(\"stage_clear\"))  # GameManager: SceneManager.LoadScene(\"FinishStageOne\")"
  },
  {
   "beat_id": "B21",
   "path": "scripts/boss.gd",
   "start_line": 94,
   "end_line": 106,
   "text": "func _attack() -> void:\n\tmatch attack_index % 4:\n\t\t0, 2:\n\t\t\t_fan(7 if enraged() else 5, 0.95 if enraged() else 0.7, 220.0)\n\t\t1:\n\t\t\t_ring(16 if enraged() else 12, 160.0)\n\t\t3:\n\t\t\tif get_tree().get_nodes_in_group(\"enemies\").size() < 4:\n\t\t\t\tsummon.emit([position + Vector2(-120, 30), position + Vector2(120, 30)])\n\t\t\t\tAudio.play(\"boss_roar\", -8.0)\n\t\t\telse:\n\t\t\t\t_fan(3, 0.3, 300.0)\n\tattack_index += 1"
  },
  {
   "beat_id": "B23",
   "path": "scripts/boss.gd",
   "start_line": 138,
   "end_line": 150,
   "text": "\tif effects_parent:\n\t\tEffects.hit_spark(effects_parent, at)\n\tif state == \"enter\":\n\t\treturn true   # shielded while it walks in: the shot is absorbed\n\tvar was_enraged := enraged()\n\thealth = maxi(0, health - amount)\n\thealth_changed.emit(health, MAX_HEALTH)\n\tAudio.play(\"enemy_hit\", -3.0)\n\t_flash()\n\tif not was_enraged and enraged():\n\t\tsprite.modulate = Color(1.0, 0.7, 0.7)\n\t\tAudio.play(\"boss_roar\")\n\t\tattack_timer = 0.4"
  },
  {
   "beat_id": "B25",
   "path": "scripts/game_state.gd",
   "start_line": 122,
   "end_line": 136,
   "text": "func _configure_input() -> void:\n\t_add_keys(\"move_left\", [KEY_A, KEY_LEFT])\n\t_add_keys(\"move_right\", [KEY_D, KEY_RIGHT])\n\t_add_keys(\"move_up\", [KEY_W, KEY_UP])\n\t_add_keys(\"move_down\", [KEY_S, KEY_DOWN])\n\t_add_keys(\"fire\", [KEY_J, KEY_SPACE, KEY_Z])\n\t_add_keys(\"focus\", [KEY_SHIFT])\n\t_add_keys(\"pause\", [KEY_ESCAPE, KEY_P])\n\t_add_keys(\"restart\", [KEY_R])\n\t_add_mouse(\"fire\", MOUSE_BUTTON_LEFT)\n\n\t_add_joy_button(\"fire\", JOY_BUTTON_A)\n\t_add_joy_button(\"focus\", JOY_BUTTON_LEFT_SHOULDER)\n\t_add_joy_button(\"pause\", JOY_BUTTON_START)\n\t_add_joy_axis(\"fire\", JOY_AXIS_TRIGGER_RIGHT, 1.0)"
  },
  {
   "beat_id": "B27",
   "path": "scripts/game.gd",
   "start_line": 595,
   "end_line": 606,
   "text": "func _unhandled_input(event: InputEvent) -> void:\n\tif event.is_action_pressed(\"pause\"):\n\t\tif state == \"over\":\n\t\t\treturn\n\t\tif pause_menu.visible:\n\t\t\t_resume()\n\t\telif state == \"play\" or state == \"intro\":\n\t\t\t_pause()\n\t\tget_viewport().set_input_as_handled()\n\telif event.is_action_pressed(\"restart\") and (pause_menu.visible or game_over_menu.visible):\n\t\t_restart()\n\t\tget_viewport().set_input_as_handled()"
  },
  {
   "beat_id": "B29",
   "path": "scripts/game_clear.gd",
   "start_line": 94,
   "end_line": 106,
   "text": "func _process(delta: float) -> void:\n\tif finished or stop_y == 0.0:\n\t\treturn\n\tcredits.position.y -= SCROLL_SPEED * delta\n\tif credits.position.y <= stop_y:\n\t\t_finish()\n\nfunc _finish() -> void:\n\tfinished = true\n\tcredits.position.y = stop_y\n\tbuttons.visible = true\n\tcreate_tween().tween_property(buttons, \"modulate:a\", 1.0, 0.5)\n\tbuttons.get_child(0).grab_focus()"
  }
 ],
