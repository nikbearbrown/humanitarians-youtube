; Walker Tower Defense: Godot 4 rebuild of the Unity elemental tower defense.
config_version=5

[application]
config/name="walker-towerdefense"
config/use_custom_user_dir=true
config/custom_user_dir_name="walker-towerdefense-filmcapture"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[walker]

; Playtest tools. F2 wave-skip is only active when this is true.
debug/enabled=false

[display]
window/size/viewport_width=960
window/size/viewport_height=680
window/size/window_width_override=3840
window/size/window_height_override=2160
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/size/no_focus=true
window/size/borderless=true

[physics]
common/physics_ticks_per_second=60

[layer_names]
2d_physics/layer_1="Tiles"
2d_physics/layer_2="Monsters"
2d_physics/layer_3="TowerRange"
2d_physics/layer_4="Projectiles"

[rendering]
; Required by the macOS universal/arm64 export preset.
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.965, 0.953, 0.925, 1)

[editor]

movie_writer/mjpeg_quality=0.9
