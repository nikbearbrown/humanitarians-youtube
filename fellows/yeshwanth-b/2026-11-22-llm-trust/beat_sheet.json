    {
      "beat_id": "B03",
      "act": "BODY",
      "narration_text": "Hallucination is one of three reasons we can't take an output on faith. Bias: models can learn unfair patterns from their training data. And the black box: billions of numbers, and no easy way to see why the model said what it said. You wouldn't hire someone because they sound confident. You'd check their work.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 21.2,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "remotion": {
          "pattern": "TrustThreeProblems",
          "props": {
            "title": "Three Reasons to Check",
            "analogy": "Confidence isn’t evidence. Check the work.",
            "items": [
              {
                "label": "Hallucination",
                "detail": "confident answers that aren’t true",
                "icon": "hallucination"
              },
              {
                "label": "Bias",
                "detail": "unfair patterns learned from data",
                "icon": "bias"
              },
              {
