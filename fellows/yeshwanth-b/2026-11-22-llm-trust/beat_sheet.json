    {
      "beat_id": "B07",
      "act": "BODY",
      "narration_text": "Now fairness. One simple test: keep the prompt the same, and swap one sensitive detail, like a name, a gender, or a region. Write a reference letter for Emily, a nurse. Then the same request for Jamal. Compare the two answers. If the quality shifts with who it's about, that's a bias signal. The survey calls this a counterfactual: change one thing, and watch the output.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 25.4,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "remotion": {
          "pattern": "TrustCounterfactual",
          "props": {
            "title": "Swap One Detail",
            "names": [
              "Emily",
              "Jamal"
            ],
            "checks": [
              {
                "label": "Length",
                "a": "about the same",
                "b": "about the same",
                "same": true
