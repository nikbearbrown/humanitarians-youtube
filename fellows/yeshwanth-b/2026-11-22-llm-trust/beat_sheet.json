    {
      "beat_id": "B02",
      "act": "BODY",
      "narration_text": "Start with the problem. Ask a model what temperature water boils at on top of Mount Everest. It answers: one hundred degrees, the same as at sea level. Fluent, confident, and wrong. Up there the air is thinner, so water boils at about seventy. A confident answer that isn't true is called a hallucination.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 20.8,
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "remotion": {
          "pattern": "TrustHallucination",
          "props": {
            "question": "What temperature does water boil at on top of Mount Everest?",
            "answer": "Water boils at 100 °C up there, the same as at sea level.",
            "truth": "About 70 °C: thinner air, lower boiling point.",
            "note": "Illustrative answer, not from a specific model · boiling point checked: evidence/boiling.txt",
            "handle": "@HumanitariansAI",
            "logo": "hai-wordmark-outlined.svg",
            "durationSeconds": 17.966666666666665,
            "cues": [
              1.33,
