    {
      "beat_id": "B02",
      "act": "TERMS",
      "narration_text": "Six terms first. An agent is AI software that takes a goal and carries out the steps, instead of just answering. A token is a small chunk of text; AI use is measured, and limited, in tokens. MCP, the Model Context Protocol, is a standard way to connect an AI to tools and data.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "shot": {
        "type": "GRAPHIC",
        "source": "own",
        "treatment": "none",
        "scene": "terms",
