          7.59,
          13.34
        ]
      },
      "audio_file": "audio/beat-B04.wav",
      "actual_duration_s": 15.366666666666667,
      "speech": {
        "lead_s": 0.3,
        "speech_s": 14.464
      },
      "render_duration_s": 15.375,
      "build": {
        "status": "VIDEO",
        "src": "media/B04.mp4",
        "filled_by": "media",
        "at": "2026-10-13T12:53:18"
      }
    },
    {
      "beat_id": "B05",
      "act": "FLOW",
      "narration_text": "Muse is a cloud AI agent. You give it a goal. It makes a plan, works through the steps, and checks in with you before anything consequential. Its tools are real programs, like Blender and Godot. What comes back is a result you can inspect.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "shot": {
        "type": "GRAPHIC",
        "source": "own",
        "treatment": "none",
        "scene": "flow",
