    },
    {
      "beat_id": "B06",
      "act": "VERSUS",
      "narration_text": "The big difference is where the work happens. A tool on your own computer uses your memory and disk. Muse runs on its own virtual machine in the cloud, so it uses none of your computer's memory or disk. And it keeps working around the clock, until its token allowance runs out.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "shot": {
