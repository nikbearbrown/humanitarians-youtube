        "filled_by": "media",
        "at": "2026-10-13T12:53:18"
      }
    },
    {
      "beat_id": "B03",
      "act": "TERMS",
      "narration_text": "Headless means a program runs with no window on screen. An asset is any file a game uses: a 3D model, a texture, a sound. And a virtual machine is a complete computer simulated in software, often in the cloud.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "shot": {
        "type": "GRAPHIC",
        "source": "own",
        "treatment": "none",
        "scene": "terms",
        "reconstruction": false,
