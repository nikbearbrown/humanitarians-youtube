        "at": "2026-10-13T12:53:18"
      }
    },
    {
      "beat_id": "B04",
      "act": "PROBLEM",
      "narration_text": "Here's the problem. A chatbot answers a question, and stops. Building a game or a 3D asset is different. It's long, multi-step work. Install a tool, write a script, run it, check the output, fix it, run it again. And while all that runs, your own computer is busy.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "shot": {
        "type": "GRAPHIC",
        "source": "own",
        "treatment": "none",
        "scene": "problem",
        "reconstruction": false,
        "show": [
          {
            "at": 0.0,
            "event": "scenes.py: problem"
          }
