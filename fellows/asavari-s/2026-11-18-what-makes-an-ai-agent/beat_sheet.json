    },
    {
      "beat_id": "B01B",
      "act": "Why This Matters",
      "engine": "kokoro",
      "voice": "af_bella",
      "estimated_duration_s": 20,
      "narration_text": "Hi, I'm Asavari, a fellow at Humanitarians AI. This video is about what actually makes an AI system an agent: the loop of planning, acting with tools, and checking results. You'll learn the parts every agent has, why that loop makes agents useful, and why it also makes them harder to trust. If you're starting to build with agents, as I am, this is for you.",
      "shot": {
        "type": "CARD",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "ClaudeComposerAsk",
          "props": {
            "command": "What is this video about, and why should I watch it?",
            "topic": "HUMANITARIANS AI · AI ENGINEERING",
            "segment": "What Makes an AI Agent?",
            "greeting": "Hi, I'm Asavari",
            "runningText": "the one-line summary…",
            "output": [
              "Who: Asavari, a Humanitarians AI fellow",
              "What: the loop that makes an AI an agent",
              "Why watch: know what you're trusting before you build one"
            ],
            "folderLabel": "@HumanitariansAI",
            "modelLabel": "Fable 5",
            "effortLabel": "High"
          },
          "rendered": {
            "out": "media/B01B.mp4",
            "at": ""
          }
        }
      },
      "audio_file": "mp3/beat-B01B.mp3",
      "tangent": true,
      "actual_duration_s": 22.57,
      "build": {
        "status": "VIDEO",
        "src": "media/B01B.mp4",
