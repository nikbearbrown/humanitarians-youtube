      "act": "OPEN",
      "engine": "kokoro",
      "voice": "af_bella",
      "estimated_duration_s": 16,
      "narration_text": "Everyone's calling everything an agent. A chatbot answers a question. An agent is given a goal and keeps going. It decides the next step, uses tools, checks the result, and tries again. That loop is the whole difference.",
      "shot": {
        "type": "CARD",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
