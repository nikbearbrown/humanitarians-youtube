    {
      "beat_id": "B00",
      "act": "OPEN",
      "engine": "kokoro",
      "voice": "af_bella",
      "estimated_duration_s": 16.0,
      "narration_text": "How does an AI know that king and queen are related, or find the right document when you didn't use the exact words? It doesn't read like we do. It turns meaning into numbers. Those numbers are called embeddings, and they quietly power search, recommendations, and retrieval.",
      "shot": {
        "type": "CARD",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "ClaudeComposerAsk",
          "props": {
            "command": "How does AI find the right answer when the words don't match?",
            "topic": "HUMANITARIANS AI · AI ENGINEERING",
            "segment": "What Are Embeddings?",
            "greeting": "Selam, Kore",
            "runningText": "turning meaning into numbers…",
            "output": [
              "Computers match symbols, not meaning.",
              "Embeddings turn meaning into numbers.",
              "Close in meaning becomes close in space."
            ],
            "folderLabel": "@HumanitariansAI",
            "modelLabel": "Fable 5",
            "effortLabel": "High"
          },
          "rendered": {
            "out": "media/B00.mp4",
            "at": ""
          }
        }
      },
      "audio_file": "mp3/beat-B00.mp3",
      "actual_duration_s": 16.73,
      "build": {
        "status": "VIDEO",
        "src": "media/B00.mp4",
        "filled_by": "media",
        "at": "2026-09-28T15:43:07"
      }
    },
    {
      "beat_id": "B01B",
      "act": "Why This Matters",
      "engine": "kokoro",
      "voice": "af_bella",
      "estimated_duration_s": 20.0,
      "narration_text": "Hi, I'm Asavari, a fellow at Humanitarians AI. This video is about embeddings, how AI turns words, images, or whole documents into lists of numbers that capture meaning, so that close in meaning becomes close in space. You'll learn what an embedding actually is, why it powers search and RAG, and where it can quietly mislead you. If you use AI search or build with it, this is for you.",
      "shot": {
        "type": "CARD",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "ClaudeComposerAsk",
          "props": {
            "command": "What is this video about, and why should I watch it?",
            "topic": "HUMANITARIANS AI · AI ENGINEERING",
            "segment": "What Are Embeddings?",
            "greeting": "Hi, I'm Asavari",
            "runningText": "the one-line summary…",
            "output": [
              "Who: Asavari, a Humanitarians AI fellow",
              "What: embeddings — meaning as numbers",
              "Why watch: it's the engine behind AI search and RAG"
            ],
            "folderLabel": "@HumanitariansAI",
            "modelLabel": "Fable 5",
            "effortLabel": "High"
          },
          "rendered": {
            "out": "media/B01B.mp4",
            "at": ""
          }
        }
      },
      "tangent": true,
      "audio_file": "mp3/beat-B01B.mp3",
      "actual_duration_s": 24.6,
      "build": {
        "status": "VIDEO",
        "src": "media/B01B.mp4",
        "filled_by": "media",
        "at": "2026-09-28T15:43:07"
      }
    },
    {
      "beat_id": "B01",
      "act": "THE PROBLEM",
      "engine": "kokoro",
      "voice": "af_bella",
      "estimated_duration_s": 22.0,
      "narration_text": "Computers don't understand words, they match symbols. Keyword search looks for the exact string, so it misses that car and automobile mean the same thing, and it can't tell a helpful match from a coincidental one. Meaning lives between the words, and plain text matching can't see it.",
      "shot": {
        "type": "CARD",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "ClaudeWindow",
          "props": {
            "view": "artifact",
            "artifactTitle": "Keywords match symbols, not meaning",
            "artifactHeading": "meaning lives between the words",
            "artifactLines": [
              "Keyword search wants the exact string",
              "'car' vs 'automobile' — same meaning, no match",
              "plain text matching can't see meaning"
            ],
            "sparkLine": "Symbols aren't meaning."
          },
          "rendered": {
            "out": "media/B01.mp4",
            "at": ""
          }
        }
      },
      "audio_file": "mp3/beat-B01.mp3",
      "actual_duration_s": 17.73,
      "build": {
        "status": "VIDEO",
        "src": "media/B01.mp4",
        "filled_by": "media",
        "at": "2026-09-28T15:43:07"
      }
    },
    {
      "beat_id": "B02",
      "act": "THE MECHANISM",
      "engine": "kokoro",
      "voice": "af_bella",
      "estimated_duration_s": 28.0,
      "narration_text": "An embedding fixes that. A model maps each item to a point in a high-dimensional space, hundreds of numbers, arranged so that things with similar meaning land near each other. Now similarity is just distance. Ask a question, embed it, and find the nearest points, and you get the right answer even in different words. That nearest-neighbor step is the retrieval half of RAG.",
      "shot": {
        "type": "CARD",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "ClaudeWindow",
          "props": {
            "view": "artifact",
            "artifactTitle": "Meaning becomes a point in space",
            "artifactHeading": "close in meaning -> close in space",
            "artifactLines": [
              "A model maps each item to hundreds of numbers (a vector)",
              "Similar meaning -> nearby points; similarity = distance",
              "Nearest-neighbor search = the retrieval half of RAG"
            ],
            "sparkLine": "Similarity is just distance."
          },
          "rendered": {
            "out": "media/B02.mp4",
            "at": ""
          }
        }
      },
      "audio_file": "mp3/beat-B02.mp3",
      "actual_duration_s": 23.74,
      "build": {
        "status": "VIDEO",
        "src": "media/B02.mp4",
        "filled_by": "media",
        "at": "2026-09-28T15:43:07"
      }
    },
    {
      "beat_id": "B03",
      "act": "THE LIMIT",
      "engine": "kokoro",
      "voice": "af_bella",
      "estimated_duration_s": 26.0,
      "narration_text": "But an embedding only reflects the data it was trained on. It can bake in bias, it can miss the meaning of your specific domain, and close is not the same as correct, the nearest match can still be wrong. It's a snapshot of meaning, not reasoning. Feed it the wrong space, and your search quietly returns confident nonsense.",
      "shot": {
        "type": "CARD",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "ClaudeWindow",
          "props": {
            "view": "artifact",
            "artifactTitle": "Similar is not the same as correct",
            "artifactHeading": "an embedding reflects its training data",
            "artifactLines": [
              "Can bake in bias; can miss your domain's meaning",
              "The nearest match can still be the wrong answer",
              "Wrong space -> confident nonsense"
            ],
            "sparkLine": "Close is not correct."
          },
          "rendered": {
            "out": "media/B03.mp4",
            "at": ""
          }
        }
      },
      "audio_file": "mp3/beat-B03.mp3",
      "actual_duration_s": 19.78,
      "build": {
        "status": "VIDEO",
        "src": "media/B03.mp4",
        "filled_by": "media",
        "at": "2026-09-28T15:43:07"
      }
    },
    {
      "beat_id": "B04",
      "act": "The verdict",
      "engine": "kokoro",
      "voice": "af_bella",
      "estimated_duration_s": 16.0,
      "narration_text": "Before you trust an embedding search, ask a few things. What model produced these vectors? Was it trained on text like yours? Is similar actually relevant for this task? And what happens when the true answer isn't near anything? Similarity is a powerful hint, not a guarantee. Use it to find candidates, then verify.",
      "shot": {
        "type": "CARD",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "ClaudeVerdictArtifact",
          "props": {
            "artifactTitle": "Trust similarity as a hint, then verify",
            "artifactHeading": "Similarity finds candidates; it doesn't guarantee truth",
            "artifactLines": [
              "What model produced these vectors?",
              "Was it trained on text like yours?",
              "Is 'similar' actually 'relevant' here?",
              "What if the true answer isn't near anything?"
            ]
          },
          "rendered": {
