    {
      "beat_id": "B03",
      "act": "II — What Runs",
      "estimated_duration_s": 21,
      "narration_text": "Chaining breaks one big task into steps, and each step hands a validated result to the next. Watch the gate in the middle — that is the whole pattern. Without it, a small error in step one becomes a confidently wrong answer in step five, and you will never see where it started. Use it when the work is genuinely sequential.",
      "new_visual_element": "Prompt chaining — the validated assembly line",
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "lane": "illustration",
