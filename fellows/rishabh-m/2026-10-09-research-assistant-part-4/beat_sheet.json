          },
          {
            "at": 0.85,
            "event": "note: one limiter for every request"
          }
        ],
        "remotion": {
          "pattern": "ClaudeCodeFile",
          "props": {
            "title": "One Limiter, Every Request",
            "sparkLine": "Wait for what's left.",
            "filename": "src/services/arxiv/rate_limiter.py   (excerpt)",
            "language": "python",
            "code": "def wait(self) -> None:\n    with self._lock:\n        if self._last is not None:\n            remaining = self._min_interval - (self._clock() - self._last)\n            if remaining > 0:\n                self._sleep(remaining)\n        self._last = self._clock()",
            "highlight": [
              4,
              5,
              6
            ],
            "highlightAtSeconds": 8.0,
            "revealSeconds": 1.6,
            "lineNumbers": true,
            "note": "Searches, retries and PDF downloads all call wait() first.",
