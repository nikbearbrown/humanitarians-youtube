    {
      "beat_id": "B08",
      "act": "III — The Build",
      "estimated_duration_s": 24,
      "narration_text": "Back to rule one, in the client. Every request goes through one rate limiter first: searches, retries, and later, PDF downloads. It waits only for whatever is left of the three seconds. It uses the monotonic clock, because wall-clock time can jump. And the clock and the sleep are passed in, so the tests can run instantly.",
      "new_visual_element": "One rate limiter, every request",
      "shot": {
        "type": "REMOTION",
        "source": "own",
