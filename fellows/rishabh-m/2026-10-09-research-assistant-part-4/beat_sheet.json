            "sparkLine": "Safe to repeat.",
            "filename": "src/repositories/paper.py   (excerpt, … = lines omitted, one line wrapped)",
            "language": "python",
            "code": "def upsert_many(self, papers: list[PaperCreate]) -> int:\n    # Postgres rejects a batch that touches the same row twice; the last copy wins.\n    unique = {paper.arxiv_id: paper for paper in papers}\n    …\n    stmt = insert(Paper).values([paper.model_dump() for paper in unique.values()])\n    stmt = stmt.on_conflict_do_update(\n        index_elements=[Paper.arxiv_id],\n        set_={**{column: stmt.excluded[column] for column in ARXIV_METADATA_COLUMNS},\n              \"updated_at\": func.now()},\n    )\n    self.session.execute(stmt)\n    self.session.commit()\n    return len(unique)",
