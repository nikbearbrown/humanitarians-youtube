            "code": "for entry in root.findall(\"atom:entry\", NS):\n    entry_id = entry.findtext(\"atom:id\", default=\"\", namespaces=NS)\n\n    # arXiv reports query errors as a feed with a single error entry.\n    if \"/api/errors\" in entry_id:\n        raise ArxivParseError(f\"arXiv API error: …\")\n\n    try:\n        papers.append(_parse_entry(entry))\n    except ValidationError as e:\n        logger.warning(\"Skipping malformed arXiv entry %s: %s\", entry_id or \"<no id>\", e)",
