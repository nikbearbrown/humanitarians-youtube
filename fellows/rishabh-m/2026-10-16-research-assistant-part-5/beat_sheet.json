            "language": "python",
            "code": "stmt = insert(Paper).values([paper.model_dump() for paper in unique.values()])\n# Inside ON CONFLICT, Paper.<column> is the stored row and stmt.excluded.<column> is the incoming one.\nnew_version = Paper.pdf_url != stmt.excluded.pdf_url\nstmt = stmt.on_conflict_do_update(\n    index_elements=[Paper.arxiv_id],\n    set_={\n        **{column: stmt.excluded[column] for column in ARXIV_METADATA_COLUMNS},\n        \"pdf_status\": case((new_version, PdfStatus.pending.value), else_=Paper.pdf_status),\n        \"pdf_attempts\": case((new_version, 0), else_=Paper.pdf_attempts),\n        \"updated_at\": func.now(),\n    },\n)",
