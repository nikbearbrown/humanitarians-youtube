    {
      "beat_id": "B03",
      "act": "II — Download",
      "estimated_duration_s": 22,
      "narration_text": "Downloads go through the same rate limiter as everything else. Then two checks. The size, against a cap. And the first bytes. arXiv can answer with status two hundred and send an HTML page instead of a PDF. So unless the file starts with percent PDF, it is not cached.",
      "new_visual_element": "A 200 is not a PDF until the bytes say so",
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "lane": "illustration",
        "show": [
          {
            "at": 0.05,
            "event": "the real download_pdf reveals"
          },
          {
            "at": 0.55,
            "event": "the %PDF- check lights terracotta on 'the first bytes'"
          },
          {
            "at": 0.85,
            "event": "note"
          }
        ],
        "remotion": {
          "pattern": "ClaudeCodeFile",
          "props": {
            "title": "Check The Bytes",
            "sparkLine": "A 200 can still be HTML.",
            "filename": "src/services/arxiv/client.py   (excerpt, docstring dropped, … = message trimmed)",
            "language": "python",
            "code": "def download_pdf(self, pdf_url: str, max_bytes: int) -> bytes:\n    url = _export_host(pdf_url)\n    response = self._get(url)\n\n    declared = int(response.headers.get(\"Content-Length\", 0))\n    if declared > max_bytes or len(response.content) > max_bytes:\n        raise PdfTooLargeError(f\"PDF larger than … MB: {url}\")\n    if not response.content.startswith(b\"%PDF-\"):\n        raise ArxivAPIError(f\"Not a PDF (…): {url}\")\n    return response.content",
            "highlight": [
              8,
              9
            ],
            "highlightAtSeconds": 6.8,
            "revealSeconds": 1.8,
            "lineNumbers": true,
            "note": "Only bytes starting with %PDF- reach the cache.",
            "folderLabel": "@HumanitariansAI"
          },
          "rendered": {
