    {
      "beat_id": "B04",
      "act": "II — Download",
      "estimated_duration_s": 26,
      "narration_text": "The cache is one file per paper version, so a revised paper gets a fresh download. Every write goes to a temp file in the same folder, then one rename. A crash never leaves half a PDF under the real name. And reading real output found a surprise: the temp files were owner-only, so the mode is set explicitly.",
      "new_visual_element": "Temp file, then one atomic rename",
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "lane": "illustration",
        "show": [
          {
            "at": 0.05,
            "event": "the real PdfCache.put reveals"
          },
          {
            "at": 0.35,
            "event": "'os.replace(tmp, path)' lights terracotta on 'one rename'"
          },
          {
            "at": 0.85,
            "event": "note"
          }
        ],
        "remotion": {
          "pattern": "ClaudeCodeFile",
          "props": {
            "title": "Write, Then Rename",
            "sparkLine": "Never half a PDF.",
            "filename": "src/services/pdf_cache.py   (excerpt, comments trimmed)",
            "language": "python",
            "code": "def put(self, pdf_url: str, content: bytes) -> Path:\n    path = self.path_for(pdf_url)\n    path.parent.mkdir(parents=True, exist_ok=True)\n    # Write to a temp file in the same folder, then rename.\n    fd, tmp = tempfile.mkstemp(dir=path.parent, suffix=\".part\")\n    try:\n        with os.fdopen(fd, \"wb\") as f:\n            f.write(content)\n            os.fchmod(f.fileno(), 0o644)  # mkstemp creates 0600\n        os.replace(tmp, path)\n    except BaseException:\n        Path(tmp).unlink(missing_ok=True)\n        raise\n    return path",
            "highlight": [
              10
            ],
            "highlightAtSeconds": 8.5,
            "revealSeconds": 2.0,
            "lineNumbers": true,
            "note": "A rename is atomic only within one filesystem, so: same folder.",
            "folderLabel": "@HumanitariansAI"
          },
          "rendered": {
            "out": "media/B04.mp4",
            "at": ""
          }
        }
      },
      "actual_duration_s": 20.41,
