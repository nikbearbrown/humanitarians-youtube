    {
      "beat_id": "B07",
      "act": "II — The Bugs",
      "estimated_duration_s": 24,
      "narration_text": "Then my test runner started failing on a file that isn't a test. The scheduler's file was named test underscore dag, and the runner collects anything with that name, anywhere in the repo. The cause was my setup, not my tests. The rule: tell your tools exactly where to look. One line, and it only searches the tests folder.",
      "new_visual_element": "The test runner collected a file that isn't a test",
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "lane": "illustration",
        "show": [
          {
            "at": 0.05,
            "event": "the real pytest config reveals"
          },
          {
            "at": 0.3,
            "event": "'testpaths = [\"tests\"]' lights terracotta on 'tell your tools'"
          },
          {
            "at": 0.85,
            "event": "note: without it, pytest collected the DAG"
          }
        ],
        "remotion": {
          "pattern": "ClaudeCodeFile",
          "props": {
            "title": "Tell Tools Where To Look",
            "sparkLine": "One line.",
            "filename": "pyproject.toml   (excerpt)",
            "language": "toml",
            "code": "[tool.pytest.ini_options]\npythonpath = [\".\"]      # so tests can `from src.main import app`\ntestpaths = [\"tests\"]   # only collect tests from tests/",
            "highlight": [
              3
