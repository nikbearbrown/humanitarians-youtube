    {
      "beat_id": "B02",
      "act": "OUTPUT",
      "role_note": "what's actually shipping",
      "narration_text": "Prophix released a second wave of agents this spring: an Architect Agent that turns customer data into a validated financial model in hours instead of weeks, and a Consolidation Agent that answers questions about audit trail data in plain language — built to only answer when the underlying report data actually supports it. Sana's agents handle FP&A support, vendor management, and compliance documentation with real audit trails. Experian launched an Agent Operating System this year for financial services broadly, built around a real, global survey of over eight hundred senior decision-makers.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B02_WhatsShipping",
