    {
      "beat_id": "B03",
      "act": "CHANGE",
      "role_note": "the honest line in the middle of it",
      "narration_text": "Prophix's own CEO put it plainly: ninety-nine percent accuracy is zero percent trust. The real differentiator these vendors are all converging on isn't raw output quality — it's whether the agent can show its work, and whether it knows the limits of what it can actually answer.",
      "shot": {
        "type": "GRAPHIC",
