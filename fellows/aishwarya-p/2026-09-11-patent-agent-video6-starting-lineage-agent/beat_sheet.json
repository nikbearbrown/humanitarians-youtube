    {
      "beat_id": "B02",
      "act": "PROBLEM",
      "role_note": "scoping it honestly",
      "narration_text": "Two directions exist: backward, what a patent cites, and forward, who cites it back. Backward is a field on the row already being pulled. Forward means searching every other patent's citations for this one's number — a different, untested, likely expensive query. Backward first.",
      "shot": {
        "type": "GRAPHIC",
