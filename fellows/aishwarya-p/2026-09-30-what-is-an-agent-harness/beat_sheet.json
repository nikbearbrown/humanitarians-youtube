      }
    },
    {
      "beat_id": "B04",
      "act": "OUTPUT",
      "role_note": "the real market signal",
      "narration_text": "This isn't theoretical. Real companies selling domain-specific harness layers — Harvey, Legora, Sierra — each crossed a hundred million dollars in annual recurring revenue in 2026. The control a good harness gives you over how an agent actually runs has become something real businesses will pay real money for.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
