      }
    },
    {
      "beat_id": "B02",
      "act": "OUTPUT",
      "role_note": "why it's not just old-school penetration testing",
      "narration_text": "Traditional security testing looks for misconfigurations and unpatched code. AI red teaming tests something genuinely different: whether a model can be talked into violating its own rules, what it leaks from its training data or context, and how it behaves once it's wired into real tools with real permissions.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B02_NotOldSchoolPentest",
          "file": "scenes.py"
        }
      },
      "estimated_duration_s": 22,
      "audio_file": "mp3/beat-B02.mp3",
      "actual_duration_s": 19.63,
      "build": {
        "status": "MANIM",
        "src": "manim/B02.mp4",
        "filled_by": "manim:B02_NotOldSchoolPentest",
        "at": "2026-10-02T15:22:49"
      }
    },
    {
      "beat_id": "B03",
      "act": "CHANGE",
      "role_note": "the real, structural difference",
      "narration_text": "Here's the part that makes AI red teaming harder than normal security work: outputs are non-deterministic. A passing test is only provisional evidence, not proof. Teams have to rerun the same attack and require repeated success before they'll call something closed.",
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "manim": {
          "scene_class": "B03_TheStructuralDifference",
