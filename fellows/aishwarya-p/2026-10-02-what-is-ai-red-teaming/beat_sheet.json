      "actual_duration_s": 17.02,
      "build": {
        "status": "MANIM",
        "src": "manim/B03.mp4",
        "filled_by": "manim:B03_TheStructuralDifference",
        "at": "2026-10-02T15:22:49"
      }
    },
    {
      "beat_id": "B04",
      "act": "OUTPUT",
      "role_note": "who's actually doing this",
      "narration_text": "This isn't theoretical. OpenAI has run external red teaming on every major model release since twenty twenty-two, starting with DALL-E 2, and published real public findings for GPT-4, GPT-4 with vision, DALL-E 3, GPT-4o, and o1.",
      "shot": {
        "type": "GRAPHIC",
