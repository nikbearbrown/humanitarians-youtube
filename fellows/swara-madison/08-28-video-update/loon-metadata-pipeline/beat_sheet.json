    {
      "beat_id": "B00",
      "act": "OPEN",
      "narration_text": "In the previous video, we looked at how researchers label loons on individual frames. But the footage carries another important layer: metadata. For conservation work, that context can matter just as much as the annotation.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "type-on",
        "remotion": {
          "pattern": "ClaudeComposerAsk",
          "props": {
            "greeting": "Hi, Swara",
            "topic": "SWARA · CONSERVATION DATA",
            "segment": "From Footage to Field Context",
            "command": "Connect drone footage metadata to loon annotations",
            "runningText": "adding context to every detection...",
            "folderLabel": "@Swara",
            "output": [
              "video -> metadata -> annotation",
              "time and place stay attached"
            ]
          }
        }
      },
      "estimated_duration_s": 14,
      "audio_file": "mp3/beat-B00.mp3",
      "actual_duration_s": 14.1,
      "build": {
        "status": "VIDEO",
