        "at": "2026-09-01T18:49:35"
      }
    },
    {
      "beat_id": "B01",
      "act": "METADATA",
      "narration_text": "When we collect footage from a drone, we are not only getting a video file. Depending on the camera and drone, it may also carry the capture time, location, altitude, camera details, frame rate, resolution, and other technical information.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "ClaudeScienceLayerStack",
          "props": {
            "sparkLine": "Footage carries field context.",
            "layers": [
              {
                "title": "Video file",
                "sub": "the visible record"
              },
              {
                "title": "Capture metadata",
                "sub": "time · place · altitude",
                "accent": true
              },
              {
                "title": "Technical metadata",
                "sub": "camera · frame rate · resolution"
              }
            ],
            "caption": "The file can describe where and when the pixels came from."
          },
          "rendered": {
            "out": "media/B01.mp4",
            "at": ""
          }
        }
      },
      "estimated_duration_s": 16,
      "audio_file": "mp3/beat-B01.mp3",
      "actual_duration_s": 15.08,
      "build": {
        "status": "VIDEO",
        "src": "media\\B01.mp4",
        "filled_by": "media",
        "at": "2026-09-01T18:49:35"
      }
    },
    {
      "beat_id": "B02",
      "act": "WHY",
      "narration_text": "That distinction changes the question we can answer. Instead of saying only, loon detected in frame 245, we can eventually say, loon detected at this timestamp, at this location, from this altitude. The annotation becomes much more useful to a researcher.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "stagger",
        "remotion": {
          "pattern": "ClaudeScienceChipGrid",
          "props": {
            "sparkLine": "A frame number needs a world around it.",
            "items": [
              "Frame 245",
              "Timestamp",
              "Location",
              "Altitude",
              "Loon box",
              "Research record"
            ],
            "cols": 3,
            "caption": "Detection plus context becomes evidence."
          }
        }
      },
      "estimated_duration_s": 15,
      "audio_file": "mp3/beat-B02.mp3",
      "actual_duration_s": 17.75,
      "build": {
        "status": "VIDEO",
        "src": "media\\B02.mp4",
        "filled_by": "media",
        "at": "2026-09-01T18:49:35"
      }
    },
    {
      "beat_id": "B03",
      "act": "PIPELINE",
      "narration_text": "The pipeline should extract this information automatically. It starts with the raw footage, uses FFmpeg for video-level metadata and ExifTool for image and media metadata, then associates the results with the videos and frames in the database.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "stagger",
        "remotion": {
          "pattern": "ClaudeScienceSourceFlow",
          "props": {
            "sparkLine": "Extract once, reuse everywhere.",
            "sourceLabel": "Raw footage",
            "feeds": [
              {
                "label": "FFmpeg metadata",
                "tint": "#D97757"
              },
              {
                "label": "ExifTool fields"
              },
              {
                "label": "frame extraction"
              }
            ],
            "destApp": "Research database",
            "destTitle": "videos · frames · metadata",
            "arcCaption": "automated context",
            "settleLine": "the researcher does not retype the file"
          }
        }
      },
      "estimated_duration_s": 17,
      "audio_file": "mp3/beat-B03.mp3",
      "actual_duration_s": 15.96,
      "build": {
        "status": "VIDEO",
        "src": "media\\B03.mp4",
        "filled_by": "media",
        "at": "2026-09-01T18:49:35"
      }
    },
    {
      "beat_id": "B04",
      "act": "LINK",
      "narration_text": "Now connect that pipeline to the annotation workflow. A researcher identifies a loon in frame 245. The frame belongs to a video, the video has metadata, and the annotation points back to that frame. The chain is video, frame, timestamp, location, annotation.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "ClaudeScienceSourceFlow",
          "props": {
            "sparkLine": "The label keeps its provenance.",
            "sourceLabel": "Video",
            "feeds": [
              {
                "label": "Frame 245",
                "tint": "#D97757"
              },
              {
                "label": "Timestamp"
              },
              {
                "label": "Location"
              }
            ],
            "destApp": "Annotation record",
            "destTitle": "loon · bounding box · source frame",
            "arcCaption": "one connected chain",
            "settleLine": "video -> frame -> context -> label"
          }
        }
      },
      "estimated_duration_s": 17,
      "audio_file": "mp3/beat-B04.mp3",
      "actual_duration_s": 19.07,
      "build": {
        "status": "VIDEO",
        "src": "media\\B04.mp4",
        "filled_by": "media",
