    {
      "beat_id": "B04",
      "act": "PROBLEM",
      "narration_text": "Picture a text of two thousand pages or more, where the reasoning behind one answer is scattered across it. People are bad at searching like that. Agents search by writing code, but how well does that work? Solving it would help insurance, healthcare and any field buried in documents.",
      "voice": "af_bella",
      "engine": "kokoro",
      "estimated_duration_s": 16,
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
