    {
      "beat_id": "B07",
      "act": "SECOND-HOP",
      "role_note": "",
      "narration_text": "Ask, where is the football? Retrieval finds Daniel taking it. But the deciding fact, Daniel went to the kitchen, never mentions the football, so it ranks low. And order matters: the latest fact wins.",
      "voice": "af_bella",
      "engine": "kokoro",
      "estimated_duration_s": 15,
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
