          },
          {
            "at": "hide one sentence",
            "event": "one sentence highlighted deep in the stack"
          },
          {
            "at": "find it",
            "event": "found ✓"
          },
          {
            "at": "easy case",
            "event": "tag 'one fact = the easy case'"
          }
