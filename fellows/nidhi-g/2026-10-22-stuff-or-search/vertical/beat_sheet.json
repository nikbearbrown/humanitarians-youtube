            "event": "similarity: 'took the football' high"
          },
          {
            "at": "ranks low",
            "event": "'went to the kitchen' low"
          },
          {
            "at": "order matters",
            "event": "timeline took → dropped → grabbed → kitchen; last highlighted"
          }
        ],
        "manim": {
