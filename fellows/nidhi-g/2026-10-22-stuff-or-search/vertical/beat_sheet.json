    {
      "beat_id": "B02",
      "act": "NIAH",
      "role_note": "",
      "narration_text": "The classic test is the needle in a haystack: hide one sentence in a long text, ask the model to find it. Most frontier models now pass, but that's the easy case.",
      "voice": "af_bella",
      "engine": "kokoro",
      "estimated_duration_s": 12,
      "shot": {
