    {
      "beat_id": "B06",
      "act": "RAG",
      "role_note": "",
      "narration_text": "Shortcut two: retrieval, or RAG. Split the document into chunks, find the chunks most like your question, and pass only those on. But chunking can split facts that belong together.",
      "voice": "af_bella",
      "engine": "kokoro",
      "estimated_duration_s": 14,
      "shot": {
