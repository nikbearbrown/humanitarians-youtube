        "at": "2026-10-22T12:02:26"
      }
    },
    {
      "beat_id": "B04",
      "act": "EFFECTIVE",
      "role_note": "",
      "narration_text": "Accepting a long context isn't using it. The RULER benchmark found most models fall short of their advertised length. And models use the start and end of their input best, losing what's in the middle.",
      "voice": "af_bella",
      "engine": "kokoro",
      "estimated_duration_s": 15,
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "show": [
          {
            "at": "RULER",
            "event": "advertised vs effective context bars (RULER, Hsieh et al. 2024)"
          },
          {
            "at": "start and end",
            "event": "U-shaped accuracy curve: start/middle/end (Liu et al.)"
          }
        ],
        "manim": {
          "scene_class": "B04_Effective",
          "file": "scenes.py"
        }
      },
      "audio_file": "mp3/beat-B04.mp3",
      "actual_duration_s": 12.16,
      "render_duration_s": 12.166666666666666,
      "build": {
        "status": "MANIM",
        "src": "manim\\B04.mp4",
        "filled_by": "manim:B04_Effective",
        "at": "2026-10-22T12:02:26"
      }
    },
