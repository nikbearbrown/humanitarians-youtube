    {
      "beat_id": "B03",
      "act": "STUFF",
      "role_note": "",
      "narration_text": "Shortcut one: stuff the whole document into the prompt. The few lines that matter get buried, and every question pays again for every page, in cost and in time.",
      "voice": "af_bella",
      "engine": "kokoro",
      "estimated_duration_s": 13,
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "show": [
          {
            "at": "stuff",
            "event": "document pours into a prompt box"
          },
          {
            "at": "buried",
            "event": "relevant lines shrink into the pile"
          },
          {
            "at": "every question",
            "event": "meter 'cost & time' refills per question"
          }
        ],
        "manim": {
          "scene_class": "B03_Stuff",
          "file": "scenes.py"
        }
      },
      "audio_file": "mp3/beat-B03.mp3",
