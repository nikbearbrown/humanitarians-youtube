    {
      "beat_id": "B06",
      "act": "PIPELINE",
      "role_note": "",
      "narration_text": "The plan: mine an agent's past logs, keep decisions that repeat at least fifty times, have a strong model write a small Python function for each, and test it in a sandbox with no network and no model.",
      "voice": "af_bella",
      "engine": "kokoro",
      "estimated_duration_s": 13,
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "show": [
          {
            "at": "mine",
            "event": "stations: mine → group ≥ 50 → write Python → sandbox → registry"
          },
          {
            "at": "no network",
            "event": "badge no network · no model"
          }
        ],
        "manim": {
          "scene_class": "B06_Pipeline",
          "file": "scenes.py"
        }
      },
      "audio_file": "mp3/beat-B06.mp3",
      "actual_duration_s": 13.03,
      "render_duration_s": 13.041666666666666,
      "build": {
        "status": "MANIM",
        "src": "manim\\B06.mp4",
        "filled_by": "manim:B06_Pipeline",
        "at": "2026-10-25T00:46:39"
      }
    },
    {
      "beat_id": "B07",
      "act": "ABSTAIN",
      "role_note": "",
      "narration_text": "Each function follows one rule: when it isn't sure, it says so, and the model takes over. Where it does answer, it must agree with the model at least ninety-eight percent of the time, on later sessions it never saw.",
      "voice": "af_bella",
      "engine": "kokoro",
      "estimated_duration_s": 13,
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "show": [
          {
            "at": "says so",
            "event": "return \"unsure\" → back to the model"
          },
          {
            "at": "ninety-eight",
            "event": "agreement formula ≥ 0.98 on later sessions"
          }
        ],
        "manim": {
          "scene_class": "B07_Abstain",
          "file": "scenes.py"
        }
      },
      "audio_file": "mp3/beat-B07.mp3",
      "actual_duration_s": 13.01,
      "render_duration_s": 13.041666666666666,
      "build": {
        "status": "MANIM",
        "src": "manim\\B07.mp4",
        "filled_by": "manim:B07_Abstain",
        "at": "2026-10-25T00:46:39"
      }
    },
