    {
      "beat_id": "B05",
      "act": "MYELIN",
      "role_note": "",
      "narration_text": "In biology, myelin wraps the brain's busiest nerve pathways so their signals travel faster. The plan does the same for an agent's habits.",
      "voice": "af_bella",
      "engine": "kokoro",
      "estimated_duration_s": 9,
      "shot": {
