    {
      "beat_id": "B04",
      "act": "IRCOT",
      "role_note": "",
      "narration_text": "Another, IRCoT, short for Interleaving Retrieval with Chain-of-Thought, does what its name says: one reasoning step, then a new search guided by it. Its authors report better retrieval and answers on multi-hop benchmarks.",
      "voice": "af_bella",
      "engine": "kokoro",
      "estimated_duration_s": 12,
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "show": [
          {
            "at": "IRCoT",
            "event": "title IRCoT = Interleaving Retrieval with Chain-of-Thought (Trivedi et al., ACL 2023)"
          },
          {
            "at": "one reasoning step",
            "event": "row reason → search → reason → search"
          },
          {
            "at": "report",
            "event": "note: reported gains on multi-hop benchmarks"
          }
        ],
        "manim": {
          "scene_class": "B04_IRCoT",
