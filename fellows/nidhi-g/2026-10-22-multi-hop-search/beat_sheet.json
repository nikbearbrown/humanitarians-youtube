    {
      "beat_id": "B02",
      "act": "ITERATIVE",
      "role_note": "",
      "narration_text": "Take the football question. Search the football: Daniel took it. Now search Daniel: dropped it, grabbed it, went to the kitchen. Each finding shapes the next search, and the latest fact wins.",
      "voice": "af_bella",
      "engine": "kokoro",
      "estimated_duration_s": 13,
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
        "motion": "fade",
        "show": [
          {
            "at": "Search the football",
            "event": "search 1: football → 'Daniel took it'"
          },
          {
            "at": "Now search Daniel",
            "event": "search 2: Daniel → dropped → grabbed → kitchen"
          },
          {
            "at": "latest fact wins",
            "event": "last link highlighted"
          }
        ],
        "manim": {
          "scene_class": "B02_Iterative",
          "file": "scenes.py"
        }
      },
      "audio_file": "mp3/beat-B02.mp3",
