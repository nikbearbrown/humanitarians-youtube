            "at": "insurance",
            "event": "chips insurance · healthcare · law"
          },
          {
            "at": "cited every line",
            "event": "four cited lines appear ✓; answer turns solid"
          }
        ],
        "manim": {
          "scene_class": "B07_Citations",
          "file": "scenes.py"
        }
