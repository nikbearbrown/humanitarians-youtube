      }
    },
    {
      "beat_id": "B03",
      "act": "SELF-ASK",
      "role_note": "",
      "narration_text": "One method breaks the question into smaller ones. Self-Ask has the model pose and answer its own follow-up questions, which can each go to a search engine.",
