    {
      "beat_id": "B01",
      "act": "BLUF",
      "role_note": "EXECUTIVE-SUMMARY LAW; misconception: search once, then answer.",
      "narration_text": "Multi-hop search doesn't retrieve once and answer. It retrieves, reads what it found, and lets that decide where to search next, step by step.",
      "voice": "af_bella",
      "engine": "kokoro",
      "estimated_duration_s": 9,
      "lead_silence_s": 0.8,
      "shot": {
        "type": "GRAPHIC",
