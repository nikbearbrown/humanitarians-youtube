    {
      "beat_id": "B07",
      "act": "CITATIONS",
      "role_note": "",
      "narration_text": "Whatever the method, answers need receipts. Without the exact lines behind an answer, nobody can check it, and in insurance, healthcare or law, an answer you can't check is an answer you can't trust. My agent cited every line it used.",
      "voice": "af_bella",
      "engine": "kokoro",
      "estimated_duration_s": 12,
      "shot": {
        "type": "GRAPHIC",
        "source": "manim",
