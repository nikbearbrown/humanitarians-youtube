    {
      "beat_id": "B03EPISODE",
      "act": "SHOW",
      "heading": "Reset, step and episodes",
      "narration_text": "Gymnasium runs this loop with two commands. Reset starts a new episode and returns the first observation. Step takes one action and returns the next observation, a reward, and whether the episode has ended. In CartPole, an episode ends when the pole tips too far or the cart leaves the track, or it's cut short after five hundred steps. Then you reset and go again.",
      "engine": "kokoro",
      "voice": "bm_fable",
      "t_start": 50.958,
      "estimated_duration_s": 24.8,
