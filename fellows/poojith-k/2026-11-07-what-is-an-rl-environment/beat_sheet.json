      "beat_id": "B01LOOP",
      "act": "SHOW",
      "heading": "Agent and environment",
      "narration_text": "In reinforcement learning, or RL, an agent learns by trial and error. The agent makes the decisions, and the environment is the world it acts on. Take CartPole, a classic practice environment from Gymnasium, an open-source library. The agent pushes a cart left or right. The environment applies the push, moves the cart and its pole, and sends back an observation and a reward.",
      "engine": "kokoro",
      "voice": "bm_fable",
      "t_start": 15.083,
      "estimated_duration_s": 24.8,
      "actual_duration_s": null,
      "audio_file": null,
