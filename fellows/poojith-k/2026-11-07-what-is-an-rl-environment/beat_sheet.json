    {
      "beat_id": "B04RETURN",
      "act": "SHOW",
      "heading": "Reward and return",
      "narration_text": "In CartPole, every step earns one point, including the last, so the longer the pole stays up, the higher the score. A single reward is short-term feedback. The return adds up rewards across the episode, sometimes counting later rewards a little less. That's why a move can be worth making for what it sets up later.",
      "engine": "kokoro",
      "voice": "bm_fable",
      "t_start": 70.458,
      "estimated_duration_s": 21.7,
      "actual_duration_s": null,
      "audio_file": null,
