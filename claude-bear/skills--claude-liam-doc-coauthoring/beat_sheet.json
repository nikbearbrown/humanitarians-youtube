    {
      "beat_id": "NB03",
      "act": "3 mechanism",
      "narration_text": "Stage one closes the knowledge gap before any writing starts. Claude asks five meta-questions — document type, audience, impact, template, constraints — then asks for the full context dump. It stops once it can ask about edge cases without needing the basics explained.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 18,
      "shot": {
        "type": "GRAPHIC",
        "source": "own",
