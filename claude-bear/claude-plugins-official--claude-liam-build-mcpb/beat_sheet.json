    {
      "beat_id": "B04",
      "act": "3 mechanism",
      "narration_text": "An MCPB is a zip: manifest.json, a server folder with your code and dependencies, and an icon. The host reads the manifest and launches mcp_config's command exactly as written — dollar-dirname for bundle-relative paths, dollar-user-config for install-time values like that folder the user picked.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 15,
      "shot": {
