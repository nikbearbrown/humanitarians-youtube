      "audio_file": "mp3/beat-S03.mp3"
    },
    {
      "beat_id": "S04",
      "act": "3 mechanism",
      "narration_text": "Self-checking and independent verification are not the same thing. A system reviewing its own output works from the same context as the step that produced it — the same reading of the sources, the same assumptions, the same blind spots. A check like that can't catch an error the generation step already baked in.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 18,
      "shot": {
        "type": "GRAPHIC",
        "source": "own",
        "motion": "compare",
        "media": "manim/S04.mp4",
        "new_visual_element": "Generation vs self-check — same context, same blind spots (humanitarians palette)",
        "manim": {
          "scene_class": "HSCS04Scene",
          "scenes_file": "scenes.py"
        }
      },
      "build": {
        "status": "MANIM",
        "src": "manim/S04.mp4",
        "filled_by": "manim:HSCS04Scene",
        "at": "2026-09-05T11:11:32"
