      "audio_file": "mp3/beat-S07.mp3"
    },
    {
      "beat_id": "S08",
      "act": "5 practical takeaway",
      "narration_text": "After any agent task, open at least two of the cited sources and check the claims made about them yourself. If the agent skipped a file, that file is exactly where a contradiction is most likely hiding. A self-check that passes is not proof the work is right.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 16,
