    {
      "beat_id": "S03",
      "act": "the question",
      "narration_text": "So why did a self-check pass on work that had fabricated two data points?",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 6,
      "shot": {
        "type": "GRAPHIC",
        "source": "own",
        "motion": "fade",
