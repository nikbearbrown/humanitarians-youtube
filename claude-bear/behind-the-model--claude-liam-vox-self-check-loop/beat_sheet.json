        "new_visual_element": "Question framing card (humanitarians palette)",
        "manim": {
          "scene_class": "HSCS03Scene",
          "scenes_file": "scenes.py"
        }
      },
      "build": {
        "status": "MANIM",
        "src": "manim/S03.mp4",
        "filled_by": "manim:HSCS03Scene",
        "at": "2026-09-05T11:11:32"
