    {
      "beat_id": "S06",
      "act": "4 anchor",
      "narration_text": "Take Jae's agent. It misread fifteen percent as fifty percent in a source table. Then it ran a consistency check — comparing its summary to its own recalled version of that table. The recall also said fifty percent. The check passed. Jae opened the actual PDF: fifteen percent.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 18,
      "shot": {
        "type": "GRAPHIC",
        "source": "own",
        "motion": "drawon",
