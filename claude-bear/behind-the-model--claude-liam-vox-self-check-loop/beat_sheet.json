    {
      "beat_id": "S07",
      "act": "3 mechanism, the fix",
      "narration_text": "Independent verification means comparing the output to the real source — not to the agent's memory of it. Open the cited document. Find the sentence the agent claims to quote. If the source says something different, this check catches it. The agent's own recall never could.",
      "voice": "am_onyx",
      "engine": "kokoro",
      "estimated_duration_s": 17,
      "shot": {
        "type": "GRAPHIC",
        "source": "own",
        "motion": "compare",
        "media": "manim/S07.mp4",
        "new_visual_element": "Self-recall (crimson) vs the actual source (teal) (humanitarians palette)",
        "manim": {
          "scene_class": "HSCS07Scene",
          "scenes_file": "scenes.py"
        }
      },
      "build": {
        "status": "MANIM",
        "src": "manim/S07.mp4",
